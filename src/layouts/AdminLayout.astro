---
interface Props { title?: string; }
const { title = 'Field Notes CMS' } = Astro.props;
---
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width">
  <meta name="robots" content="noindex,nofollow">
  <title>{title}</title>
  <style is:global>
    :root{--bg:#f7f7f7;--panel:#fff;--ink:#151515;--muted:#777;--line:#e5e5e5}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:Inter,Arial,"Noto Sans TC",sans-serif}
    button,input{font:inherit}.cms{min-height:100vh;display:grid;grid-template-columns:240px 1fr}.side{position:fixed;inset:0 auto 0 0;width:240px;background:#151515;color:#aaa;padding:30px 22px;display:flex;flex-direction:column}.cms-brand{color:#fff;font-weight:700;font-size:15px;letter-spacing:.02em;margin-bottom:32px}.side a{color:inherit;text-decoration:none;padding:9px 10px;border-radius:4px;font-size:14px}.side a:hover,.side a.active{color:#fff;background:#252525}.side .view{margin-bottom:22px}.side nav{display:grid;gap:2px}.side-foot{margin-top:auto}.main{grid-column:2;padding:54px 6vw}.top{display:flex;align-items:center;justify-content:space-between;margin-bottom:42px}.top h1{font-size:30px;margin:0;font-weight:650}.btn{border:0;border-radius:4px;background:#151515;color:#fff;padding:10px 15px;cursor:pointer}.btn.secondary{background:#fff;color:#222;border:1px solid var(--line)}.muted{color:var(--muted)}
    @media(max-width:760px){.cms{display:block}.side{position:static;width:auto;min-height:auto}.side nav{grid-template-columns:repeat(3,1fr)}.side-foot{margin-top:20px}.main{padding:32px 20px}}
  </style>
</head>
<body><slot /></body>
</html>
