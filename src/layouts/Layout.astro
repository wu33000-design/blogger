---
interface Props { title?: string; description?: string; image?: string | null; type?: string; locale?: 'zh'|'en'; switchHref?: string; footerText?: string; }
const {title='Field Notes',description='Notes on technology, design, and research.',image=null,type='website',locale='zh',switchHref=locale==='zh'?'/en/':'/',footerText}=Astro.props;
const siteUrl=import.meta.env.SITE_URL || Astro.url.origin; const canonical=new URL(Astro.url.pathname,siteUrl).toString(); const ogImage=image ? new URL(image,siteUrl).toString() : undefined;
const ui=locale==='zh'?{index:'文章',topics:'主題',about:'關於',switch:'EN'}:{index:'Index',topics:'Topics',about:'About',switch:'中文'};
---
<!doctype html><html lang={locale==='zh'?'zh-Hant':'en'}><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="generator" content={Astro.generator}><title>{title}</title><meta name="description" content={description}><link rel="canonical" href={canonical}><link rel="alternate" type="application/rss+xml" title="Field Notes RSS" href="/rss.xml"><meta property="og:type" content={type}><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:url" content={canonical}>{ogImage&&<meta property="og:image" content={ogImage}/>}<meta name="twitter:card" content={ogImage?'summary_large_image':'summary'}><meta name="twitter:title" content={title}><meta name="twitter:description" content={description}>
<style is:global>
:root{--paper:#fff;--ink:#111;--soft:#707070;--line:#d9d9d9;--max:1500px}*{box-sizing:border-box}html{background:var(--paper);color:var(--ink);font-family:Arial,"Noto Sans TC",sans-serif}body{margin:0}a{color:inherit}.shell{width:min(calc(100% - 48px),var(--max));margin:auto}.nav{height:52px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);font:10px/1.2 monospace;letter-spacing:.08em;text-transform:uppercase}.brand{text-decoration:none;font-weight:700}.nav nav{display:flex;gap:22px;align-items:center}.nav nav a{text-decoration:none}.lang{border-left:1px solid var(--line);padding-left:22px;font-weight:700}.site-foot{margin-top:64px}.foot{border-top:1px solid var(--line);padding:12px 0 18px;display:flex;justify-content:space-between;font:10px monospace;color:var(--soft);text-transform:uppercase}.prose{font:17px/1.78 Georgia,"Noto Serif TC",serif}.prose p{margin:0 0 1.35em}.prose h2{font:500 25px/1.3 Arial,sans-serif;margin:2.2em 0 .75em}.prose blockquote{margin:2em 0;padding-left:18px;border-left:1px solid;font-size:21px;line-height:1.5}.prose figure{margin:2em auto;max-width:100%}.prose img{display:block;width:auto;max-width:100%;max-height:70vh;height:auto;margin:0 auto;object-fit:contain}.prose figcaption{margin-top:7px;text-align:center;font:10px/1.5 Arial,"Noto Sans TC",sans-serif;color:var(--soft)}.prose pre{max-width:100%;overflow:auto;background:#f7f7f7;padding:14px;font:13px/1.6 monospace}.skip{position:absolute;left:-9999px}.skip:focus{left:12px;top:12px;background:#fff;padding:10px;z-index:99}@media(max-width:700px){.shell{width:calc(100% - 24px)}.nav{height:46px}.nav nav{gap:12px}.lang{padding-left:12px}.site-foot{margin-top:44px}.foot{display:block}.foot span{display:block;margin-bottom:5px}.prose{font-size:16.5px;line-height:1.72}}
</style></head><body><a class="skip" href="#content">{locale==='zh'?'跳至內容':'Skip to content'}</a>
<header><div class="shell nav"><a class="brand" href={locale==='zh'?'/':'/en/'}>FIELD NOTES</a><nav aria-label="Primary"><a href={locale==='zh'?'/#index':'/en/#index'}>{ui.index}</a><a href={locale==='zh'?'/topics':'/en/topics'}>{ui.topics}</a><a href={locale==='zh'?'/#about':'/en/#about'}>{ui.about}</a><a class="lang" href={switchHref} hreflang={locale==='zh'?'en':'zh-Hant'}>{ui.switch}</a></nav></div></header><slot/>
<footer class="site-foot"><div class="shell foot"><span>{footerText || (locale==='zh'?'獨立數位刊物':'Independent digital publication')}</span><span><a href="/rss.xml">RSS</a> · Taiwan · 2026</span></div></footer></body></html>