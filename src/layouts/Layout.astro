---
interface Props { title?: string; description?: string; }
const { title='Field Notes', description='Notes on technology, design, and research.' }=Astro.props;
const siteUrl=import.meta.env.SITE_URL;
const canonical=siteUrl?new URL(Astro.url.pathname,siteUrl).toString():undefined;
---
<!doctype html><html lang="zh-Hant"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="generator" content={Astro.generator}><title>{title}</title><meta name="description" content={description}>{canonical&&<link rel="canonical" href={canonical}/>}
<style is:global>
:root{--bg:#efefea;--ink:#10100f;--acid:#d8ff38;--line:#1b1b19;--muted:#6d6d67}
*{box-sizing:border-box}html{background:var(--bg);color:var(--ink);font-family:Arial,"Noto Sans TC",sans-serif;scroll-behavior:smooth}body{margin:0;overflow-x:hidden}a{color:inherit}.shell{width:calc(100% - 36px);margin:auto}.site-head{position:relative;z-index:10}.nav{height:70px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid var(--line);font-size:13px}.brand{font-weight:800;text-decoration:none;text-transform:uppercase}.nav-center{font-size:11px;text-transform:uppercase;letter-spacing:.12em}.nav-links{justify-self:end;display:flex;gap:22px}.nav-links a{text-decoration:none}.asterisk{display:inline-block;transition:transform .5s ease}.brand:hover .asterisk{transform:rotate(180deg)}.site-foot{padding:20px 0 28px}.foot{border-top:1px solid;padding-top:16px;display:flex;justify-content:space-between;font:11px monospace;text-transform:uppercase}.prose{font:20px/1.75 Georgia,"Noto Serif TC",serif}.prose h2{font:700 34px/1.08 Arial,sans-serif;margin:2.2em 0 .6em}.prose blockquote{font-size:29px;line-height:1.25;margin:1.7em -8vw;padding:0;border:0}.prose a{text-decoration-thickness:1px;text-underline-offset:3px}@media(max-width:720px){.shell{width:calc(100% - 24px)}.nav{grid-template-columns:1fr auto}.nav-center{display:none}.nav-links a:not(:last-child){display:none}.prose blockquote{margin:1.5em 0}}
</style></head><body>
<header class="site-head"><div class="shell nav"><a class="brand" href="/">FIELD <span class="asterisk">※</span> NOTES</a><span class="nav-center">Independent digital publication</span><nav class="nav-links"><a href="/#notes">Notes</a><a href="/#about">About</a><a href="/#notes">Index ↘</a></nav></div></header>
<slot/>
<footer class="site-foot"><div class="shell foot"><span>Field ※ Notes</span><span>Technology / Design / Research</span><span>©2026</span></div></footer>
</body></html>