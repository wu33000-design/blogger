---
interface Props { title?: string; description?: string; }
const {title='Field Notes',description='Notes on technology, design, and research.'}=Astro.props;
const siteUrl=import.meta.env.SITE_URL; const canonical=siteUrl?new URL(Astro.url.pathname,siteUrl).toString():undefined;
---
<!doctype html><html lang="zh-Hant"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="generator" content={Astro.generator}><title>{title}</title><meta name="description" content={description}>{canonical&&<link rel="canonical" href={canonical}/>}
<style is:global>
:root{--paper:#fff;--ink:#111;--soft:#777;--line:#dedede;--max:1440px}*{box-sizing:border-box}html{background:var(--paper);color:var(--ink);font-family:Arial,"Noto Sans TC",sans-serif}body{margin:0}a{color:inherit}.shell{width:min(calc(100% - 64px),var(--max));margin:auto}.nav{height:76px;display:flex;align-items:center;justify-content:space-between;font:10px/1.2 monospace;letter-spacing:.08em;text-transform:uppercase}.brand{text-decoration:none;font-weight:700}.nav nav{display:flex;gap:28px}.nav nav a{text-decoration:none}.site-foot{margin-top:140px}.foot{border-top:1px solid var(--line);padding:18px 0 34px;display:flex;justify-content:space-between;font:10px monospace;color:var(--soft);text-transform:uppercase}.prose{font:18px/1.9 Georgia,"Noto Serif TC",serif}.prose h2{font:500 27px/1.3 Arial,sans-serif;margin:3em 0 1em}.prose blockquote{margin:3em 0;padding-left:22px;border-left:1px solid;font-size:23px;line-height:1.55}@media(max-width:700px){.shell{width:calc(100% - 30px)}.nav nav{gap:14px}.nav nav a:first-child{display:none}.foot{display:block}.foot span{display:block;margin-bottom:6px}}
</style></head><body>
<header><div class="shell nav"><a class="brand" href="/">FIELD NOTES</a><nav><a href="/#index">Index</a><a href="/#about">About</a></nav></div></header>
<slot/>
<footer class="site-foot"><div class="shell foot"><span>Independent digital publication</span><span>Taiwan · 2026</span></div></footer>
</body></html>