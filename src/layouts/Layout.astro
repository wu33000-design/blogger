---
interface Props { title?: string; description?: string; image?: string | null; type?: string; }
const {title='Field Notes',description='Notes on technology, design, and research.',image=null,type='website'}=Astro.props;
const siteUrl=import.meta.env.SITE_URL || Astro.url.origin;
const canonical=new URL(Astro.url.pathname,siteUrl).toString();
const ogImage=image ? new URL(image,siteUrl).toString() : undefined;
---
<!doctype html><html lang="zh-Hant"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="generator" content={Astro.generator}><title>{title}</title><meta name="description" content={description}><link rel="canonical" href={canonical}><link rel="alternate" type="application/rss+xml" title="Field Notes RSS" href="/rss.xml"><meta property="og:type" content={type}><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:url" content={canonical}>{ogImage&&<meta property="og:image" content={ogImage}/>}<meta name="twitter:card" content={ogImage?'summary_large_image':'summary'}><meta name="twitter:title" content={title}><meta name="twitter:description" content={description}>
<style is:global>
:root{--paper:#fff;--ink:#111;--soft:#777;--line:#dedede;--max:1440px}*{box-sizing:border-box}html{background:var(--paper);color:var(--ink);font-family:Arial,"Noto Sans TC",sans-serif}body{margin:0}a{color:inherit}.shell{width:min(calc(100% - 64px),var(--max));margin:auto}.nav{height:76px;display:flex;align-items:center;justify-content:space-between;font:10px/1.2 monospace;letter-spacing:.08em;text-transform:uppercase}.brand{text-decoration:none;font-weight:700}.nav nav{display:flex;gap:28px}.nav nav a{text-decoration:none}.site-foot{margin-top:140px}.foot{border-top:1px solid var(--line);padding:18px 0 34px;display:flex;justify-content:space-between;font:10px monospace;color:var(--soft);text-transform:uppercase}.prose{font:18px/1.9 Georgia,"Noto Serif TC",serif}.prose h2{font:500 27px/1.3 Arial,sans-serif;margin:3em 0 1em}.prose blockquote{margin:3em 0;padding-left:22px;border-left:1px solid;font-size:23px;line-height:1.55}.prose figure{margin:2.6em auto;max-width:100%}.prose img{display:block;width:auto;max-width:100%;max-height:70vh;height:auto;margin:0 auto;object-fit:contain}.prose figcaption{margin-top:9px;text-align:center;font:11px/1.5 Arial,"Noto Sans TC",sans-serif;color:var(--soft)}.prose pre{max-width:100%;overflow:auto;background:#f7f7f7;padding:16px;font:14px/1.6 monospace}.skip{position:absolute;left:-9999px}.skip:focus{left:12px;top:12px;background:#fff;padding:10px;z-index:99}@media(max-width:700px){.shell{width:calc(100% - 30px)}.nav nav{gap:14px}.foot{display:block}.foot span{display:block;margin-bottom:6px}}
</style></head><body><a class="skip" href="#content">Skip to content</a>
<header><div class="shell nav"><a class="brand" href="/">FIELD NOTES</a><nav aria-label="Primary"><a href="/#index">Index</a><a href="/topics">Topics</a><a href="/#about">About</a></nav></div></header>
<slot/>
<footer class="site-foot"><div class="shell foot"><span>Independent digital publication</span><span><a href="/rss.xml">RSS</a> · Taiwan · 2026</span></div></footer>
</body></html>