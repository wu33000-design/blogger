---
import Layout from '../../../layouts/Layout.astro'; import {getEnglishPosts} from '../../../lib/posts.js';
export async function getStaticPaths(){const posts=await getEnglishPosts();return posts.map((post,index)=>({params:{slug:post.slug},props:{post,previous:posts[index+1]||null,next:posts[index-1]||null}}))}
const {post,previous,next}=Astro.props; const fmt=d=>new Intl.DateTimeFormat('en',{year:'numeric',month:'long',day:'numeric'}).format(new Date(d)); const author=post.primary_author?.name||'Field Notes';
---
<Layout title={`${post.title} — Field Notes`} description={post.excerpt||post.title} image={post.feature_image} type="article" locale="en" switchHref={`/post/${post.slug}`}>
<main id="content" class="shell article"><a class="back" href="/en/">← Index</a><header><div class="meta"><span>{post.primary_tag?.name||'Field note'}</span><time>{fmt(post.published_at)}</time></div><h1>{post.title}</h1><p class="lead">{post.excerpt}</p><div class="details"><span>{author}</span><span>{post.reading_time} min read</span></div></header>{post.feature_image&&<figure class="feature"><img src={post.feature_image} alt={post.feature_image_alt||""}/></figure>}<section class="prose body" set:html={post.html}/>{post.tags?.length>0&&<div class="tags">{post.tags.map(tag=><a href={`/en/topics/${tag.slug}`}>{tag.name}</a>)}</div>}<nav class="related">{previous?<a href={`/en/post/${previous.slug}`}><small>Previous</small><span>{previous.title}</span></a>:<span/>}{next?<a class="next" href={`/en/post/${next.slug}`}><small>Next</small><span>{next.title}</span></a>:null}</nav></main>
<style>.article{padding-top:18px}.back{font:10px monospace;text-decoration:none;color:var(--soft)}.article header{padding:38px 0 34px}.meta{display:flex;justify-content:space-between;max-width:820px;font:10px monospace;text-transform:uppercase;color:var(--soft);border-bottom:1px solid var(--line);padding-bottom:7px}.article h1{font:400 clamp(38px,5.4vw,76px)/1.04 Georgia,serif;max-width:1050px;margin:22px 0 16px}.lead{font:17px/1.55 Georgia,serif;color:#555;max-width:650px}.details{display:flex;gap:20px;margin-top:18px;font:10px monospace;color:var(--soft);text-transform:uppercase}.feature{margin:0 auto;max-width:1200px}.feature img{width:100%;max-height:68vh;object-fit:cover}.body{max-width:680px;margin:58px auto 48px}.tags{max-width:680px;margin:0 auto 38px;display:flex;gap:6px}.tags a{font:10px monospace;text-decoration:none;border:1px solid var(--line);padding:5px 7px}.related{border-top:1px solid;display:grid;grid-template-columns:1fr 1fr;gap:30px;padding-top:14px}.related a{display:grid;gap:6px;text-decoration:none}.related small{font:10px monospace;color:var(--soft);text-transform:uppercase}.related span{font:18px Georgia,serif}.next{text-align:right}</style></Layout>