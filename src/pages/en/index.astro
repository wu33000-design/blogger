---
import Layout from '../../layouts/Layout.astro'; import {getEnglishPosts} from '../../lib/posts.js'; import {getSiteContent} from '../../lib/site-content.js';
const posts=await getEnglishPosts(); const site=await getSiteContent('en');
const featuredPosts=posts.filter(p=>p.featured); const featured=featuredPosts.length?featuredPosts:(posts[0]?[posts[0]]:[]); const initialFeatured=featured.slice(0,3); const extraFeatured=featured.slice(3);
const tagMap=new Map(); for(const post of posts) for(const tag of post.tags||[]) if(tag?.slug&&!tagMap.has(tag.slug)) tagMap.set(tag.slug,tag); const filterTags=[...tagMap.values()].sort((a,b)=>a.name.localeCompare(b.name,'en'));
const fmt=d=>new Intl.DateTimeFormat('en',{year:'numeric',month:'short',day:'numeric'}).format(new Date(d));
---
<Layout title="{{site}} — English" locale="en" switchHref="/" footerText={site['site.footer']}>
<main id="content" class="shell">
<section class="intro"><div><p>{site['home.eyebrow']}</p><h1>{site['home.headline']}</h1></div><p class="dek">{site['home.subjects']}<br/>{site['home.intro']}</p></section>
{featured.length>0?<section class="featured">
  <div class="feature-meta"><span>Featured notes</span><span>{String(featured.length).padStart(2,'0')} notes</span></div>
  <div class="featured-grid">
    {initialFeatured.map(post=><a class="feature-card" href={`/en/post/${post.slug}`}>
      {post.feature_image&&<img src={post.feature_image} alt={post.feature_image_alt||""}/>}
      <div class="feature-copy"><small>{[post.primary_tag?.name, `${post.reading_time} min`].filter(Boolean).join(' · ')}</small><h2>{post.title}</h2><p>{post.excerpt}</p><span class="read">Read note →</span></div>
    </a>)}
  </div>
  {extraFeatured.length>0&&<div class="featured-more">
    <button id="featured-toggle" class="featured-toggle" type="button" aria-expanded="false" aria-controls="featured-extra"><span class="featured-toggle-label">Show all featured notes</span><span>+{extraFeatured.length}</span></button>
    <div id="featured-extra" class="featured-grid extra" style="display:none">
      {extraFeatured.map(post=><a class="feature-card" href={`/en/post/${post.slug}`}>
        {post.feature_image&&<img src={post.feature_image} alt={post.feature_image_alt||""}/>}
        <div class="feature-copy"><small>{[post.primary_tag?.name, `${post.reading_time} min`].filter(Boolean).join(' · ')}</small><h2>{post.title}</h2><p>{post.excerpt}</p><span class="read">Read note →</span></div>
      </a>)}
    </div>
  </div>}
</section>:<p class="empty">No English translations have been published yet.</p>}
<section id="index" class="index">
  <header><span>Index</span><span id="post-count">{String(posts.length).padStart(2,'0')} notes</span></header>
  {filterTags.length>0&&<div class="tag-filters" role="group" aria-label="Filter articles by tag"><button type="button" class="tag-filter on" data-tag="" aria-pressed="true">All</button>{filterTags.map(tag=><button type="button" class="tag-filter" data-tag={tag.slug} aria-pressed="false">{tag.name}</button>)}</div>}
  <div id="post-list">{posts.map((post,i)=><a class="row" data-post-row data-tags={(post.tags||[]).map(t=>t.slug).join(' ')} href={`/en/post/${post.slug}`}><span>{String(i+1).padStart(2,'0')}</span><div><small>{[post.primary_tag?.name, `${post.reading_time} min`].filter(Boolean).join(' · ')}</small><h2>{post.title}</h2></div><time datetime={post.published_at}>{fmt(post.published_at)}</time></a>)}</div>
  <p id="no-posts" class="no-posts" hidden>No articles match this tag.</p>
</section>
<section id="about" class="about"><span>About</span><p>{site['home.about']}</p></section>
</main>
<script is:inline>
(()=>{const toggle=document.getElementById('featured-toggle'),extra=document.getElementById('featured-extra'),label=toggle?.querySelector('.featured-toggle-label');toggle?.addEventListener('click',()=>{const next=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(next));if(extra)extra.style.display=next?'grid':'none';if(label)label.textContent=next?'Collapse featured notes':'Show all featured notes';});const buttons=[...document.querySelectorAll('.tag-filter')],rows=[...document.querySelectorAll('[data-post-row]')],count=document.getElementById('post-count'),empty=document.getElementById('no-posts');if(!buttons.length)return;const apply=tag=>{let visible=0;rows.forEach(row=>{const tags=(row.dataset.tags||'').split(/\s+/).filter(Boolean),show=!tag||tags.includes(tag);row.hidden=!show;if(show)visible++;});buttons.forEach(button=>{const active=button.dataset.tag===tag;button.classList.toggle('on',active);button.setAttribute('aria-pressed',String(active));});if(count)count.textContent=String(visible).padStart(2,'0')+' notes';if(empty)empty.hidden=visible!==0;};buttons.forEach(button=>button.addEventListener('click',()=>apply(button.dataset.tag||'')));})();
</script>
<style>
.intro{padding:46px 0 38px;display:grid;grid-template-columns:2fr 1fr;gap:40px;align-items:end;border-bottom:1px solid}.intro p,.feature-meta,.index header,.about>span{font:10px monospace;text-transform:uppercase;color:var(--soft)}.intro h1{font:400 clamp(30px,3.8vw,58px)/1.12 Georgia,serif;max-width:850px;margin:10px 0 0}.dek{text-align:right}.featured{padding:28px 0 38px}.feature-meta{display:flex;justify-content:space-between;margin-bottom:12px}.featured-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line);border-left:1px solid var(--line)}.feature-card{min-width:0;text-decoration:none;border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:16px;display:flex;flex-direction:column;gap:14px}.feature-card img{width:100%;height:180px;object-fit:cover}.feature-copy small{font:10px monospace;color:var(--soft);text-transform:uppercase}.feature-card h2{font:400 clamp(23px,2.7vw,39px)/1.08 Georgia,serif;margin:8px 0 10px}.feature-card p{font:15px/1.5 Georgia,serif;color:#555;margin:0}.read{display:inline-block;margin-top:14px;font:10px monospace;text-transform:uppercase;border-bottom:1px solid}.featured-more{margin-top:12px}.featured-toggle{appearance:none;width:max-content;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--soft);padding:4px 0;cursor:pointer;font:10px monospace;text-transform:uppercase}.featured-toggle:hover,.featured-toggle[aria-expanded="true"]{color:var(--ink)}.featured-toggle span{margin-left:6px}.featured-extra{margin-top:12px}.index{padding-top:22px}.index header{display:flex;justify-content:space-between;border-bottom:1px solid;padding-bottom:7px}.tag-filters{display:flex;flex-wrap:wrap;gap:6px;padding:12px 0;border-bottom:1px solid var(--line)}.tag-filter{appearance:none;border:1px solid transparent;background:transparent;color:var(--soft);padding:5px 8px;font:10px monospace;cursor:pointer}.tag-filter:hover,.tag-filter.on{border-color:var(--line);color:var(--ink);background:#fafafa}.row{min-height:78px;display:grid;grid-template-columns:42px 1fr 92px;align-items:center;gap:14px;border-bottom:1px solid var(--line);text-decoration:none}.row[hidden]{display:none}.row>span,.row time,.row small{font:10px monospace;color:var(--soft);text-transform:uppercase}.row time{text-align:right}.row h2{font:400 clamp(19px,2vw,29px)/1.18 Georgia,serif;margin:4px 0}.no-posts{margin:0;padding:28px 0;border-bottom:1px solid var(--line);font:12px/1.5 Georgia,serif;color:var(--soft)}.about{padding:48px 0;display:grid;grid-template-columns:1fr 3fr;border-bottom:1px solid var(--line)}.about p{font:30px/1.3 Georgia,serif;margin:0;max-width:900px}.empty{padding:32px 0;border-bottom:1px solid var(--line);color:var(--soft)}@media(max-width:900px){.featured-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.intro,.about{grid-template-columns:1fr;gap:18px}.dek{text-align:left}.featured-grid{grid-template-columns:1fr}.row{grid-template-columns:26px 1fr}.row time{display:none}}
</style></Layout>