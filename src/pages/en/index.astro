---
import Layout from '../../layouts/Layout.astro'; import {getEnglishPosts,getTags} from '../../lib/posts.js'; import {getSiteContent} from '../../lib/site-content.js';
const posts=await getEnglishPosts(); const tags=await getTags('en'); const site=await getSiteContent('en'); const featured=posts.find(p=>p.featured)||posts[0]; const fmt=d=>new Intl.DateTimeFormat('en',{year:'numeric',month:'short',day:'numeric'}).format(new Date(d));
---
<Layout title="Field Notes — English" locale="en" switchHref="/" footerText={site['site.footer']}>
<main id="content" class="shell"><section class="intro"><div><p>{site['home.eyebrow']}</p><h1>{site['home.headline']}</h1></div><p class="dek">{site['home.subjects']}<br/>{site['home.intro']}</p></section>
{featured?<section class="featured"><div class="feature-meta"><span>Featured note</span><span>{featured.reading_time} min</span></div><a href={`/en/post/${featured.slug}`}><h2>{featured.title}</h2><p>{featured.excerpt}</p><span class="read">Read note →</span></a></section>:<p class="empty">No English translations have been published yet.</p>}
<section id="index" class="index"><header><span>Index</span><span>{String(posts.length).padStart(2,'0')} notes</span></header>{posts.map((post,i)=><a class="row" href={`/en/post/${post.slug}`}><span>{String(i+1).padStart(2,'0')}</span><div><small>{post.primary_tag?.name||'Field note'} · {post.reading_time} min</small><h2>{post.title}</h2></div><time>{fmt(post.published_at)}</time></a>)}</section>
<section class="topic-strip"><span>Topics</span><div>{tags.map(tag=><a href={`/en/topics/${tag.slug}`}>{tag.name} <sup>{tag.count}</sup></a>)}</div></section><section id="about" class="about"><span>About</span><p>{site['home.about']}</p></section></main>
<style>.intro{padding:46px 0 38px;display:grid;grid-template-columns:2fr 1fr;gap:40px;align-items:end;border-bottom:1px solid}.intro p,.feature-meta,.index header,.topic-strip>span,.about>span{font:10px monospace;text-transform:uppercase;color:var(--soft)}.intro h1{font:400 clamp(30px,3.8vw,58px)/1.12 Georgia,serif;max-width:850px;margin:10px 0 0}.dek{text-align:right}.featured{padding:28px 0 38px}.feature-meta,.index header{display:flex;justify-content:space-between}.featured>a{display:block;text-decoration:none;border-block:1px solid var(--line);padding:18px 0}.featured h2{font:400 clamp(30px,4vw,58px)/1.08 Georgia,serif;margin:0 0 12px}.featured p{max-width:650px;color:#555}.read{font:10px monospace;text-transform:uppercase}.index{padding-top:22px}.index header{border-bottom:1px solid;padding-bottom:7px}.row{min-height:78px;display:grid;grid-template-columns:42px 1fr 92px;align-items:center;gap:14px;border-bottom:1px solid var(--line);text-decoration:none}.row>span,.row time,.row small{font:10px monospace;color:var(--soft);text-transform:uppercase}.row time{text-align:right}.row h2{font:400 clamp(19px,2vw,29px)/1.18 Georgia,serif;margin:4px 0}.topic-strip,.about{padding:48px 0;display:grid;grid-template-columns:1fr 3fr;border-bottom:1px solid var(--line)}.topic-strip div{display:flex;flex-wrap:wrap;gap:8px 22px}.topic-strip a{font:24px Georgia,serif;text-decoration:none}.about p{font:30px/1.3 Georgia,serif;margin:0;max-width:900px}.empty{padding:32px 0;border-bottom:1px solid var(--line);color:var(--soft)}@media(max-width:700px){.intro,.topic-strip,.about{grid-template-columns:1fr;gap:18px}.dek{text-align:left}.row{grid-template-columns:26px 1fr}.row time{display:none}}</style></Layout>