---
import Layout from '../../../layouts/Layout.astro'; import {getTags,getPostsByTag} from '../../../lib/posts.js';
export async function getStaticPaths(){const tags=await getTags('en');return Promise.all(tags.map(async tag=>({params:{slug:tag.slug},props:{tag,posts:await getPostsByTag(tag.slug,'en')}})))}
const {tag,posts}=Astro.props;
---
<Layout title={`${tag.name} — Field Notes`} locale="en" switchHref={`/topics/${tag.slug}`}><main id="content" class="shell topic"><a class="back" href="/en/topics">← Topics</a><header><span>Topic / {String(posts.length).padStart(2,'0')}</span><h1>{tag.name}</h1>{tag.description&&<p>{tag.description}</p>}</header><div class="list">{posts.map((post,i)=><a href={`/en/post/${post.slug}`}><span>{String(i+1).padStart(2,'0')}</span><h2>{post.title}</h2></a>)}</div></main><style>.topic{padding-top:18px}.back,.topic header span,.list span{font:10px monospace;color:var(--soft);text-transform:uppercase}.back{text-decoration:none}.topic header{padding:38px 0 30px}.topic h1{font:400 clamp(42px,6vw,88px)/1 Georgia,serif;margin:10px 0}.topic header p{max-width:620px;color:#555}.list{border-top:1px solid}.list a{min-height:76px;display:grid;grid-template-columns:42px 1fr;align-items:center;gap:14px;border-bottom:1px solid var(--line);text-decoration:none}.list h2{font:400 clamp(19px,2vw,29px)/1.2 Georgia,serif;margin:0}</style></Layout>