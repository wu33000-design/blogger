---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="標籤 — Field Notes CMS">
<div class="cms" id="cms" hidden><aside class="side"><div class="cms-brand">FIELD NOTES</div><a class="view" href="/" target="_blank">查看網站 ↗</a><nav><a href="/admin">文章</a><a href="/admin/tags" class="active">標籤</a><a href="/admin/content">網站內容</a></nav><div class="side-foot"><button id="sign-out" class="btn secondary">登出</button></div></aside><main class="main"><header class="top"><div><h1>標籤</h1><p class="muted">管理公開網站的主題與標籤。</p></div></header><form id="tag-form" class="tag-form"><input id="name" required placeholder="標籤名稱"><input id="slug" required placeholder="網址代稱"><input id="description" placeholder="中文說明"><input id="name-en" placeholder="英文名稱（選填）"><input id="description-en" placeholder="英文說明（選填）"><button class="btn">新增標籤</button></form><p id="message" class="muted"></p><div id="tags" class="tags"></div></main></div>
<script>
 import { supabaseConfigured,getSupabaseClient } from '../../lib/supabase-client.js';
 const cms=document.querySelector('#cms'),list=document.querySelector('#tags'),form=document.querySelector('#tag-form'),message=document.querySelector('#message');let supabase,role;
 if(!supabaseConfigured)location.href='/admin/login'; else{
  supabase=getSupabaseClient();const {data:{session}}=await supabase.auth.getSession();
  if(!session)location.href='/admin/login'; else{
   const {data:profile}=await supabase.from('profiles').select('role').eq('id',session.user.id).single();role=profile?.role;
   if(!['admin','editor'].includes(role)){await supabase.auth.signOut();location.href='/admin/login';}else{cms.hidden=false;await load();}
  }
 }
 async function load(){const {data,error}=await supabase.from('tags').select('id,name,slug,description,name_en,description_en').order('name');if(error){message.textContent=error.message;return;}list.innerHTML=(data||[]).length?(data||[]).map(t=>`<div class="tag" data-id="${t.id}"><div><strong>${esc(t.name)}</strong><code>/topics/${esc(t.slug)}</code><p>${esc(t.description||'')}</p>${t.name_en?`<p><strong>EN:</strong> ${esc(t.name_en)}${t.description_en?` — ${esc(t.description_en)}`:''}</p>`:''}</div><div class="tag-actions"><button class="edit">編輯</button>${role==='admin'?'<button class="delete">刪除</button>':''}</div></div>`).join(''):'<p class="muted">目前沒有標籤。</p>';}
 form?.addEventListener('submit',async e=>{e.preventDefault();message.textContent='儲存中…';const name=document.querySelector('#name').value.trim(),slug=slugify(document.querySelector('#slug').value||name),description=document.querySelector('#description').value.trim(),name_en=document.querySelector('#name-en').value.trim()||null,description_en=document.querySelector('#description-en').value.trim()||null;const {error}=await supabase.from('tags').insert({name,slug,description,name_en,description_en});if(error){message.textContent=error.message;return;}form.reset();message.textContent='已儲存';await load();});
 document.querySelector('#name')?.addEventListener('input',e=>{const s=document.querySelector('#slug');if(!s.dataset.edited)s.value=slugify(e.target.value);});document.querySelector('#slug')?.addEventListener('input',e=>e.target.dataset.edited='1');
 list?.addEventListener('click',async e=>{const row=e.target.closest('.tag');if(!row)return;if(e.target.closest('.edit')){const current=(await supabase.from('tags').select('name,slug,description,name_en,description_en').eq('id',row.dataset.id).single()).data;if(!current)return;const name=prompt('標籤名稱',current.name);if(name===null)return;const slug=prompt('Tag slug',current.slug);if(slug===null)return;const description=prompt('中文說明',current.description||'');if(description===null)return;const nameEn=prompt('英文名稱（選填）',current.name_en||'');if(nameEn===null)return;const descriptionEn=prompt('英文說明（選填）',current.description_en||'');if(descriptionEn===null)return;message.textContent='儲存中…';const {error}=await supabase.from('tags').update({name:name.trim(),slug:slugify(slug||name),description:description.trim(),name_en:nameEn.trim()||null,description_en:descriptionEn.trim()||null,updated_at:new Date().toISOString()}).eq('id',row.dataset.id);message.textContent=error?.message||'已儲存';if(!error)await load();return;}const b=e.target.closest('.delete');if(!b)return;if(!confirm('確定刪除這個標籤？'))return;const {error}=await supabase.from('tags').delete().eq('id',row.dataset.id);message.textContent=error?.message||'已刪除';if(!error)await load();});
 document.querySelector('#sign-out')?.addEventListener('click',async()=>{await supabase.auth.signOut();location.href='/admin/login';});
 function slugify(v){return String(v).toLowerCase().trim().normalize('NFKD').replace(/[^\p{Letter}\p{Number}]+/gu,'-').replace(/^-|-$/g,'');}
 function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));}
</script>
<style>.tag-form{display:grid;grid-template-columns:1fr 1fr 2fr 1fr 2fr auto;gap:10px;padding-bottom:28px;border-bottom:1px solid var(--line)}.tag-form input{border:1px solid var(--line);background:#fff;padding:10px}.tags{background:#fff}.tag{display:flex;justify-content:space-between;gap:20px;padding:20px 18px;border-bottom:1px solid var(--line)}.tag strong{display:block}.tag code{display:block;color:#888;font-size:11px;margin-top:6px}.tag p{color:#777;font-size:13px;margin:8px 0 0}.tag-actions{display:flex;gap:10px;align-items:flex-start}.tag-actions button{border:0;background:none;color:#888;cursor:pointer}.tag-actions .delete{color:#9b2c2c}@media(max-width:900px){.tag-form{grid-template-columns:1fr}}</style>
</AdminLayout>
