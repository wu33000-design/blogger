---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="標籤 — Field Notes CMS"><div class="cms" id="cms" hidden><aside class="side"><div class="cms-brand">FIELD NOTES</div><a class="view" href="/" target="_blank">查看網站 ↗</a><nav><a href="/admin">文章</a><a href="/admin/tags" class="active">標籤</a><a href="/admin/content">網站內容</a></nav><div class="side-foot"><button id="sign-out" class="btn secondary">登出</button></div></aside><main class="main"><header class="top"><div><h1>標籤</h1><p class="muted">管理公開網站的主題與標籤。</p></div></header><form id="tag-form" class="tag-form"><label>標籤名稱<input id="name" required></label><label>網址代稱<input id="slug" readonly tabindex="-1"><small>依標籤名稱自動生成，僅供檢視。</small></label><label>中文說明<input id="description"></label><label>英文名稱（選填）<input id="name-en"></label><label>英文說明（選填）<input id="description-en"></label><button class="btn">新增標籤</button></form><p id="message" class="muted"></p><div id="tags" class="tags"></div></main></div>
<script>
 import {supabaseConfigured,getSupabaseClient} from '../../lib/supabase-client.js';const cms=document.querySelector('#cms'),list=document.querySelector('#tags'),form=document.querySelector('#tag-form'),message=document.querySelector('#message');let supabase,role;
 if(!supabaseConfigured)location.href='/admin/login';else{supabase=getSupabaseClient();const {data:{session}}=await supabase.auth.getSession();if(!session)location.href='/admin/login';else{const {data:profile}=await supabase.from('profiles').select('role').eq('id',session.user.id).single();role=profile?.role;if(!['admin','editor'].includes(role)){await supabase.auth.signOut();location.href='/admin/login';}else{cms.hidden=false;await load();}}}
 async function load(){const {data,error}=await supabase.from('tags').select('id,name,slug,description,name_en,description_en').order('name');if(error){message.textContent=error.message;return;}list.innerHTML=(data||[]).length?(data||[]).map(t=>'<div class="tag" data-id="'+t.id+'"><div class="tag-copy"><strong>'+esc(t.name)+'</strong><code>/topics/'+esc(t.slug)+'</code><p>'+esc(t.description||'')+'</p>'+(t.name_en?'<p><b>EN:</b> '+esc(t.name_en)+(t.description_en?' — '+esc(t.description_en):'')+'</p>':'')+'</div><div class="tag-actions"><button class="edit">編輯</button>'+(role==='admin'?'<button class="delete">刪除</button>':'')+'</div></div>').join(''):'<p class="muted">目前沒有標籤。</p>';}
 form?.addEventListener('submit',async e=>{e.preventDefault();message.textContent='儲存中…';const name=document.querySelector('#name').value.trim(),slug=slugify(name),description=document.querySelector('#description').value.trim(),name_en=document.querySelector('#name-en').value.trim()||null,description_en=document.querySelector('#description-en').value.trim()||null;const {error}=await supabase.from('tags').insert({name,slug,description,name_en,description_en});if(error){message.textContent=error.message;return;}form.reset();document.querySelector('#slug').value='';message.textContent='已儲存';await load();});
 document.querySelector('#name')?.addEventListener('input',e=>document.querySelector('#slug').value=slugify(e.target.value));
 list?.addEventListener('click',async e=>{const row=e.target.closest('.tag');if(!row)return;if(e.target.closest('.edit')){const current=(await supabase.from('tags').select('name,slug,description,name_en,description_en').eq('id',row.dataset.id).single()).data;if(!current)return;const name=prompt('標籤名稱',current.name);if(name===null)return;const description=prompt('中文說明',current.description||'');if(description===null)return;const nameEn=prompt('英文名稱（選填）',current.name_en||'');if(nameEn===null)return;const descriptionEn=prompt('英文說明（選填）',current.description_en||'');if(descriptionEn===null)return;message.textContent='儲存中…';const {error}=await supabase.from('tags').update({name:name.trim(),description:description.trim(),name_en:nameEn.trim()||null,description_en:descriptionEn.trim()||null,updated_at:new Date().toISOString()}).eq('id',row.dataset.id);message.textContent=error?.message||'已儲存';if(!error)await load();return;}if(!e.target.closest('.delete'))return;if(!confirm('確定刪除這個標籤？'))return;const {error}=await supabase.from('tags').delete().eq('id',row.dataset.id);message.textContent=error?.message||'已刪除';if(!error)await load();});
 document.querySelector('#sign-out')?.addEventListener('click',async()=>{await supabase.auth.signOut();location.href='/admin/login';});function slugify(v){return String(v).toLowerCase().trim().normalize('NFKD').replace(/[^\p{Letter}\p{Number}]+/gu,'-').replace(/^-|-$/g,'');}function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));}
</script>
<style>.tag-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 18px;padding:18px;background:#fff;border:1px solid var(--line);margin-bottom:28px;max-width:100%}.tag-form label{min-width:0;display:grid;gap:6px;font-size:12px}.tag-form input{min-width:0;width:100%;border:1px solid var(--line);background:#fff;padding:10px}.tag-form input[readonly]{background:#f5f5f5;color:#777}.tag-form small{color:#888}.tag-form .btn{justify-self:start;align-self:end}.tags{background:#fff;max-width:100%;overflow:hidden}.tag{display:flex;justify-content:space-between;gap:20px;padding:18px;border-bottom:1px solid var(--line);min-width:0}.tag-copy{min-width:0}.tag strong,.tag code,.tag p{overflow-wrap:anywhere}.tag strong{display:block}.tag code{display:block;color:#888;font-size:11px;margin-top:6px}.tag p{color:#777;font-size:13px;margin:8px 0 0}.tag-actions{display:flex;flex:0 0 auto;gap:10px;align-items:flex-start}.tag-actions button{border:0;background:none;color:#888;cursor:pointer}.tag-actions .delete{color:#9b2c2c}@media(max-width:900px){.tag-form{grid-template-columns:1fr}.tag{align-items:flex-start}}</style></AdminLayout>