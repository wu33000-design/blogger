---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Editor — Field Notes CMS">
<div id="editor" class="editor" hidden>
 <header class="bar"><div class="bar-left"><a href="/admin">← 返回文章</a><span class="bar-sep"></span><strong>文章編輯器</strong></div><div class="actions"><span id="save-state">已儲存</span><button id="preview" class="quiet">預覽</button><button id="unpublish" class="quiet" hidden>取消發布</button><button id="delete-post" class="danger">刪除</button><button id="publish" class="publish">發布</button></div></header>
 <main class="canvas">
  <div class="editor-head"><div><span class="eyebrow">撰寫文章</span><p>專注於內容，文章屬性統一由右側設定。</p></div><div class="modebar"><button id="plain-mode">純文字</button><button id="structured-mode" class="active">結構化</button></div></div>
  <input id="title" class="title" placeholder="中文標題" aria-label="中文標題">
  <input id="title-en" class="title title-en" placeholder="英文標題（選填）" aria-label="英文標題">
  <textarea id="plain-body" class="plain-body" rows="18" placeholder="輸入文章內文" hidden></textarea>
  <div id="structured-editor"><div id="blocks" class="blocks"></div>
  <div class="addbar"><button data-add="paragraph">+ 段落</button><button data-add="heading">標題</button><button data-add="quote">引言</button><button data-add="code">程式碼</button><button data-add="divider">分隔線</button><button data-add="image">圖片</button></div></div>
 </main>
 <button id="settings-toggle" class="settings-toggle" aria-label="文章設定">⚙</button>
 <aside id="settings" class="settings">
  <div class="settings-head"><span class="eyebrow">文章設定</span><p>發布資訊與文章屬性</p></div>
  <section class="setting-group"><h3>基本資訊</h3><label>網址代稱<input id="slug"></label><label>摘要<textarea id="excerpt" rows="4"></textarea></label></section><section class="setting-group"><h3>英文資訊 <small>選填</small></h3><label>英文摘要<textarea id="excerpt-en" rows="3"></textarea></label><label>英文主視覺替代文字<input id="feature-image-alt-en"></label></section><section class="setting-group"><h3>分類</h3>
  <fieldset class="tag-field"><legend>標籤</legend><div id="tag-options">載入中…</div></fieldset></section><section class="setting-group"><h3>呈現</h3>
  <label class="check"><input id="featured" type="checkbox"> 設為精選文章</label>
  <label>主視覺圖片<input id="feature-image-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif"></label><div id="feature-image-preview" class="feature-image-preview" hidden><img id="feature-image-img" alt=""><button id="remove-feature-image" type="button">移除主視覺圖片</button></div><label>主視覺替代文字<input id="feature-image-alt" placeholder="描述圖片內容"></label></section>
 </aside>
</div>
<div id="preview-modal" class="modal" hidden><div class="preview-card"><button id="close-preview">關閉</button><article><h1 id="preview-title"></h1><div id="preview-body"></div></article></div></div>
<script>
 import { supabaseConfigured,getSupabaseClient } from '../../lib/supabase-client.js';
 const qs=s=>document.querySelector(s),id=new URLSearchParams(location.search).get('id'),root=qs('#editor'),blocksEl=qs('#blocks');let saveTimer=null,supabase,userRole='',postStatus='draft',originalSlug='',slugTouched=false,blocks=[],editorMode='structured',originalHtmlEn='';
 if(!supabaseConfigured||!id)location.href='/admin/login'; else{
  supabase=getSupabaseClient();const {data:{session}}=await supabase.auth.getSession();
  if(!session)location.href='/admin/login'; else{
   const {data:profile}=await supabase.from('profiles').select('role').eq('id',session.user.id).single();userRole=profile?.role||'';
   if(!['admin','editor'].includes(userRole)){await supabase.auth.signOut();location.href='/admin/login';}else{
    const {data:p,error}=await supabase.from('posts').select('*').eq('id',id).single();
    if(error||!p)location.href='/admin'; else{postStatus=p.status||'draft';originalSlug=p.slug||'';qs('#title').value=p.title||'';qs('#slug').value=originalSlug;qs('#excerpt').value=p.excerpt||'';qs('#title-en').value=p.title_en||'';qs('#excerpt-en').value=p.excerpt_en||'';originalHtmlEn=p.html_en||'';qs('#feature-image-alt-en').value=p.feature_image_alt_en||'';qs('#featured').checked=Boolean(p.featured);qs('#feature-image-alt').value=p.feature_image_alt||'';setFeature圖片(p.feature_image||'');blocks=readBlocks(p);renderBlocks();syncLifecycleButtons();await load標籤();root.hidden=false;}
   }
  }
 }
 ['#title','#title-en','#plain-body','#excerpt','#excerpt-en','#feature-image-alt-en','#featured','#feature-image-alt'].forEach(s=>qs(s)?.addEventListener('input',scheduleSave));
 qs('#title')?.addEventListener('input',()=>{if(postStatus==='draft'&&!slugTouched)qs('#slug').value=slugify(qs('#title').value)||originalSlug;});
 qs('#slug')?.addEventListener('input',()=>{slugTouched=true;scheduleSave();});qs('#tag-options')?.addEventListener('change',scheduleSave);
 qs('#settings-toggle')?.addEventListener('click',()=>qs('#settings').classList.toggle('open'));qs('#plain-mode')?.addEventListener('click',()=>setMode('plain'));qs('#structured-mode')?.addEventListener('click',()=>setMode('structured'));
 qs('#feature-image-file')?.addEventListener('change',async e=>{const file=e.target.files?.[0];if(!file)return;const uploaded=await upload圖片(file,'feature');if(!uploaded)return;setFeature圖片(uploaded);scheduleSave();});
 qs('#remove-feature-image')?.addEventListener('click',()=>{setFeature圖片('');scheduleSave();});
 qs('#publish')?.addEventListener('click',async()=>{const ok=await save('published');if(ok){qs('#publish').textContent='已發布';syncLifecycleButtons();}});
 qs('#unpublish')?.addEventListener('click',async()=>{if(!confirm('確定將這篇文章改回草稿？'))return;clearTimeout(saveTimer);const ok=await save('draft');if(!ok)return;postStatus='draft';qs('#save-state').textContent='已改為草稿';qs('#publish').textContent='發布';syncLifecycleButtons();});
 qs('#delete-post')?.addEventListener('click',async()=>{if(!confirm('確定永久刪除這篇文章？此動作無法復原。'))return;clearTimeout(saveTimer);qs('#save-state').textContent='刪除中…';const {error}=await supabase.from('posts').delete().eq('id',id);if(error){qs('#save-state').textContent=error.message;return;}location.href='/admin';});
 qs('#preview')?.addEventListener('click',()=>{if(editorMode==='plain')blocks=plainToBlocks(qs('#plain-body').value);else syncBlocks();qs('#preview-title').textContent=qs('#title').value||'未命名文章';qs('#preview-body').innerHTML=renderHtml(blocks);qs('#preview-modal').hidden=false;});
 qs('#close-preview')?.addEventListener('click',()=>qs('#preview-modal').hidden=true);
 qs('.addbar')?.addEventListener('click',e=>{const b=e.target.closest('[data-add]');if(!b)return;syncBlocks();blocks.push(b.dataset.add==='image'?{type:'image',url:'',alt:'',caption:''}:{type:b.dataset.add,text:''});renderBlocks();blocksEl.querySelector('.block:last-child textarea')?.focus();scheduleSave();});
 blocksEl?.addEventListener('input',scheduleSave);
 blocksEl?.addEventListener('change',async e=>{const input=e.target.closest('.image-file');if(!input?.files?.[0])return;const row=input.closest('.block'),i=Number(row.dataset.index),uploaded=await upload圖片(input.files[0]);if(!uploaded)return;syncBlocks();blocks[i]={...blocks[i],type:'image',url:uploaded};renderBlocks();scheduleSave();});
 blocksEl?.addEventListener('click',e=>{const row=e.target.closest('.block');if(!row)return;const i=Number(row.dataset.index);syncBlocks();if(e.target.closest('.remove'))blocks.splice(i,1);else if(e.target.closest('.up')&&i>0)[blocks[i-1],blocks[i]]=[blocks[i],blocks[i-1]];else if(e.target.closest('.down')&&i<blocks.length-1)[blocks[i+1],blocks[i]]=[blocks[i],blocks[i+1]];else return;renderBlocks();scheduleSave();});
 async function upload圖片(file,kind='blocks'){const allowed={'image/jpeg':'jpg','image/png':'png','image/webp':'webp','image/gif':'gif','image/avif':'avif'};const ext=allowed[file.type];if(!ext){qs('#save-state').textContent='僅支援 JPEG、PNG、WebP、GIF 或 AVIF 圖片';return null;}if(file.size>10*1024*1024){qs('#save-state').textContent='圖片大小不可超過 10 MB';return null;}qs('#save-state').textContent='圖片上傳中…';const path=`posts/${id}/${kind}-${crypto.randomUUID()}.${ext}`;const {error}=await supabase.storage.from('cms-media').upload(path,file,{contentType:file.type,upsert:false});if(error){qs('#save-state').textContent=error.message;return null;}return supabase.storage.from('cms-media').getPublicUrl(path).data.publicUrl;}
 function setFeature圖片(url){const preview=qs('#feature-image-preview'),img=qs('#feature-image-img');img.dataset.url=url||'';img.src=url||'';preview.hidden=!url;}
 function syncLifecycleButtons(){const published=postStatus==='published';qs('#unpublish').hidden=!published;qs('#delete-post').hidden=userRole!=='admin';}
 function scheduleSave(){qs('#save-state').textContent='尚未儲存';clearTimeout(saveTimer);saveTimer=setTimeout(()=>save(),700);}
 function syncBlocks(){blocks=[...blocksEl.querySelectorAll('.block')].map(row=>row.dataset.type==='image'?{type:'image',url:row.querySelector('.image-url')?.value||'',alt:row.querySelector('.image-alt')?.value||'',caption:row.querySelector('.image-caption')?.value||''}:{type:row.dataset.type,text:row.querySelector('textarea')?.value||''});}
 async function save(status){if(!supabase)return false;if(editorMode==='plain'){blocks=plainToBlocks(qs('#plain-body').value);}else syncBlocks();qs('#save-state').textContent='儲存中…';const requested=slugify(qs('#slug').value||qs('#title').value)||('draft-'+id),slug=postStatus==='published'&&status!=='published'?originalSlug:requested;const data={title:qs('#title').value.trim(),slug,excerpt:qs('#excerpt').value.trim(),featured:qs('#featured').checked,feature_image:qs('#feature-image-img')?.dataset.url||null,feature_image_alt:qs('#feature-image-alt').value.trim(),title_en:qs('#title-en').value.trim()||null,excerpt_en:qs('#excerpt-en').value.trim()||null,html_en:originalHtmlEn||null,feature_image_alt_en:qs('#feature-image-alt-en').value.trim()||null,content:{version:2,blocks},html:renderHtml(blocks),updated_at:new Date().toISOString()};if(status==='published'){data.status='published';data.published_at=new Date().toISOString();}else if(status==='draft'){data.status='draft';}const {error}=await supabase.from('posts').update(data).eq('id',id);if(error){qs('#save-state').textContent=error.code==='23505'?'此網址代稱已被使用':error.message;return false;}const tagIds=[...document.querySelectorAll('#tag-options input:checked')].map(x=>x.value);const {error:tagError}=await supabase.from('post_tags').delete().eq('post_id',id);if(!tagError&&tagIds.length){const {error:e}=await supabase.from('post_tags').insert(tagIds.map(tag_id=>({post_id:id,tag_id})));if(e){qs('#save-state').textContent=e.message;return false;}}else if(tagError){qs('#save-state').textContent=tagError.message;return false;}if(status==='published'){postStatus='published';originalSlug=data.slug;}qs('#slug').value=data.slug;qs('#save-state').textContent='已儲存';return true;}
 function setMode(mode){if(mode===editorMode)return;if(mode==='plain'){syncBlocks();qs('#plain-body').value=blocksToPlain(blocks);}else{blocks=plainToBlocks(qs('#plain-body').value);renderBlocks();}editorMode=mode;qs('#plain-body').hidden=mode!=='plain';qs('#structured-editor').hidden=mode==='plain';qs('#plain-mode').classList.toggle('active',mode==='plain');qs('#structured-mode').classList.toggle('active',mode==='structured');}
 function blocksToPlain(items){return items.map(b=>b.type==='divider'?'---':b.type==='image'?(b.caption||b.alt||''):b.text||'').filter(Boolean).join('

');}
 function plainToBlocks(text){const parts=String(text||'').split(/
\s*
/).map(x=>x.trim()).filter(Boolean);return (parts.length?parts:['']).map(text=>({type:'paragraph',text}));}
 function readBlocks(p){if(Array.isArray(p.content?.blocks)&&p.content.blocks.length)return p.content.blocks.map(b=>b.type==='image'?{type:'image',url:String(b.url||''),alt:String(b.alt||''),caption:String(b.caption||'')}:{type:['paragraph','heading','quote','code','divider'].includes(b.type)?b.type:'paragraph',text:String(b.text||'')});const text=String(p.html||'').replace(/<\/p>/gi,'

').replace(/<br\s*\/?>/gi,'
').replace(/<[^>]*>/g,'').trim();return text?[{type:'paragraph',text}]:[{type:'paragraph',text:''}];}
 function renderBlocks(){blocksEl.innerHTML=blocks.map((b,i)=>`<section class="block" data-index="${i}" data-type="${b.type}"><div class="blockbar"><span>${label(b.type)}</span><div><button class="up" title="上移">↑</button><button class="down" title="下移">↓</button><button class="remove" title="移除">×</button></div></div>${b.type==='divider'?'<hr>':b.type==='image'?`<div class="image-editor">${b.url?`<img src="${escapeAttr(b.url)}" alt="${escapeAttr(b.alt)}">`:''}<input class="image-file" type="file" accept="image/*"><input class="image-url" type="hidden" value="${escapeAttr(b.url)}"><input class="image-alt" value="${escapeAttr(b.alt)}" placeholder="圖片替代文字"><input class="image-caption" value="${escapeAttr(b.caption)}" placeholder="圖片說明（選填）"></div>`:`<textarea rows="${b.type==='code'?5:3}" placeholder="${label(b.type)}">${escapeHtml(b.text)}</textarea>`}</section>`).join('');}
 function renderHtml(items){return items.map(b=>{const t=escapeHtml(b.text).replace(/
/g,'<br>');if(b.type==='heading')return '<h2>'+t+'</h2>';if(b.type==='quote')return '<blockquote>'+t+'</blockquote>';if(b.type==='code')return '<pre><code>'+escapeHtml(b.text)+'</code></pre>';if(b.type==='divider')return '<hr>';if(b.type==='image'){if(!b.url)return '';const caption=b.caption?'<figcaption>'+escapeHtml(b.caption)+'</figcaption>':'';return '<figure><img src="'+escapeAttr(b.url)+'" alt="'+escapeAttr(b.alt||'')+'" loading="lazy">'+caption+'</figure>';}return '<p>'+t+'</p>';}).join('');}
 async function load標籤(){const [{data:tags,error},{data:links}]=await Promise.all([supabase.from('tags').select('id,name').order('name'),supabase.from('post_tags').select('tag_id').eq('post_id',id)]);const box=qs('#tag-options');if(error){box.textContent=error.message;return;}const selected=new Set((links||[]).map(x=>x.tag_id));box.innerHTML=(tags||[]).length?(tags||[]).map(t=>`<label class="tag-option"><input type="checkbox" value="${t.id}" ${selected.has(t.id)?'checked':''}> ${escapeHtml(t.name)}</label>`).join(''):'<span class="hint">請先到「標籤」頁建立標籤。</span>';}
 function label(t){return ({paragraph:'段落',heading:'標題',quote:'引言',code:'程式碼',divider:'分隔線',image:'圖片'})[t]||'段落';}
 function slugify(v){return String(v).toLowerCase().trim().normalize('NFKD').replace(/[^\p{Letter}\p{Number}]+/gu,'-').replace(/^-|-$/g,'');}
 function escapeHtml(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));}
 function escapeAttr(v){return escapeHtml(v);}
</script>
<style>
.editor{min-height:100vh;background:#f5f5f3}.bar{height:58px;position:sticky;top:0;z-index:8;background:rgba(255,255,255,.96);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 24px}.bar-left,.actions{display:flex;align-items:center;gap:12px}.bar-left a{color:#666;text-decoration:none;font-size:12px}.bar-left strong{font-size:12px;font-weight:650}.bar-sep{width:1px;height:16px;background:var(--line)}.actions{gap:8px}.actions span{font-size:11px;color:#888;margin-right:6px}.actions button{border:1px solid transparent;background:none;padding:8px 10px;border-radius:5px;cursor:pointer;font-size:12px}.actions .quiet:hover{background:#f3f3f3}.actions .publish{background:#171717;color:#fff;padding-inline:14px}.actions .danger{color:#9b2c2c}.canvas{width:min(760px,calc(100% - 420px));margin:0 380px 0 auto;padding:52px 44px 100px;min-height:calc(100vh - 58px);background:#fff}.editor-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;padding-bottom:20px;border-bottom:1px solid var(--line);margin-bottom:38px}.eyebrow{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.editor-head p,.settings-head p{margin:6px 0 0;color:#999;font-size:11px}.modebar{display:flex;background:#f2f2f0;border-radius:6px;padding:3px;flex:none}.modebar button{border:0;background:transparent;padding:7px 11px;border-radius:4px;color:#777;cursor:pointer;font-size:11px}.modebar button.active{background:#fff;color:#111;box-shadow:0 1px 3px rgba(0,0,0,.08)}.title{display:block;width:100%;border:0;outline:0;font-size:40px;line-height:1.2;font-weight:650;padding:0;margin:0 0 18px;background:transparent}.title-en{font-size:20px;font-weight:450;color:#777;margin-bottom:42px}.plain-body{display:block;width:100%;min-height:52vh;border:0;outline:0;resize:vertical;font:18px/1.85 Georgia,"Noto Serif TC",serif;padding:0}.plain-body[hidden]{display:none}.blocks{display:grid;gap:12px}.block{border:1px solid transparent;border-radius:5px;padding:8px 10px}.block:focus-within,.block:hover{border-color:var(--line)}.blockbar{display:flex;justify-content:space-between;align-items:center;font-size:9px;color:#aaa;text-transform:uppercase;letter-spacing:.08em}.blockbar button{border:0;background:none;color:#aaa;cursor:pointer}.block textarea{display:block;width:100%;border:0;outline:0;resize:vertical;padding:8px 0;font:18px/1.75 Georgia,"Noto Serif TC",serif}.block[data-type="heading"] textarea{font-size:27px;font-weight:600}.block[data-type="quote"] textarea{border-left:2px solid #222;padding-left:18px;font-style:italic}.block[data-type="code"] textarea{font:13px/1.6 monospace;background:#f7f7f5;padding:14px}.block hr{border:0;border-top:1px solid #bbb;margin:24px 0}.image-editor{display:grid;gap:8px;padding:10px 0}.image-editor img{display:block;max-width:100%;max-height:400px;object-fit:contain;background:#f7f7f5}.image-editor input:not([type=file]){border:1px solid var(--line);padding:9px;background:#fff}.image-editor .image-file{font-size:11px}.addbar{display:flex;gap:6px;flex-wrap:wrap;margin-top:24px;padding-top:16px;border-top:1px solid var(--line)}.addbar button{border:1px solid var(--line);border-radius:4px;background:#fff;padding:7px 9px;font-size:10px;color:#555;cursor:pointer}.settings{position:fixed;right:0;top:58px;bottom:0;width:340px;background:#fafafa;border-left:1px solid var(--line);padding:26px 24px;overflow:auto}.settings-head{padding-bottom:20px}.setting-group{border-top:1px solid var(--line);padding:20px 0 4px}.setting-group h3{font-size:11px;margin:0 0 14px;text-transform:uppercase;letter-spacing:.06em;color:#666}.setting-group h3 small{font-weight:400;text-transform:none;letter-spacing:0;color:#aaa}.settings label{display:grid;gap:6px;font-size:11px;color:#555;margin:0 0 16px}.settings input,.settings textarea{width:100%;border:1px solid #ddd;border-radius:4px;background:#fff;padding:9px 10px;font-size:12px;outline:0}.settings input:focus,.settings textarea:focus{border-color:#999}.settings .check{display:flex;align-items:center;gap:8px}.settings .check input{width:auto}.tag-field{border:0;padding:0;margin:0}.tag-field legend{display:none}.tag-option{display:flex!important;align-items:center;gap:7px!important;margin:7px 0!important}.tag-option input{width:auto}.hint{font-size:11px;line-height:1.5;color:#888}.feature-image-preview{display:grid;gap:7px;margin:-6px 0 16px}.feature-image-preview[hidden]{display:none}.feature-image-preview img{display:block;max-width:100%;max-height:150px;object-fit:contain;background:#eee}.feature-image-preview button{justify-self:start;border:0;background:none;padding:0;color:#888;cursor:pointer;font-size:11px}.settings-toggle{display:none}.modal{position:fixed;inset:0;background:rgba(0,0,0,.35);padding:5vh;z-index:20}.preview-card{background:#fff;max-width:880px;height:90vh;overflow:auto;margin:auto;padding:24px 10%}.preview-card>button{float:right}.preview-card article{max-width:650px;margin:10vh auto}.preview-card h1{font-size:40px}.preview-card #preview-body{font:18px/1.8 Georgia,serif}.preview-card pre{white-space:pre-wrap;background:#f7f7f7;padding:16px}.preview-card figure{margin:36px 0}.preview-card figure img{display:block;max-width:100%;height:auto}.preview-card figcaption{font-size:12px;color:#777;margin-top:8px}
@media(max-width:1050px){.canvas{width:min(760px,calc(100% - 40px));margin:auto;padding:40px 28px 90px}.settings{right:-340px;z-index:12;box-shadow:-12px 0 30px rgba(0,0,0,.08)}.settings.open{right:0}.settings-toggle{display:block;position:fixed;right:20px;bottom:20px;z-index:13;border:1px solid var(--line);background:#fff;width:42px;height:42px;border-radius:50%;cursor:pointer}.bar{padding:0 16px}.bar-left strong,.bar-sep{display:none}}@media(max-width:640px){.bar{height:auto;min-height:58px;flex-wrap:wrap;gap:6px;padding-top:8px;padding-bottom:8px}.actions{gap:3px;flex-wrap:wrap;justify-content:flex-end}.actions span{width:100%;text-align:right;margin:0}.actions button{padding:6px 7px;font-size:10px}.canvas{width:100%;padding:30px 20px 80px}.editor-head{align-items:flex-start;flex-direction:column}.title{font-size:32px}}
</style>
</AdminLayout>
