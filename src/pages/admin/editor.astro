---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Editor — Field Notes CMS">
<div id="editor" class="editor" hidden>
 <header class="bar"><a href="/admin">← Posts</a><div class="actions"><span id="save-state">Saved</span><button id="preview" class="quiet">Preview</button><button id="publish" class="publish">Publish</button></div></header>
 <main class="canvas">
  <input id="title" class="title" placeholder="Post title" aria-label="Post title">
  <textarea id="body" class="body" placeholder="Begin writing…" aria-label="Post body"></textarea>
 </main>
 <button id="settings-toggle" class="settings-toggle" aria-label="Post settings">⚙</button>
 <aside id="settings" class="settings">
  <h2>Post settings</h2>
  <label>URL<input id="slug"></label>
  <label>Excerpt<textarea id="excerpt" rows="5"></textarea></label>\n  <fieldset class="tag-field"><legend>Tags</legend><div id="tag-options">Loading…</div></fieldset>
  <label class="check"><input id="featured" type="checkbox"> Feature this post</label>
  <p class="hint">Structured block editing, tags and media follow in the next implementation phase.</p>
 </aside>
</div>
<div id="preview-modal" class="modal" hidden><div class="preview-card"><button id="close-preview">Close</button><article><h1 id="preview-title"></h1><div id="preview-body"></div></article></div></div>
<script>
 import { supabaseConfigured,getSupabaseClient } from '../../lib/supabase-client.js';
 const qs=s=>document.querySelector(s),id=new URLSearchParams(location.search).get('id'),root=qs('#editor');let saveTimer=null,supabase,postStatus='draft',originalSlug='',slugTouched=false;
 if(!supabaseConfigured||!id)location.href='/admin/login';
 else{
  supabase=getSupabaseClient();const {data:{session}}=await supabase.auth.getSession();
  if(!session)location.href='/admin/login';
  else{
   const {data:profile}=await supabase.from('profiles').select('role').eq('id',session.user.id).single();
   if(!['admin','editor'].includes(profile?.role)){await supabase.auth.signOut();location.href='/admin/login';}
   else{
    const {data:p,error}=await supabase.from('posts').select('*').eq('id',id).single();
    if(error||!p)location.href='/admin';
    else{postStatus=p.status||'draft';originalSlug=p.slug||'';qs('#title').value=p.title||'';qs('#body').value=plainText(p);qs('#slug').value=originalSlug;qs('#excerpt').value=p.excerpt||'';qs('#featured').checked=Boolean(p.featured);await loadTags();root.hidden=false;}
   }
  }
 }
 ['#title','#body','#excerpt','#featured'].forEach(s=>qs(s)?.addEventListener('input',scheduleSave));\n qs('#title')?.addEventListener('input',()=>{if(postStatus==='draft'&&!slugTouched){qs('#slug').value=slugify(qs('#title').value)||originalSlug;}});\n qs('#slug')?.addEventListener('input',()=>{slugTouched=true;scheduleSave();});\n qs('#tag-options')?.addEventListener('change',scheduleSave);
 qs('#settings-toggle')?.addEventListener('click',()=>qs('#settings').classList.toggle('open'));
 qs('#publish')?.addEventListener('click',async()=>{await save('published');qs('#publish').textContent='Published';});
 qs('#preview')?.addEventListener('click',()=>{qs('#preview-title').textContent=qs('#title').value||'Untitled';qs('#preview-body').innerHTML=renderHtml(qs('#body').value);qs('#preview-modal').hidden=false;});
 qs('#close-preview')?.addEventListener('click',()=>qs('#preview-modal').hidden=true);
 function scheduleSave(){qs('#save-state').textContent='Unsaved';clearTimeout(saveTimer);saveTimer=setTimeout(()=>save(),700);}
 async function save(status){if(!supabase)return;qs('#save-state').textContent='Saving…';const body=qs('#body').value;const requested=slugify(qs('#slug').value||qs('#title').value)||('draft-'+id),slug=postStatus==='published'&&status!=='published'?originalSlug:requested;const data={title:qs('#title').value.trim(),slug,excerpt:qs('#excerpt').value.trim(),featured:qs('#featured').checked,content:{version:1,blocks:body.split(/\n\n+/).filter(Boolean).map(text=>({type:'paragraph',text}))},html:renderHtml(body),updated_at:new Date().toISOString()};if(status==='published'){data.status='published';data.published_at=new Date().toISOString();}const {error}=await supabase.from('posts').update(data).eq('id',id);if(error){qs('#save-state').textContent=error.code==='23505'?'Slug already in use':error.message;return;}const tagIds=[...document.querySelectorAll('#tag-options input:checked')].map(x=>x.value);const {error:tagError}=await supabase.from('post_tags').delete().eq('post_id',id);if(!tagError&&tagIds.length){const {error:e}=await supabase.from('post_tags').insert(tagIds.map(tag_id=>({post_id:id,tag_id})));if(e){qs('#save-state').textContent=e.message;return;}}else if(tagError){qs('#save-state').textContent=tagError.message;return;}if(status==='published'){postStatus='published';originalSlug=data.slug;}qs('#slug').value=data.slug;qs('#save-state').textContent='Saved';}\n async function loadTags(){const [{data:tags,error},{data:links}]=await Promise.all([supabase.from('tags').select('id,name').order('name'),supabase.from('post_tags').select('tag_id').eq('post_id',id)]);const box=qs('#tag-options');if(error){box.textContent=error.message;return;}const selected=new Set((links||[]).map(x=>x.tag_id));box.innerHTML=(tags||[]).length?(tags||[]).map(t=>`<label class="tag-option"><input type="checkbox" value="${t.id}" ${selected.has(t.id)?'checked':''}> ${escapeHtml(t.name)}</label>`).join(''):'<span class="hint">Create tags from the Tags screen first.</span>';}
 function plainText(p){if(p.content?.blocks?.length)return p.content.blocks.map(b=>b.text||'').join('\n\n');return String(p.html||'').replace(/<[^>]*>/g,' ').replace(/\s+/g,' ').trim();}
 function slugify(v){return String(v).toLowerCase().trim().normalize('NFKD').replace(/[^\p{Letter}\p{Number}]+/gu,'-').replace(/^-|-$/g,'');}
 function renderHtml(v){return String(v).split(/\n\n+/).filter(Boolean).map(p=>'<p>'+escapeHtml(p).replace(/\n/g,'<br>')+'</p>').join('');}
 function escapeHtml(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));}
</script>
<style>
.editor{min-height:100vh;background:#fff}.bar{height:64px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px}.bar a{color:#555;text-decoration:none;font-size:13px}.actions{display:flex;align-items:center;gap:18px}.actions span{font-size:11px;color:#999}.actions button{border:0;background:none;cursor:pointer}.actions .publish{background:#151515;color:#fff;padding:9px 14px;border-radius:4px}.canvas{width:min(720px,calc(100% - 48px));margin:12vh auto}.title{display:block;width:100%;border:0;outline:0;font-size:44px;font-weight:650;padding:0;margin-bottom:35px}.body{display:block;width:100%;min-height:50vh;border:0;outline:0;resize:none;font:20px/1.75 Georgia,serif}.settings-toggle{position:fixed;right:24px;bottom:24px;border:1px solid var(--line);background:#fff;width:42px;height:42px;border-radius:50%;cursor:pointer}.settings{position:fixed;right:-360px;top:64px;bottom:0;width:340px;background:#fafafa;border-left:1px solid var(--line);padding:28px;transition:right .2s}.settings.open{right:0}.settings h2{font-size:15px}.settings label{display:grid;gap:8px;font-size:12px;margin:24px 0}.settings input,.settings textarea{border:1px solid var(--line);background:#fff;padding:10px}.settings .check{display:flex;align-items:center}.tag-field{border:0;padding:0;margin:24px 0}.tag-field legend{font-size:12px;margin-bottom:8px}.tag-option{display:flex!important;align-items:center;gap:8px!important;margin:8px 0!important}.tag-option input{width:auto}.hint{font-size:11px;line-height:1.5;color:#888}.modal{position:fixed;inset:0;background:rgba(0,0,0,.25);padding:5vh;z-index:10}.preview-card{background:#fff;max-width:900px;height:90vh;overflow:auto;margin:auto;padding:24px 10%}.preview-card>button{float:right}.preview-card article{max-width:650px;margin:12vh auto}.preview-card h1{font-size:42px}.preview-card #preview-body{font:18px/1.8 Georgia,serif}
</style>
</AdminLayout>
