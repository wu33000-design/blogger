---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Editor — Back Mountain CMS">
<div id="editor" class="editor" hidden>
 <header class="bar"><div class="bar-left"><a href="/admin">← 文章</a><span id="post-state" class="post-state">草稿</span></div><div class="actions"><span id="save-state" class="save-state-sr" aria-live="polite">已儲存</span><button id="save-manual" class="quiet save-control" type="button">已儲存</button><button id="preview" class="quiet">預覽</button><button id="publish" class="publish">發布</button></div></header>
 <main class="canvas">
  <div class="document-tools">
   <div id="rich-toolbar" class="rich-toolbar" aria-label="富文字格式工具列">
    <button type="button" data-rich-command="bold" aria-label="粗體" title="粗體"><strong>B</strong></button>
    <button type="button" data-rich-command="italic" aria-label="斜體" title="斜體"><em>I</em></button>
    <button type="button" data-rich-command="underline" aria-label="底線" title="底線"><u>U</u></button>
    <button type="button" data-rich-command="strikeThrough" aria-label="刪除線" title="刪除線"><s>S</s></button>
    <span class="rich-separator" aria-hidden="true"></span>
    <select id="rich-size" aria-label="字級" title="字級"><option value="">字級</option><option value="2">小</option><option value="3">正文</option><option value="4">大</option><option value="5">特大</option></select>
    <select id="rich-font" aria-label="字體" title="字體"><option value="">字體</option><option value="Georgia">Serif</option><option value="Arial">Sans</option><option value="Courier New">Mono</option></select>
    <span class="rich-separator" aria-hidden="true"></span>
    <button type="button" id="rich-link" aria-label="加入連結" title="加入連結">連結</button>
    <button type="button" id="rich-unlink" aria-label="移除連結" title="移除連結">取消連結</button>
    <button type="button" data-rich-command="removeFormat" aria-label="清除格式" title="清除格式">清除格式</button>
   </div>
   <div class="modebar segmented" aria-label="編輯模式"><button id="plain-mode">純文字</button><button id="structured-mode" class="active">富文字</button></div>
  </div>
  <input id="title" class="title" placeholder="中文標題" aria-label="中文標題">
  <input id="title-en" class="title title-en" placeholder="英文標題（選填）" aria-label="英文標題">
  <textarea id="plain-body" class="plain-body" rows="18" placeholder="輸入文章內文" hidden></textarea>
  <div id="structured-editor"><div id="blocks" class="blocks"></div>
  <div class="addbar"><button data-add="paragraph">+ 段落</button><button data-add="heading">標題</button><button data-add="quote">引言</button><button data-add="code">程式碼</button><button data-add="divider">分隔線</button><button data-add="image">圖片</button></div></div>
 </main>
 <button id="settings-toggle" class="settings-toggle" aria-label="文章設定" aria-controls="settings" aria-expanded="false">⚙</button>
 <aside id="settings" class="settings">
  <div class="settings-head"><strong>文章設定</strong></div>
  <section class="setting-group"><h3>基本資訊</h3><label>網址代稱<input id="slug"></label><label>摘要<textarea id="excerpt" rows="4"></textarea></label></section>
  <section class="setting-group"><h3>分類</h3><fieldset class="tag-field"><legend>標籤</legend><div id="tag-options">載入中…</div></fieldset></section>
  <section class="setting-group"><h3>呈現</h3><label class="check"><input id="featured" type="checkbox"> 設為精選文章 <small>僅限已發布</small></label><label>主視覺圖片<input id="feature-image-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif"></label><div id="feature-image-preview" class="feature-image-preview" hidden><img id="feature-image-img" alt=""><button id="remove-feature-image" type="button">移除主視覺圖片</button></div><label>主視覺替代文字<input id="feature-image-alt" placeholder="描述圖片內容"></label></section>
  <details class="setting-disclosure"><summary>英文資訊 <small>選填</small></summary><div class="setting-disclosure-body"><label>英文摘要<textarea id="excerpt-en" rows="3"></textarea></label><label>英文主視覺替代文字<input id="feature-image-alt-en"></label></div></details>
  <section class="setting-group lifecycle"><h3>文章操作</h3><button id="unpublish" class="lifecycle-action" hidden>取消發布</button><button id="archive-post" class="lifecycle-action" hidden>歸檔</button><button id="restore-post" class="lifecycle-action" hidden>取消歸檔</button><button id="delete-post" class="lifecycle-action danger" hidden>刪除</button></section>
 </aside>
</div>
<div id="preview-modal" class="modal" hidden><div class="preview-card"><button id="close-preview">關閉</button><article><h1 id="preview-title"></h1><div id="preview-body"></div></article></div></div>
<script>
 import { supabaseConfigured,getSupabaseClient } from '../../lib/supabase-client.js';
 const qs=s=>document.querySelector(s),id=new URLSearchParams(location.search).get('id'),root=qs('#editor'),blocksEl=qs('#blocks'),richToolbar=qs('#rich-toolbar');let saveTimer=null,savePromise=null,supabase,userRole='',postStatus='draft',originalSlug='',slugTouched=false,blocks=[],editorMode='structured',originalHtmlEn='',structuredSnapshot=null,plainInitial='',dirty=false,editRevision=0,originalTagIds=new Set(),richRange=null,richEditor=null;
 if(!supabaseConfigured||!id)location.href='/admin/login'; else{
  supabase=getSupabaseClient();const {data:{session}}=await supabase.auth.getSession();
  if(!session)location.href='/admin/login'; else{
   const {data:profile}=await supabase.from('profiles').select('role').eq('id',session.user.id).single();userRole=profile?.role||'';
   if(!['admin','editor'].includes(userRole)){await supabase.auth.signOut();location.href='/admin/login';}else{
    const {data:p,error}=await supabase.from('posts').select('*').eq('id',id).single();
    if(error||!p)location.href='/admin'; else{postStatus=p.status||'draft';originalSlug=p.slug||'';qs('#title').value=p.title||'';qs('#slug').value=originalSlug;qs('#excerpt').value=p.excerpt||'';qs('#title-en').value=p.title_en||'';qs('#excerpt-en').value=p.excerpt_en||'';originalHtmlEn=p.html_en||'';qs('#feature-image-alt-en').value=p.feature_image_alt_en||'';qs('#featured').checked=Boolean(p.featured);qs('#feature-image-alt').value=p.feature_image_alt||'';setFeature圖片(p.feature_image||'');blocks=readBlocks(p);renderBlocks();syncLifecycleButtons();await load標籤();setRichToolbarEnabled(false);root.hidden=false;}
   }
  }
 }
 ['#title','#title-en','#plain-body','#excerpt','#excerpt-en','#feature-image-alt-en','#featured','#feature-image-alt'].forEach(s=>qs(s)?.addEventListener('input',scheduleSave));
 qs('#title')?.addEventListener('input',()=>{if(postStatus==='draft'&&!slugTouched)qs('#slug').value=slugify(qs('#title').value)||originalSlug;});
 qs('#slug')?.addEventListener('input',()=>{slugTouched=true;scheduleSave();});qs('#tag-options')?.addEventListener('change',scheduleSave);
 qs('#settings-toggle')?.addEventListener('click',e=>{const open=qs('#settings').classList.toggle('open');e.currentTarget.setAttribute('aria-expanded',String(open));});qs('#plain-mode')?.addEventListener('click',()=>setMode('plain'));qs('#structured-mode')?.addEventListener('click',()=>setMode('structured'));
 richToolbar?.addEventListener('mousedown',e=>{if(e.target.closest('button'))e.preventDefault();});
 richToolbar?.addEventListener('click',e=>{const command=e.target.closest('[data-rich-command]')?.dataset.richCommand;if(command)applyRichCommand(command);});
 qs('#rich-size')?.addEventListener('change',e=>{if(e.target.value){applyRichCommand('fontSize',e.target.value);e.target.value='';}});
 qs('#rich-font')?.addEventListener('change',e=>{if(e.target.value){applyRichCommand('fontName',e.target.value);e.target.value='';}});
 qs('#rich-link')?.addEventListener('click',()=>{if(!restoreRichSelection())return;const current=document.queryCommandValue('createLink')||'';const url=prompt('輸入連結網址',current&&current!=='false'?current:'https://');if(url)applyRichCommand('createLink',url);});
 qs('#rich-unlink')?.addEventListener('click',()=>applyRichCommand('unlink'));
 document.addEventListener('selectionchange',captureRichSelection);
 blocksEl?.addEventListener('mouseup',captureRichSelection);
 blocksEl?.addEventListener('keyup',captureRichSelection);
 blocksEl?.addEventListener('focusin',e=>{const editor=e.target.closest('.rich-editor');if(editor){richEditor=editor;setRichToolbarEnabled(true);}else{richRange=null;richEditor=null;setRichToolbarEnabled(false);}});
 qs('#feature-image-file')?.addEventListener('change',async e=>{const file=e.target.files?.[0];if(!file)return;const uploaded=await upload圖片(file,'feature');if(!uploaded)return;setFeature圖片(uploaded);scheduleSave();});
 qs('#remove-feature-image')?.addEventListener('click',()=>{setFeature圖片('');scheduleSave();});
 qs('#save-manual')?.addEventListener('click',async()=>{clearTimeout(saveTimer);await save(postStatus==='published'?'published':undefined);});
 document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='s'){e.preventDefault();clearTimeout(saveTimer);void save(postStatus==='published'?'published':undefined);}});
 window.addEventListener('beforeunload',e=>{if(!dirty&&!savePromise)return;e.preventDefault();e.returnValue='';});
 qs('#publish')?.addEventListener('click',async()=>{clearTimeout(saveTimer);const wasPublished=postStatus==='published';const ok=await save('published');if(ok){setSaveState(wasPublished?'已更新文章':'已發布');syncLifecycleButtons();}});
 qs('#unpublish')?.addEventListener('click',async()=>{if(!confirm('確定將這篇文章改回草稿？'))return;clearTimeout(saveTimer);const ok=await save('draft');if(!ok)return;setSaveState('已改為草稿');syncLifecycleButtons();});
 qs('#archive-post')?.addEventListener('click',async()=>{if(!confirm('確定將這篇文章歸檔？已發布文章會從公開網站移除。'))return;clearTimeout(saveTimer);const ok=await save('archived');if(!ok)return;setSaveState('已歸檔');syncLifecycleButtons();});
 qs('#restore-post')?.addEventListener('click',async()=>{clearTimeout(saveTimer);const ok=await save('draft');if(!ok)return;setSaveState('已改為草稿');syncLifecycleButtons();});
 qs('#delete-post')?.addEventListener('click',async()=>{if(!confirm('確定永久刪除這篇文章？此動作無法復原。'))return;clearTimeout(saveTimer);setSaveState('刪除中…');const {error}=await supabase.from('posts').delete().eq('id',id);if(error){setSaveState('刪除失敗');return;}location.href='/admin';});
 qs('#preview')?.addEventListener('click',()=>{if(editorMode==='plain'){const plain=qs('#plain-body').value;blocks=structuredSnapshot&&plain===plainInitial?structuredSnapshot.map(b=>({...b})):mergePlainWithPreserved(plain);}else syncBlocks();qs('#preview-title').textContent=qs('#title').value||'未命名文章';qs('#preview-body').innerHTML=renderHtml(blocks);qs('#preview-modal').hidden=false;});
 qs('#close-preview')?.addEventListener('click',()=>qs('#preview-modal').hidden=true);
 qs('.addbar')?.addEventListener('click',e=>{const b=e.target.closest('[data-add]');if(!b)return;syncBlocks();blocks.push(b.dataset.add==='image'?{type:'image',url:'',alt:'',caption:''}:{type:b.dataset.add,text:'',html:''});renderBlocks();blocksEl.querySelector('.block:last-child .rich-editor, .block:last-child textarea')?.focus();scheduleSave();});
 blocksEl?.addEventListener('input',scheduleSave);
 blocksEl?.addEventListener('keydown',e=>{if(!e.target.closest('.rich-editor')||e.key!=='Enter')return;e.preventDefault();document.execCommand('insertHTML',false,'<br>');scheduleSave();});
 blocksEl?.addEventListener('paste',e=>{const editor=e.target.closest('.rich-editor');if(!editor)return;e.preventDefault();const html=e.clipboardData?.getData('text/html'),text=e.clipboardData?.getData('text/plain')||'';document.execCommand('insertHTML',false,html?cleanRichHtml(html):escapeHtml(text).replace(/\n/g,'<br>'));scheduleSave();});
 blocksEl?.addEventListener('change',async e=>{const input=e.target.closest('.image-file');if(!input?.files?.[0])return;const row=input.closest('.block'),i=Number(row.dataset.index),uploaded=await upload圖片(input.files[0]);if(!uploaded)return;syncBlocks();blocks[i]={...blocks[i],type:'image',url:uploaded};renderBlocks();scheduleSave();});
 blocksEl?.addEventListener('click',e=>{const row=e.target.closest('.block');if(!row)return;const i=Number(row.dataset.index);syncBlocks();if(e.target.closest('.remove'))blocks.splice(i,1);else if(e.target.closest('.up')&&i>0)[blocks[i-1],blocks[i]]=[blocks[i],blocks[i-1]];else if(e.target.closest('.down')&&i<blocks.length-1)[blocks[i+1],blocks[i]]=[blocks[i],blocks[i+1]];else return;renderBlocks();scheduleSave();});
 function setSaveState(text){const state=qs('#save-state'),button=qs('#save-manual');if(state)state.textContent=text;if(!button||button.hidden)return;const label=text==='尚未儲存'?'儲存':text==='正在儲存…'?'儲存中…':text==='已自動儲存'?'已儲存':text;button.textContent=label;button.disabled=text==='正在儲存…'||text==='圖片上傳中…';}
 async function upload圖片(file,kind='blocks'){const allowed={'image/jpeg':'jpg','image/png':'png','image/webp':'webp','image/gif':'gif','image/avif':'avif'};const ext=allowed[file.type];if(!ext){setSaveState('僅支援 JPEG、PNG、WebP、GIF 或 AVIF 圖片');return null;}if(file.size>10*1024*1024){setSaveState('圖片大小不可超過 10 MB');return null;}setSaveState('圖片上傳中…');const path=`posts/${id}/${kind}-${crypto.randomUUID()}.${ext}`;const {error}=await supabase.storage.from('cms-media').upload(path,file,{contentType:file.type,upsert:false});if(error){setSaveState('圖片上傳失敗');return null;}return supabase.storage.from('cms-media').getPublicUrl(path).data.publicUrl;}
 function setFeature圖片(url){const preview=qs('#feature-image-preview'),img=qs('#feature-image-img');img.dataset.url=url||'';img.src=url||'';preview.hidden=!url;}
 function syncLifecycleButtons(){const published=postStatus==='published',archived=postStatus==='archived',featured=qs('#featured'),manual=qs('#save-manual');qs('#post-state').textContent=published?'已發布':archived?'已歸檔':'草稿';qs('#post-state').className='post-state '+postStatus;qs('#publish').textContent=published?'更新文章':'發布';if(manual){manual.hidden=published;if(!published)setSaveState(dirty?'尚未儲存':'已儲存');}qs('#unpublish').hidden=!published;qs('#archive-post').hidden=archived;qs('#restore-post').hidden=!archived;qs('#delete-post').hidden=userRole!=='admin';if(featured){featured.disabled=!published;if(!published)featured.checked=false;featured.title=published?'':'僅已發布文章可設為精選';}}
 function markDirty(){dirty=true;editRevision++;clearTimeout(saveTimer);setSaveState(postStatus==='published'?'有尚未發布的變更':'尚未儲存');if(postStatus!=='published')saveTimer=setTimeout(()=>void save(undefined,'auto'),3000);}
 function scheduleSave(){markDirty();}
 function syncBlocks(){blocks=[...blocksEl.querySelectorAll('.block')].map(row=>{const type=row.dataset.type;if(type==='image')return {type:'image',url:row.querySelector('.image-url')?.value||'',alt:row.querySelector('.image-alt')?.value||'',caption:row.querySelector('.image-caption')?.value||''};if(type==='divider')return {type:'divider',text:''};if(type==='code')return {type:'code',text:row.querySelector('textarea')?.value||''};const editor=row.querySelector('.rich-editor'),html=cleanRichHtml(editor?.innerHTML||'');return {type,html,text:(editor?.innerText||'').replace(/\n{3,}/g,'\n\n')};});}
 function sameTagIds(ids){if(ids.length!==originalTagIds.size)return false;return ids.every(x=>originalTagIds.has(x));}
 async function save(status,mode='manual'){if(!supabase)return false;clearTimeout(saveTimer);if(!dirty&&(!status||status===postStatus)){setSaveState(postStatus==='published'?'已更新文章':'已儲存');return true;}if(savePromise){await savePromise;if(!dirty&&(!status||status===postStatus))return true;}const revision=editRevision;savePromise=(async()=>{if(editorMode==='plain'){const plain=qs('#plain-body').value;blocks=structuredSnapshot&&plain===plainInitial?structuredSnapshot.map(b=>({...b})):mergePlainWithPreserved(plain);}else syncBlocks();setSaveState('正在儲存…');const requested=slugify(qs('#slug').value||qs('#title').value)||('draft-'+id),slug=postStatus==='published'&&status!=='published'?originalSlug:requested;const targetStatus=status||postStatus;const data={title:qs('#title').value.trim(),slug,excerpt:qs('#excerpt').value.trim(),featured:targetStatus==='published'&&qs('#featured').checked,feature_image:qs('#feature-image-img')?.dataset.url||null,feature_image_alt:qs('#feature-image-alt').value.trim(),title_en:qs('#title-en').value.trim()||null,excerpt_en:qs('#excerpt-en').value.trim()||null,html_en:originalHtmlEn||null,feature_image_alt_en:qs('#feature-image-alt-en').value.trim()||null,content:{version:3,blocks},html:renderHtml(blocks),updated_at:new Date().toISOString()};if(status==='published'){data.status='published';if(postStatus!=='published')data.published_at=new Date().toISOString();}else if(status==='draft'||status==='archived'){data.status=status;}const {error}=await supabase.from('posts').update(data).eq('id',id);if(error){setSaveState(error.code==='23505'?'儲存失敗：此網址代稱已被使用':'儲存失敗');return false;}const tagIds=[...document.querySelectorAll('#tag-options input:checked')].map(x=>x.value);if(!sameTagIds(tagIds)){const {error:tagError}=await supabase.from('post_tags').delete().eq('post_id',id);if(tagError){setSaveState('儲存失敗：標籤更新失敗');return false;}if(tagIds.length){const {error:e}=await supabase.from('post_tags').insert(tagIds.map(tag_id=>({post_id:id,tag_id})));if(e){setSaveState('儲存失敗：標籤更新失敗');return false;}}originalTagIds=new Set(tagIds);}if(status){postStatus=status;if(status==='published')originalSlug=data.slug;else qs('#featured').checked=false;syncLifecycleButtons();}qs('#slug').value=data.slug;if(editRevision===revision){dirty=false;setSaveState(postStatus==='published'?'已更新文章':mode==='auto'?'已自動儲存':'已儲存');}else{dirty=true;setSaveState(postStatus==='published'?'有尚未發布的變更':'尚未儲存');if(postStatus!=='published')saveTimer=setTimeout(()=>void save(undefined,'auto'),3000);}return true;})();try{return await savePromise;}finally{savePromise=null;}}
 function setMode(mode){if(mode===editorMode)return;if(mode==='plain'){syncBlocks();structuredSnapshot=blocks.map(b=>({...b}));plainInitial=blocksToPlain(blocks);qs('#plain-body').value=plainInitial;}else{const plain=qs('#plain-body').value;if(structuredSnapshot&&plain===plainInitial){blocks=structuredSnapshot.map(b=>({...b}));}else{blocks=mergePlainWithPreserved(plain);}renderBlocks();structuredSnapshot=null;plainInitial='';}editorMode=mode;richRange=null;richEditor=null;setRichToolbarEnabled(false);qs('#plain-body').hidden=mode!=='plain';qs('#structured-editor').hidden=mode==='plain';if(richToolbar)richToolbar.hidden=mode==='plain';qs('#plain-mode').classList.toggle('active',mode==='plain');qs('#structured-mode').classList.toggle('active',mode==='structured');}
 function blockPlainText(b){if(b.type==='divider')return '---';if(b.type==='image')return b.caption||b.alt||'';if(b.type==='code')return b.text||'';if(b.html){const box=document.createElement('div');box.innerHTML=cleanRichHtml(b.html);return box.innerText||'';}return b.text||'';}
 function blocksToPlain(items){return items.map(blockPlainText).filter(Boolean).join('\n\n');}
 function mergePlainWithPreserved(text){const preserved=(structuredSnapshot||[]).filter(b=>b.type==='image'||b.type==='divider').map(b=>({...b}));return [...plainToBlocks(text),...preserved];}
 function plainToBlocks(text){const parts=String(text||'').split(/\n\s*\n/).map(x=>x.trim()).filter(Boolean);return (parts.length?parts:['']).map(text=>({type:'paragraph',text,html:escapeHtml(text).replace(/\n/g,'<br>')}));}
 function readBlocks(p){if(Array.isArray(p.content?.blocks)&&p.content.blocks.length)return p.content.blocks.map(b=>{const type=['paragraph','heading','quote','code','divider','image'].includes(b.type)?b.type:'paragraph';if(type==='image')return {type,url:String(b.url||''),alt:String(b.alt||''),caption:String(b.caption||'')};if(type==='divider')return {type,text:''};if(type==='code')return {type,text:String(b.text||'')};const text=String(b.text||'');return {type,text,html:cleanRichHtml(b.html??escapeHtml(text).replace(/\n/g,'<br>'))};});const html=String(p.html||'').trim();if(html){const box=document.createElement('div');box.innerHTML=html;const converted=[...box.children].map(el=>{const tag=el.tagName.toLowerCase(),type=tag==='h2'?'heading':tag==='blockquote'?'quote':tag==='pre'?'code':tag==='hr'?'divider':'paragraph';if(type==='divider')return {type,text:''};if(type==='code')return {type,text:el.textContent||''};return {type,text:el.innerText||'',html:cleanRichHtml(el.innerHTML)};});if(converted.length)return converted;}return [{type:'paragraph',text:'',html:''}];}
 function renderBlocks(){blocksEl.innerHTML=blocks.map((b,i)=>{const rich=cleanRichHtml(b.html??escapeHtml(b.text||'').replace(/\n/g,'<br>'));return `<section class="block" data-index="${i}" data-type="${b.type}"><div class="block-label">${label(b.type)}</div><div class="block-row"><div class="block-content">${b.type==='divider'?'<hr>':b.type==='image'?`<div class="image-editor">${b.url?`<img src="${escapeAttr(b.url)}" alt="${escapeAttr(b.alt)}">`:''}<input class="image-file" type="file" accept="image/*"><input class="image-url" type="hidden" value="${escapeAttr(b.url)}"><input class="image-alt" value="${escapeAttr(b.alt)}" placeholder="圖片替代文字"><input class="image-caption" value="${escapeAttr(b.caption)}" placeholder="圖片說明（選填）"></div>`:b.type==='code'?`<textarea rows="5" placeholder="程式碼">${escapeHtml(b.text||'')}</textarea>`:`<div class="rich-editor" contenteditable="true" role="textbox" aria-multiline="true" data-placeholder="${label(b.type)}" spellcheck="true">${rich}</div>`}</div><div class="block-actions"><button class="up" title="上移" aria-label="上移">↑</button><button class="down" title="下移" aria-label="下移">↓</button><button class="remove" title="移除" aria-label="移除">×</button></div></div></section>`;}).join('');}
 function renderHtml(items){return items.map(b=>{if(b.type==='code')return '<pre><code>'+escapeHtml(b.text||'')+'</code></pre>';if(b.type==='divider')return '<hr>';if(b.type==='image'){if(!b.url)return '';const caption=b.caption?'<figcaption>'+escapeHtml(b.caption)+'</figcaption>':'';return '<figure><img src="'+escapeAttr(b.url)+'" alt="'+escapeAttr(b.alt||'')+'" loading="lazy">'+caption+'</figure>';}const rich=cleanRichHtml(b.html??escapeHtml(b.text||'').replace(/\n/g,'<br>'));if(b.type==='heading')return '<h2>'+rich+'</h2>';if(b.type==='quote')return '<blockquote>'+rich+'</blockquote>';return '<p>'+rich+'</p>';}).join('');}
 function setRichToolbarEnabled(enabled){if(!richToolbar)return;richToolbar.classList.toggle('is-disabled',!enabled);richToolbar.setAttribute('aria-disabled',String(!enabled));for(const control of richToolbar.querySelectorAll('button,select'))control.disabled=!enabled;if(!enabled)for(const button of richToolbar.querySelectorAll('[aria-pressed]'))button.setAttribute('aria-pressed','false');}
 function selectionEditor(range){const node=range?.commonAncestorContainer?.nodeType===1?range.commonAncestorContainer:range?.commonAncestorContainer?.parentElement;return node?.closest?.('.rich-editor')||null;}
 function captureRichSelection(){if(editorMode!=='structured')return;const selection=getSelection();if(!selection?.rangeCount)return;const range=selection.getRangeAt(0),editor=selectionEditor(range);if(editor&&blocksEl.contains(editor)){richEditor=editor;richRange=range.cloneRange();setRichToolbarEnabled(true);updateRichToolbar();}}
 function restoreRichSelection(){if(!richRange||!richEditor||!document.contains(richEditor))return false;richEditor.focus({preventScroll:true});const selection=getSelection();selection.removeAllRanges();selection.addRange(richRange);return true;}
 function closestInline(node,selector){const el=node?.nodeType===1?node:node?.parentElement;const match=el?.closest?.(selector);return match&&richEditor?.contains(match)?match:null;}
 function selectNodeContents(node){const range=document.createRange();range.selectNodeContents(node);const selection=getSelection();selection.removeAllRanges();selection.addRange(range);richRange=range.cloneRange();richEditor=node.closest?.('.rich-editor')||richEditor;}
 function stripFragmentToken(fragment,attr){for(const span of [...fragment.querySelectorAll('span['+attr+']')]){span.removeAttribute(attr);if(!span.dataset.size&&!span.dataset.font&&!span.attributes.length)span.replaceWith(...span.childNodes);}}
 function wrapRichSelection(tag,attrs={},replaceAttr=''){if(!restoreRichSelection())return false;const selection=getSelection(),range=selection?.rangeCount?selection.getRangeAt(0):null;if(!range||range.collapsed)return false;const wrapper=document.createElement(tag);for(const [name,value] of Object.entries(attrs)){if(value===''||value==null)continue;wrapper.setAttribute(name,String(value));}try{const fragment=range.extractContents();if(replaceAttr)stripFragmentToken(fragment,replaceAttr);wrapper.appendChild(fragment);range.insertNode(wrapper);selectNodeContents(wrapper);scheduleSave();updateRichToolbar();return true;}catch{return false;}}
 function unwrapElement(el){if(!el?.parentNode)return;const parent=el.parentNode,first=el.firstChild,last=el.lastChild;while(el.firstChild)parent.insertBefore(el.firstChild,el);el.remove();if(first&&last){const range=document.createRange();range.setStartBefore(first);range.setEndAfter(last);const selection=getSelection();selection.removeAllRanges();selection.addRange(range);richRange=range.cloneRange();}scheduleSave();updateRichToolbar();}
 function applyRichCommand(command,value=null){if(!restoreRichSelection())return false;const selection=getSelection(),range=selection?.rangeCount?selection.getRangeAt(0):null;if(!range)return false;if(range.collapsed){document.execCommand('styleWithCSS',false,false);document.execCommand(command,false,value);captureRichSelection();scheduleSave();return true;}const tagMap={bold:'strong',italic:'em',underline:'u',strikeThrough:'s'},selectorMap={bold:'strong,b',italic:'em,i',underline:'u',strikeThrough:'s,strike'};if(tagMap[command]){const start=closestInline(range.startContainer,selectorMap[command]),end=closestInline(range.endContainer,selectorMap[command]);if(start&&start===end){unwrapElement(start);return true;}return wrapRichSelection(tagMap[command]);}if(command==='fontSize')return wrapRichSelection('span',{'data-size':sizeToken(value)},'data-size');if(command==='fontName')return wrapRichSelection('span',{'data-font':fontToken(value)},'data-font');if(command==='createLink'){const href=cleanRichHref(value);return href?wrapRichSelection('a',{href,target:/^https?:/i.test(href)?'_blank':'',rel:'noopener noreferrer'}):false;}if(command==='unlink'){const start=closestInline(range.startContainer,'a'),end=closestInline(range.endContainer,'a');if(start&&start===end){unwrapElement(start);return true;}for(const anchor of [...richEditor.querySelectorAll('a')])if(selection.containsNode(anchor,true))unwrapElement(anchor);return true;}if(command==='removeFormat'){const fragment=range.extractContents(),walker=document.createTreeWalker(fragment,NodeFilter.SHOW_ELEMENT);const nodes=[];while(walker.nextNode())nodes.push(walker.currentNode);for(const el of nodes.reverse()){if(['STRONG','B','EM','I','U','S','STRIKE','A','SPAN'].includes(el.tagName))el.replaceWith(...el.childNodes);}range.insertNode(fragment);richEditor.normalize();captureRichSelection();scheduleSave();updateRichToolbar();return true;}return false;}
 function updateRichToolbar(){if(!richRange)return;const map={bold:'strong,b',italic:'em,i',underline:'u',strikeThrough:'s,strike'};for(const button of richToolbar?.querySelectorAll('[data-rich-command]')||[]){const selector=map[button.dataset.richCommand];if(!selector)continue;const active=Boolean(closestInline(richRange.startContainer,selector)&&closestInline(richRange.endContainer,selector));button.setAttribute('aria-pressed',String(active));}}
 function cleanRichHref(value){const href=String(value||'').trim();if(!href)return '';if(href.startsWith('/')||href.startsWith('#')||href.startsWith('mailto:'))return href;try{const url=new URL(href,location.origin);return ['http:','https:'].includes(url.protocol)?href:'';}catch{return '';}}
 function fontToken(value){const v=String(value||'').toLowerCase();if(v.includes('courier')||v.includes('mono'))return 'mono';if(v.includes('arial')||v.includes('inter')||v.includes('sans'))return 'sans';if(v.includes('georgia')||v.includes('serif'))return 'serif';return '';}
 function sizeToken(value){const v=String(value||'').trim().toLowerCase();if(['small','normal','large','xlarge'].includes(v))return v;if(v==='1'||v==='2')return 'small';if(v==='3')return 'normal';if(v==='4')return 'large';if(['5','6','7'].includes(v))return 'xlarge';const px=parseFloat(v);if(Number.isFinite(px))return px<=14?'small':px<=18?'normal':px<=24?'large':'xlarge';return '';}
 function normalizeStyleSpans(root){let changed=true;while(changed){changed=false;for(const span of [...root.querySelectorAll('span')]){const meaningful=[...span.childNodes].filter(n=>n.nodeType!==3||n.textContent.trim());if(meaningful.length!==1||meaningful[0].nodeType!==1||meaningful[0].tagName!=='SPAN')continue;const child=meaningful[0],font=child.dataset.font||span.dataset.font,size=child.dataset.size||span.dataset.size;if(font)child.dataset.font=font;else delete child.dataset.font;if(size)child.dataset.size=size;else delete child.dataset.size;span.replaceWith(child);changed=true;break;}}for(const span of [...root.querySelectorAll('span')])if(!span.dataset.font&&!span.dataset.size)span.replaceWith(...span.childNodes);}
 function cleanRichHtml(value){const root=document.createElement('div');root.innerHTML=String(value||'');for(const el of [...root.querySelectorAll('*')]){const tag=el.tagName;if(tag==='SCRIPT'||tag==='STYLE'||tag==='IFRAME'||tag==='OBJECT'){el.remove();continue;}if(tag==='FONT'){const span=document.createElement('span'),font=fontToken(el.getAttribute('face')),size=sizeToken(el.getAttribute('size'));if(font)span.dataset.font=font;if(size)span.dataset.size=size;while(el.firstChild)span.appendChild(el.firstChild);el.replaceWith(span);continue;}if(['P','DIV','LI'].includes(tag)){const br=document.createElement('br');el.after(br);el.replaceWith(...el.childNodes);continue;}const allowed=['STRONG','B','EM','I','U','S','STRIKE','A','SPAN','BR'];if(!allowed.includes(tag)){el.replaceWith(...el.childNodes);continue;}if(tag==='B'){const strong=document.createElement('strong');while(el.firstChild)strong.appendChild(el.firstChild);el.replaceWith(strong);continue;}if(tag==='I'){const em=document.createElement('em');while(el.firstChild)em.appendChild(el.firstChild);el.replaceWith(em);continue;}if(tag==='STRIKE'){const s=document.createElement('s');while(el.firstChild)s.appendChild(el.firstChild);el.replaceWith(s);continue;}if(tag==='A'){const href=cleanRichHref(el.getAttribute('href'));for(const attr of [...el.attributes])el.removeAttribute(attr.name);if(href){el.setAttribute('href',href);el.setAttribute('rel','noopener noreferrer');if(/^https?:/i.test(href))el.setAttribute('target','_blank');}else el.replaceWith(...el.childNodes);continue;}if(tag==='SPAN'){const font=fontToken(el.dataset.font||el.style.fontFamily),size=sizeToken(el.dataset.size||el.style.fontSize);for(const attr of [...el.attributes])el.removeAttribute(attr.name);if(font)el.dataset.font=font;if(size)el.dataset.size=size;if(!font&&!size)el.replaceWith(...el.childNodes);continue;}for(const attr of [...el.attributes])el.removeAttribute(attr.name);}normalizeStyleSpans(root);return root.innerHTML.replace(/(?:<br>\s*){3,}/gi,'<br><br>').replace(/^(?:<br>\s*)+|(?:<br>\s*)+$/gi,'');}
  async function load標籤(){const [{data:tags,error},{data:links}]=await Promise.all([supabase.from('tags').select('id,name').order('name'),supabase.from('post_tags').select('tag_id').eq('post_id',id)]);const box=qs('#tag-options');if(error){box.textContent='標籤載入失敗';return;}const selected=new Set((links||[]).map(x=>x.tag_id));originalTagIds=new Set(selected);box.innerHTML=(tags||[]).length?(tags||[]).map(t=>`<label class="tag-option"><input type="checkbox" value="${t.id}" ${selected.has(t.id)?'checked':''}> ${escapeHtml(t.name)}</label>`).join(''):'<span class="hint">請先到「標籤」頁建立標籤。</span>';}
 function label(t){return ({paragraph:'段落',heading:'標題',quote:'引言',code:'程式碼',divider:'分隔線',image:'圖片'})[t]||'段落';}
 function slugify(v){return String(v).toLowerCase().trim().normalize('NFKD').replace(/[^\p{Letter}\p{Number}]+/gu,'-').replace(/^-|-$/g,'');}
 function escapeHtml(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));}
 function escapeAttr(v){return escapeHtml(v);}
