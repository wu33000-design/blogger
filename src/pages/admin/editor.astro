---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Editor — Field Notes CMS">
<div id="editor" class="editor" hidden>
 <header class="bar"><a href="/admin">← Posts</a><div class="actions"><span id="save-state">Saved</span><button id="preview" class="quiet">Preview</button><button id="publish" class="publish">Publish</button></div></header>
 <main class="canvas">
  <input id="title" class="title" placeholder="Post title" aria-label="Post title">
  <div id="blocks" class="blocks"></div>
  <div class="addbar"><button data-add="paragraph">+ Paragraph</button><button data-add="heading">Heading</button><button data-add="quote">Quote</button><button data-add="code">Code</button><button data-add="divider">Divider</button><button data-add="image">Image</button></div>
 </main>
 <button id="settings-toggle" class="settings-toggle" aria-label="Post settings">⚙</button>
 <aside id="settings" class="settings">
  <h2>Post settings</h2>
  <label>URL<input id="slug"></label>
  <label>Excerpt<textarea id="excerpt" rows="5"></textarea></label>
  <fieldset class="tag-field"><legend>Tags</legend><div id="tag-options">Loading…</div></fieldset>
  <label class="check"><input id="featured" type="checkbox"> Feature this post</label>
 </aside>
</div>
<div id="preview-modal" class="modal" hidden><div class="preview-card"><button id="close-preview">Close</button><article><h1 id="preview-title"></h1><div id="preview-body"></div></article></div></div>
<script>
 import { supabaseConfigured,getSupabaseClient } from '../../lib/supabase-client.js';
 const qs=s=>document.querySelector(s),id=new URLSearchParams(location.search).get('id'),root=qs('#editor'),blocksEl=qs('#blocks');let saveTimer=null,supabase,postStatus='draft',originalSlug='',slugTouched=false,blocks=[];
 if(!supabaseConfigured||!id)location.href='/admin/login'; else{
  supabase=getSupabaseClient();const {data:{session}}=await supabase.auth.getSession();
  if(!session)location.href='/admin/login'; else{
   const {data:profile}=await supabase.from('profiles').select('role').eq('id',session.user.id).single();
   if(!['admin','editor'].includes(profile?.role)){await supabase.auth.signOut();location.href='/admin/login';}else{
    const {data:p,error}=await supabase.from('posts').select('*').eq('id',id).single();
    if(error||!p)location.href='/admin'; else{postStatus=p.status||'draft';originalSlug=p.slug||'';qs('#title').value=p.title||'';qs('#slug').value=originalSlug;qs('#excerpt').value=p.excerpt||'';qs('#featured').checked=Boolean(p.featured);blocks=readBlocks(p);renderBlocks();await loadTags();root.hidden=false;}
   }
  }
 }
 ['#title','#excerpt','#featured'].forEach(s=>qs(s)?.addEventListener('input',scheduleSave));
 qs('#title')?.addEventListener('input',()=>{if(postStatus==='draft'&&!slugTouched)qs('#slug').value=slugify(qs('#title').value)||originalSlug;});
 qs('#slug')?.addEventListener('input',()=>{slugTouched=true;scheduleSave();});qs('#tag-options')?.addEventListener('change',scheduleSave);
 qs('#settings-toggle')?.addEventListener('click',()=>qs('#settings').classList.toggle('open'));
 qs('#publish')?.addEventListener('click',async()=>{await save('published');qs('#publish').textContent='Published';});
 qs('#preview')?.addEventListener('click',()=>{syncBlocks();qs('#preview-title').textContent=qs('#title').value||'Untitled';qs('#preview-body').innerHTML=renderHtml(blocks);qs('#preview-modal').hidden=false;});
 qs('#close-preview')?.addEventListener('click',()=>qs('#preview-modal').hidden=true);
 qs('.addbar')?.addEventListener('click',e=>{const b=e.target.closest('[data-add]');if(!b)return;syncBlocks();blocks.push(b.dataset.add==='image'?{type:'image',url:'',alt:'',caption:''}:{type:b.dataset.add,text:''});renderBlocks();blocksEl.querySelector('.block:last-child textarea')?.focus();scheduleSave();});
 blocksEl?.addEventListener('input',scheduleSave);\n blocksEl?.addEventListener('change',async e=>{const input=e.target.closest('.image-file');if(!input?.files?.[0])return;const row=input.closest('.block'),i=Number(row.dataset.index),file=input.files[0];if(!file.type.startsWith('image/')){qs('#save-state').textContent='Images only';return;}if(file.size>10*1024*1024){qs('#save-state').textContent='Image must be under 10 MB';return;}qs('#save-state').textContent='Uploading image…';const ext=(file.name.split('.').pop()||'jpg').replace(/[^a-z0-9]/gi,'').toLowerCase(),path=`posts/${id}/${crypto.randomUUID()}.${ext}`;const {error}=await supabase.storage.from('cms-media').upload(path,file,{contentType:file.type,upsert:false});if(error){qs('#save-state').textContent=error.message;return;}const {data}=supabase.storage.from('cms-media').getPublicUrl(path);syncBlocks();blocks[i]={...blocks[i],type:'image',url:data.publicUrl};renderBlocks();scheduleSave();});
 blocksEl?.addEventListener('click',e=>{const row=e.target.closest('.block');if(!row)return;const i=Number(row.dataset.index);syncBlocks();if(e.target.closest('.remove'))blocks.splice(i,1);else if(e.target.closest('.up')&&i>0)[blocks[i-1],blocks[i]]=[blocks[i],blocks[i-1]];else if(e.target.closest('.down')&&i<blocks.length-1)[blocks[i+1],blocks[i]]=[blocks[i],blocks[i+1]];else return;renderBlocks();scheduleSave();});
 function scheduleSave(){qs('#save-state').textContent='Unsaved';clearTimeout(saveTimer);saveTimer=setTimeout(()=>save(),700);}
 function syncBlocks(){blocks=[...blocksEl.querySelectorAll('.block')].map(row=>row.dataset.type==='image'?{type:'image',url:row.querySelector('.image-url')?.value||'',alt:row.querySelector('.image-alt')?.value||'',caption:row.querySelector('.image-caption')?.value||''}:{type:row.dataset.type,text:row.querySelector('textarea')?.value||''}));}
 async function save(status){if(!supabase)return;syncBlocks();qs('#save-state').textContent='Saving…';const requested=slugify(qs('#slug').value||qs('#title').value)||('draft-'+id),slug=postStatus==='published'&&status!=='published'?originalSlug:requested;const data={title:qs('#title').value.trim(),slug,excerpt:qs('#excerpt').value.trim(),featured:qs('#featured').checked,content:{version:2,blocks},html:renderHtml(blocks),updated_at:new Date().toISOString()};if(status==='published'){data.status='published';data.published_at=new Date().toISOString();}const {error}=await supabase.from('posts').update(data).eq('id',id);if(error){qs('#save-state').textContent=error.code==='23505'?'Slug already in use':error.message;return;}const tagIds=[...document.querySelectorAll('#tag-options input:checked')].map(x=>x.value);const {error:tagError}=await supabase.from('post_tags').delete().eq('post_id',id);if(!tagError&&tagIds.length){const {error:e}=await supabase.from('post_tags').insert(tagIds.map(tag_id=>({post_id:id,tag_id})));if(e){qs('#save-state').textContent=e.message;return;}}else if(tagError){qs('#save-state').textContent=tagError.message;return;}if(status==='published'){postStatus='published';originalSlug=data.slug;}qs('#slug').value=data.slug;qs('#save-state').textContent='Saved';}
 function readBlocks(p){if(Array.isArray(p.content?.blocks)&&p.content.blocks.length)return p.content.blocks.map(b=>b.type==='image'?{type:'image',url:String(b.url||''),alt:String(b.alt||''),caption:String(b.caption||'')}:{type:['paragraph','heading','quote','code','divider'].includes(b.type)?b.type:'paragraph',text:String(b.text||'')});const text=String(p.html||'').replace(/<\/p>/gi,'\n\n').replace(/<br\s*\/?>/gi,'\n').replace(/<[^>]*>/g,'').trim();return text?[{type:'paragraph',text}]:[{type:'paragraph',text:''}];}
 function renderBlocks(){blocksEl.innerHTML=blocks.map((b,i)=>`<section class="block" data-index="${i}" data-type="${b.type}"><div class="blockbar"><span>${label(b.type)}</span><div><button class="up" title="Move up">↑</button><button class="down" title="Move down">↓</button><button class="remove" title="Remove">×</button></div></div>${b.type==='divider'?'<hr>':b.type==='image'?`<div class="image-editor">${b.url?`<img src="${escapeAttr(b.url)}" alt="${escapeAttr(b.alt)}">`:''}<input class="image-file" type="file" accept="image/*"><input class="image-url" type="hidden" value="${escapeAttr(b.url)}"><input class="image-alt" value="${escapeAttr(b.alt)}" placeholder="Alt text"><input class="image-caption" value="${escapeAttr(b.caption)}" placeholder="Caption (optional)"></div>`:`<textarea rows="${b.type==='code'?5:3}" placeholder="${label(b.type)}">${escapeHtml(b.text)}</textarea>`}</section>`).join('');}
 function renderHtml(items){return items.map(b=>{const t=escapeHtml(b.text).replace(/\n/g,'<br>');if(b.type==='heading')return '<h2>'+t+'</h2>';if(b.type==='quote')return '<blockquote>'+t+'</blockquote>';if(b.type==='code')return '<pre><code>'+escapeHtml(b.text)+'</code></pre>';if(b.type==='divider')return '<hr>';if(b.type==='image'){if(!b.url)return '';const caption=b.caption?'<figcaption>'+escapeHtml(b.caption)+'</figcaption>':'';return '<figure><img src="'+escapeAttr(b.url)+'" alt="'+escapeAttr(b.alt||'')+'" loading="lazy">'+caption+'</figure>';}return '<p>'+t+'</p>';}).join('');}
 async function loadTags(){const [{data:tags,error},{data:links}]=await Promise.all([supabase.from('tags').select('id,name').order('name'),supabase.from('post_tags').select('tag_id').eq('post_id',id)]);const box=qs('#tag-options');if(error){box.textContent=error.message;return;}const selected=new Set((links||[]).map(x=>x.tag_id));box.innerHTML=(tags||[]).length?(tags||[]).map(t=>`<label class="tag-option"><input type="checkbox" value="${t.id}" ${selected.has(t.id)?'checked':''}> ${escapeHtml(t.name)}</label>`).join(''):'<span class="hint">Create tags from the Tags screen first.</span>';}
 function label(t){return ({paragraph:'Paragraph',heading:'Heading',quote:'Quote',code:'Code',divider:'Divider',image:'Image'})[t]||'Paragraph';}
 function slugify(v){return String(v).toLowerCase().trim().normalize('NFKD').replace(/[^\p{Letter}\p{Number}]+/gu,'-').replace(/^-|-$/g,'');}
 function escapeHtml(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot',"'":'&#039;'}[c]));}
</script>
<style>
.editor{min-height:100vh;background:#fff}.bar{height:64px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px}.bar a{color:#555;text-decoration:none;font-size:13px}.actions{display:flex;align-items:center;gap:18px}.actions span{font-size:11px;color:#999}.actions button{border:0;background:none;cursor:pointer}.actions .publish{background:#151515;color:#fff;padding:9px 14px;border-radius:4px}.canvas{width:min(720px,calc(100% - 48px));margin:12vh auto}.title{display:block;width:100%;border:0;outline:0;font-size:44px;font-weight:650;padding:0;margin-bottom:35px}.blocks{display:grid;gap:18px}.block{border:1px solid transparent;padding:8px}.block:focus-within,.block:hover{border-color:var(--line)}.blockbar{display:flex;justify-content:space-between;align-items:center;font-size:10px;color:#999;text-transform:uppercase;letter-spacing:.05em}.blockbar button{border:0;background:none;color:#999;cursor:pointer}.block textarea{display:block;width:100%;border:0;outline:0;resize:vertical;padding:8px 0;font:20px/1.7 Georgia,serif}.block[data-type="heading"] textarea{font-size:30px;font-weight:600}.block[data-type="quote"] textarea{border-left:2px solid #222;padding-left:20px;font-style:italic}.block[data-type="code"] textarea{font:14px/1.6 monospace;background:#f7f7f7;padding:14px}.block hr{border:0;border-top:1px solid #bbb;margin:28px 0}.image-editor{display:grid;gap:9px;padding:12px 0}.image-editor img{display:block;max-width:100%;max-height:420px;object-fit:contain;background:#f7f7f7}.image-editor input:not([type=file]){border:1px solid var(--line);padding:9px;background:#fff}.image-editor .image-file{font-size:12px}.addbar{display:flex;gap:8px;flex-wrap:wrap;margin-top:28px;padding-top:18px;border-top:1px solid var(--line)}.addbar button{border:1px solid var(--line);background:#fff;padding:7px 9px;font-size:11px;cursor:pointer}.settings-toggle{position:fixed;right:24px;bottom:24px;border:1px solid var(--line);background:#fff;width:42px;height:42px;border-radius:50%;cursor:pointer}.settings{position:fixed;right:-360px;top:64px;bottom:0;width:340px;background:#fafafa;border-left:1px solid var(--line);padding:28px;transition:right .2s;overflow:auto}.settings.open{right:0}.settings h2{font-size:15px}.settings label{display:grid;gap:8px;font-size:12px;margin:24px 0}.settings input,.settings textarea{border:1px solid var(--line);background:#fff;padding:10px}.settings .check{display:flex;align-items:center}.tag-field{border:0;padding:0;margin:24px 0}.tag-field legend{font-size:12px;margin-bottom:8px}.tag-option{display:flex!important;align-items:center;gap:8px!important;margin:8px 0!important}.tag-option input{width:auto}.hint{font-size:11px;line-height:1.5;color:#888}.modal{position:fixed;inset:0;background:rgba(0,0,0,.25);padding:5vh;z-index:10}.preview-card{background:#fff;max-width:900px;height:90vh;overflow:auto;margin:auto;padding:24px 10%}.preview-card>button{float:right}.preview-card article{max-width:650px;margin:12vh auto}.preview-card h1{font-size:42px}.preview-card #preview-body{font:18px/1.8 Georgia,serif}.preview-card pre{white-space:pre-wrap;background:#f7f7f7;padding:16px}.preview-card figure{margin:36px 0}.preview-card figure img{display:block;max-width:100%;height:auto}.preview-card figcaption{font-size:12px;color:#777;margin-top:8px}
</style>
</AdminLayout>
