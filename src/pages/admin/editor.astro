---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Editor — Back Mountain CMS">
<div id="editor" class="editor" hidden>
 <header class="bar"><div class="bar-left"><a href="/admin">← 文章</a><span id="post-state" class="post-state">草稿</span></div><div class="actions"><span id="save-state">已儲存</span><button id="preview" class="quiet">預覽</button><button id="publish" class="publish">發布</button></div></header>
 <main class="canvas">
  <div class="document-tools"><div class="modebar segmented" aria-label="編輯模式"><button id="plain-mode">純文字</button><button id="structured-mode" class="active">結構化</button></div></div>
  <input id="title" class="title" placeholder="中文標題" aria-label="中文標題">
  <input id="title-en" class="title title-en" placeholder="英文標題（選填）" aria-label="英文標題">
  <textarea id="plain-body" class="plain-body" rows="18" placeholder="輸入文章內文" hidden></textarea>
  <div id="structured-editor"><div id="blocks" class="blocks"></div>
  <div class="addbar"><button data-add="paragraph">+ 段落</button><button data-add="heading">標題</button><button data-add="quote">引言</button><button data-add="code">程式碼</button><button data-add="divider">分隔線</button><button data-add="image">圖片</button></div></div>
 </main>
 <button id="settings-toggle" class="settings-toggle" aria-label="文章設定" aria-controls="settings" aria-expanded="false">⚙</button>
 <aside id="settings" class="settings">
  <div class="settings-head"><strong>文章設定</strong></div>
  <section class="setting-group"><h3>基本資訊</h3><label>網址代稱<input id="slug"></label><label>摘要<textarea id="excerpt" rows="4"></textarea></label></section>
  <section class="setting-group"><h3>分類</h3><fieldset class="tag-field"><legend>標籤</legend><div id="tag-options">載入中…</div></fieldset></section>
  <section class="setting-group"><h3>呈現</h3><label class="check"><input id="featured" type="checkbox"> 設為精選文章 <small>僅限已發布</small></label><label>主視覺圖片<input id="feature-image-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif"></label><div id="feature-image-preview" class="feature-image-preview" hidden><img id="feature-image-img" alt=""><button id="remove-feature-image" type="button">移除主視覺圖片</button></div><label>主視覺替代文字<input id="feature-image-alt" placeholder="描述圖片內容"></label></section>
  <details class="setting-disclosure"><summary>英文資訊 <small>選填</small></summary><div class="setting-disclosure-body"><label>英文摘要<textarea id="excerpt-en" rows="3"></textarea></label><label>英文主視覺替代文字<input id="feature-image-alt-en"></label></div></details>
  <section class="setting-group lifecycle"><h3>文章操作</h3><button id="unpublish" class="lifecycle-action" hidden>取消發布</button><button id="archive-post" class="lifecycle-action" hidden>歸檔</button><button id="restore-post" class="lifecycle-action" hidden>取消歸檔</button><button id="delete-post" class="lifecycle-action danger" hidden>刪除</button></section>
 </aside>
</div>
<div id="preview-modal" class="modal" hidden><div class="preview-card"><button id="close-preview">關閉</button><article><h1 id="preview-title"></h1><div id="preview-body"></div></article></div></div>
<script>
 import { supabaseConfigured,getSupabaseClient } from '../../lib/supabase-client.js';
 const qs=s=>document.querySelector(s),id=new URLSearchParams(location.search).get('id'),root=qs('#editor'),blocksEl=qs('#blocks');let saveTimer=null,supabase,userRole='',postStatus='draft',originalSlug='',slugTouched=false,blocks=[],editorMode='structured',originalHtmlEn='',structuredSnapshot=null,plainInitial='';
 if(!supabaseConfigured||!id)location.href='/admin/login'; else{
  supabase=getSupabaseClient();const {data:{session}}=await supabase.auth.getSession();
  if(!session)location.href='/admin/login'; else{
   const {data:profile}=await supabase.from('profiles').select('role').eq('id',session.user.id).single();userRole=profile?.role||'';
   if(!['admin','editor'].includes(userRole)){await supabase.auth.signOut();location.href='/admin/login';}else{
    const {data:p,error}=await supabase.from('posts').select('*').eq('id',id).single();
    if(error||!p)location.href='/admin'; else{postStatus=p.status||'draft';originalSlug=p.slug||'';qs('#title').value=p.title||'';qs('#slug').value=originalSlug;qs('#excerpt').value=p.excerpt||'';qs('#title-en').value=p.title_en||'';qs('#excerpt-en').value=p.excerpt_en||'';originalHtmlEn=p.html_en||'';qs('#feature-image-alt-en').value=p.feature_image_alt_en||'';qs('#featured').checked=Boolean(p.featured);qs('#feature-image-alt').value=p.feature_image_alt||'';setFeature圖片(p.feature_image||'');blocks=readBlocks(p);renderBlocks();syncLifecycleButtons();await load標籤();root.hidden=false;}
   }
  }
 }
 ['#title','#title-en','#plain-body','#excerpt','#excerpt-en','#feature-image-alt-en','#featured','#feature-image-alt'].forEach(s=>qs(s)?.addEventListener('input',scheduleSave));
 qs('#title')?.addEventListener('input',()=>{if(postStatus==='draft'&&!slugTouched)qs('#slug').value=slugify(qs('#title').value)||originalSlug;});
 qs('#slug')?.addEventListener('input',()=>{slugTouched=true;scheduleSave();});qs('#tag-options')?.addEventListener('change',scheduleSave);
 qs('#settings-toggle')?.addEventListener('click',e=>{const open=qs('#settings').classList.toggle('open');e.currentTarget.setAttribute('aria-expanded',String(open));});qs('#plain-mode')?.addEventListener('click',()=>setMode('plain'));qs('#structured-mode')?.addEventListener('click',()=>setMode('structured'));
 qs('#feature-image-file')?.addEventListener('change',async e=>{const file=e.target.files?.[0];if(!file)return;const uploaded=await upload圖片(file,'feature');if(!uploaded)return;setFeature圖片(uploaded);scheduleSave();});
 qs('#remove-feature-image')?.addEventListener('click',()=>{setFeature圖片('');scheduleSave();});
 qs('#publish')?.addEventListener('click',async()=>{clearTimeout(saveTimer);const ok=await save('published');if(ok){qs('#save-state').textContent='已發布';syncLifecycleButtons();}});
 qs('#unpublish')?.addEventListener('click',async()=>{if(!confirm('確定將這篇文章改回草稿？'))return;clearTimeout(saveTimer);const ok=await save('draft');if(!ok)return;qs('#save-state').textContent='已改為草稿';syncLifecycleButtons();});
 qs('#archive-post')?.addEventListener('click',async()=>{if(!confirm('確定將這篇文章歸檔？已發布文章會從公開網站移除。'))return;clearTimeout(saveTimer);const ok=await save('archived');if(!ok)return;qs('#save-state').textContent='已歸檔';syncLifecycleButtons();});
 qs('#restore-post')?.addEventListener('click',async()=>{clearTimeout(saveTimer);const ok=await save('draft');if(!ok)return;qs('#save-state').textContent='已改為草稿';syncLifecycleButtons();});
 qs('#delete-post')?.addEventListener('click',async()=>{if(!confirm('確定永久刪除這篇文章？此動作無法復原。'))return;clearTimeout(saveTimer);qs('#save-state').textContent='刪除中…';const {error}=await supabase.from('posts').delete().eq('id',id);if(error){qs('#save-state').textContent='刪除失敗';return;}location.href='/admin';});
 qs('#preview')?.addEventListener('click',()=>{if(editorMode==='plain'){const plain=qs('#plain-body').value;blocks=structuredSnapshot&&plain===plainInitial?structuredSnapshot.map(b=>({...b})):mergePlainWithPreserved(plain);}else syncBlocks();qs('#preview-title').textContent=qs('#title').value||'未命名文章';qs('#preview-body').innerHTML=renderHtml(blocks);qs('#preview-modal').hidden=false;});
 qs('#close-preview')?.addEventListener('click',()=>qs('#preview-modal').hidden=true);
 qs('.addbar')?.addEventListener('click',e=>{const b=e.target.closest('[data-add]');if(!b)return;syncBlocks();blocks.push(b.dataset.add==='image'?{type:'image',url:'',alt:'',caption:''}:{type:b.dataset.add,text:''});renderBlocks();blocksEl.querySelector('.block:last-child textarea')?.focus();scheduleSave();});
 blocksEl?.addEventListener('input',scheduleSave);
 blocksEl?.addEventListener('change',async e=>{const input=e.target.closest('.image-file');if(!input?.files?.[0])return;const row=input.closest('.block'),i=Number(row.dataset.index),uploaded=await upload圖片(input.files[0]);if(!uploaded)return;syncBlocks();blocks[i]={...blocks[i],type:'image',url:uploaded};renderBlocks();scheduleSave();});
 blocksEl?.addEventListener('click',e=>{const row=e.target.closest('.block');if(!row)return;const i=Number(row.dataset.index);syncBlocks();if(e.target.closest('.remove'))blocks.splice(i,1);else if(e.target.closest('.up')&&i>0)[blocks[i-1],blocks[i]]=[blocks[i],blocks[i-1]];else if(e.target.closest('.down')&&i<blocks.length-1)[blocks[i+1],blocks[i]]=[blocks[i],blocks[i+1]];else return;renderBlocks();scheduleSave();});
 async function upload圖片(file,kind='blocks'){const allowed={'image/jpeg':'jpg','image/png':'png','image/webp':'webp','image/gif':'gif','image/avif':'avif'};const ext=allowed[file.type];if(!ext){qs('#save-state').textContent='僅支援 JPEG、PNG、WebP、GIF 或 AVIF 圖片';return null;}if(file.size>10*1024*1024){qs('#save-state').textContent='圖片大小不可超過 10 MB';return null;}qs('#save-state').textContent='圖片上傳中…';const path=`posts/${id}/${kind}-${crypto.randomUUID()}.${ext}`;const {error}=await supabase.storage.from('cms-media').upload(path,file,{contentType:file.type,upsert:false});if(error){qs('#save-state').textContent='圖片上傳失敗';return null;}return supabase.storage.from('cms-media').getPublicUrl(path).data.publicUrl;}
 function setFeature圖片(url){const preview=qs('#feature-image-preview'),img=qs('#feature-image-img');img.dataset.url=url||'';img.src=url||'';preview.hidden=!url;}
 function syncLifecycleButtons(){const published=postStatus==='published',archived=postStatus==='archived',featured=qs('#featured');qs('#post-state').textContent=published?'已發布':archived?'已歸檔':'草稿';qs('#post-state').className='post-state '+postStatus;qs('#publish').textContent=published?'重新發布':'發布';qs('#unpublish').hidden=!published;qs('#archive-post').hidden=archived;qs('#restore-post').hidden=!archived;qs('#delete-post').hidden=userRole!=='admin';if(featured){featured.disabled=!published;if(!published)featured.checked=false;featured.title=published?'':'僅已發布文章可設為精選';}}
 function scheduleSave(){qs('#save-state').textContent='尚未儲存';clearTimeout(saveTimer);saveTimer=setTimeout(()=>save(),700);}
 function syncBlocks(){blocks=[...blocksEl.querySelectorAll('.block')].map(row=>row.dataset.type==='image'?{type:'image',url:row.querySelector('.image-url')?.value||'',alt:row.querySelector('.image-alt')?.value||'',caption:row.querySelector('.image-caption')?.value||''}:{type:row.dataset.type,text:row.querySelector('textarea')?.value||''});}
 async function save(status){if(!supabase)return false;if(editorMode==='plain'){const plain=qs('#plain-body').value;blocks=structuredSnapshot&&plain===plainInitial?structuredSnapshot.map(b=>({...b})):mergePlainWithPreserved(plain);}else syncBlocks();qs('#save-state').textContent='正在儲存…';const requested=slugify(qs('#slug').value||qs('#title').value)||('draft-'+id),slug=postStatus==='published'&&status!=='published'?originalSlug:requested;const targetStatus=status||postStatus;const data={title:qs('#title').value.trim(),slug,excerpt:qs('#excerpt').value.trim(),featured:targetStatus==='published'&&qs('#featured').checked,feature_image:qs('#feature-image-img')?.dataset.url||null,feature_image_alt:qs('#feature-image-alt').value.trim(),title_en:qs('#title-en').value.trim()||null,excerpt_en:qs('#excerpt-en').value.trim()||null,html_en:originalHtmlEn||null,feature_image_alt_en:qs('#feature-image-alt-en').value.trim()||null,content:{version:2,blocks},html:renderHtml(blocks),updated_at:new Date().toISOString()};if(status==='published'){data.status='published';data.published_at=new Date().toISOString();}else if(status==='draft'||status==='archived'){data.status=status;}const {error}=await supabase.from('posts').update(data).eq('id',id);if(error){qs('#save-state').textContent=error.code==='23505'?'儲存失敗：此網址代稱已被使用':'儲存失敗';return false;}const tagIds=[...document.querySelectorAll('#tag-options input:checked')].map(x=>x.value);const {error:tagError}=await supabase.from('post_tags').delete().eq('post_id',id);if(!tagError&&tagIds.length){const {error:e}=await supabase.from('post_tags').insert(tagIds.map(tag_id=>({post_id:id,tag_id})));if(e){qs('#save-state').textContent='儲存失敗：標籤更新失敗';return false;}}else if(tagError){qs('#save-state').textContent='儲存失敗：標籤更新失敗';return false;}if(status){postStatus=status;if(status==='published')originalSlug=data.slug;else qs('#featured').checked=false;syncLifecycleButtons();}qs('#slug').value=data.slug;qs('#save-state').textContent='已儲存';return true;}
 function setMode(mode){if(mode===editorMode)return;if(mode==='plain'){syncBlocks();structuredSnapshot=blocks.map(b=>({...b}));plainInitial=blocksToPlain(blocks);qs('#plain-body').value=plainInitial;}else{const plain=qs('#plain-body').value;if(structuredSnapshot&&plain===plainInitial){blocks=structuredSnapshot.map(b=>({...b}));}else{blocks=mergePlainWithPreserved(plain);}renderBlocks();structuredSnapshot=null;plainInitial='';}editorMode=mode;qs('#plain-body').hidden=mode!=='plain';qs('#structured-editor').hidden=mode==='plain';qs('#plain-mode').classList.toggle('active',mode==='plain');qs('#structured-mode').classList.toggle('active',mode==='structured');}
 function blocksToPlain(items){return items.map(b=>b.type==='divider'?'---':b.type==='image'?(b.caption||b.alt||''):b.text||'').filter(Boolean).join('\n\n');}
 function mergePlainWithPreserved(text){const preserved=(structuredSnapshot||[]).filter(b=>b.type==='image'||b.type==='divider').map(b=>({...b}));return [...plainToBlocks(text),...preserved];}
 function plainToBlocks(text){const parts=String(text||'').split(/\n\s*\n/).map(x=>x.trim()).filter(Boolean);return (parts.length?parts:['']).map(text=>({type:'paragraph',text}));}
 function readBlocks(p){if(Array.isArray(p.content?.blocks)&&p.content.blocks.length)return p.content.blocks.map(b=>b.type==='image'?{type:'image',url:String(b.url||''),alt:String(b.alt||''),caption:String(b.caption||'')}:{type:['paragraph','heading','quote','code','divider'].includes(b.type)?b.type:'paragraph',text:String(b.text||'')});const text=String(p.html||'').replace(/<\/p>/gi,'\n\n').replace(/<br\s*\/?>/gi,'\n').replace(/<[^>]*>/g,'').trim();return text?[{type:'paragraph',text}]:[{type:'paragraph',text:''}];}
 function renderBlocks(){blocksEl.innerHTML=blocks.map((b,i)=>`<section class="block" data-index="${i}" data-type="${b.type}"><div class="block-label">${label(b.type)}</div><div class="block-row"><div class="block-content">${b.type==='divider'?'<hr>':b.type==='image'?`<div class="image-editor">${b.url?`<img src="${escapeAttr(b.url)}" alt="${escapeAttr(b.alt)}">`:''}<input class="image-file" type="file" accept="image/*"><input class="image-url" type="hidden" value="${escapeAttr(b.url)}"><input class="image-alt" value="${escapeAttr(b.alt)}" placeholder="圖片替代文字"><input class="image-caption" value="${escapeAttr(b.caption)}" placeholder="圖片說明（選填）"></div>`:`<textarea rows="${b.type==='code'?5:3}" placeholder="${label(b.type)}">${escapeHtml(b.text)}</textarea>`}</div><div class="block-actions"><button class="up" title="上移" aria-label="上移">↑</button><button class="down" title="下移" aria-label="下移">↓</button><button class="remove" title="移除" aria-label="移除">×</button></div></div></section>`).join('');}
 function renderHtml(items){return items.map(b=>{const t=escapeHtml(b.text).replace(/\n/g,'<br>');if(b.type==='heading')return '<h2>'+t+'</h2>';if(b.type==='quote')return '<blockquote>'+t+'</blockquote>';if(b.type==='code')return '<pre><code>'+escapeHtml(b.text)+'</code></pre>';if(b.type==='divider')return '<hr>';if(b.type==='image'){if(!b.url)return '';const caption=b.caption?'<figcaption>'+escapeHtml(b.caption)+'</figcaption>':'';return '<figure><img src="'+escapeAttr(b.url)+'" alt="'+escapeAttr(b.alt||'')+'" loading="lazy">'+caption+'</figure>';}return '<p>'+t+'</p>';}).join('');}
 async function load標籤(){const [{data:tags,error},{data:links}]=await Promise.all([supabase.from('tags').select('id,name').order('name'),supabase.from('post_tags').select('tag_id').eq('post_id',id)]);const box=qs('#tag-options');if(error){box.textContent='標籤載入失敗';return;}const selected=new Set((links||[]).map(x=>x.tag_id));box.innerHTML=(tags||[]).length?(tags||[]).map(t=>`<label class="tag-option"><input type="checkbox" value="${t.id}" ${selected.has(t.id)?'checked':''}> ${escapeHtml(t.name)}</label>`).join(''):'<span class="hint">請先到「標籤」頁建立標籤。</span>';}
 function label(t){return ({paragraph:'段落',heading:'標題',quote:'引言',code:'程式碼',divider:'分隔線',image:'圖片'})[t]||'段落';}
 function slugify(v){return String(v).toLowerCase().trim().normalize('NFKD').replace(/[^\p{Letter}\p{Number}]+/gu,'-').replace(/^-|-$/g,'');}
 function escapeHtml(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));}
 function escapeAttr(v){return escapeHtml(v);}
</script>
<style is:global>
.editor{min-height:100vh;background:var(--admin-bg)}
.bar{height:56px;position:sticky;top:0;z-index:8;background:rgba(255,255,255,.97);border-bottom:1px solid var(--admin-line);display:flex;align-items:center;justify-content:space-between;padding:0 20px}
.bar-left,.actions{display:flex;align-items:center;gap:8px}.bar-left a{color:var(--admin-secondary);text-decoration:none;font-size:12px}.bar-left a:hover{color:var(--admin-ink)}.post-state{display:inline-flex;align-items:center;gap:5px;font-size:10px;color:var(--admin-secondary);padding:3px 7px;border:1px solid var(--admin-line);border-radius:999px;background:var(--admin-subtle)}.post-state.published{color:var(--admin-success)}.post-state.archived{color:#777}
.actions span{font-size:11px;color:var(--admin-muted);margin-right:4px}.actions button{border:0;background:transparent;padding:7px 9px;border-radius:var(--control-radius);cursor:pointer;font-size:11px;color:var(--admin-secondary)}.actions .quiet:hover{background:var(--admin-subtle);color:var(--admin-ink)}.actions .publish{background:var(--admin-ink);color:#fff;padding-inline:13px}
.canvas{width:min(940px,calc(100% - 500px));margin:0 356px 0 120px;padding:32px 46px 96px;min-height:calc(100vh - 56px);background:var(--admin-panel)}
.document-tools{display:flex;justify-content:flex-end;margin-bottom:28px}.modebar{flex:none}
.title{display:block;width:100%;border:0!important;font-size:38px;line-height:1.18;font-weight:650;letter-spacing:-.025em;padding:0;margin:0 0 14px;background:transparent!important}.title-en{font-size:19px;font-weight:450;letter-spacing:-.01em;color:var(--admin-secondary);margin-bottom:36px}
.plain-body{display:block;width:100%;min-height:52vh;border:0!important;resize:vertical;font:18px/1.8 Georgia,"Noto Serif TC",serif;padding:0;background:transparent}.plain-body[hidden]{display:none}
.blocks{display:grid;gap:6px}.block{position:relative;border:1px solid transparent;border-radius:var(--control-radius);padding:7px 8px 9px;overflow:visible}.block:focus-within,.block:hover{border-color:var(--admin-line)}.block:focus-within{box-shadow:0 0 0 1px var(--admin-line)}.block-label{min-height:20px;display:flex;align-items:center;font-size:10px;color:var(--admin-muted)}.block-row{position:relative;display:block}.block-content{width:100%;min-width:0}.block-actions{position:absolute;left:calc(100% + 6px);top:2px;width:24px;display:flex;flex-direction:column;align-items:center;gap:1px;opacity:.35;transition:opacity .12s}.block:hover .block-actions,.block:focus-within .block-actions{opacity:1}.block-actions button{width:24px;height:24px;border:0;border-radius:3px;background:none;color:var(--admin-muted);cursor:pointer;padding:0}.block-actions button:hover,.block-actions button:focus-visible{color:var(--admin-ink);background:var(--admin-subtle)}.block textarea{display:block;width:100%;min-width:0;border:0!important;resize:vertical;padding:5px 0;font:18px/1.72 Georgia,"Noto Serif TC",serif;background:transparent}.block[data-type="heading"] textarea{font-size:26px;line-height:1.35;font-weight:600}.block[data-type="quote"] textarea{border-left:2px solid var(--admin-ink)!important;padding-left:16px;font-style:italic}.block[data-type="code"] textarea{font:13px/1.6 monospace;background:var(--admin-subtle)!important;padding:12px}.block hr{border:0;border-top:1px solid #bbb;margin:22px 0}
.image-editor{display:grid;gap:8px;padding:8px 0}.image-editor img{display:block;max-width:100%;max-height:400px;object-fit:contain;background:var(--admin-subtle)}.image-editor input:not([type=file]){padding:8px}.image-editor .image-file{font-size:11px}
.addbar{position:fixed;left:18px;top:92px;width:88px;display:flex;flex-direction:column;gap:3px;padding:8px;background:rgba(250,250,248,.96);border:1px solid var(--admin-line);border-radius:var(--panel-radius);z-index:7}.addbar button{width:100%;border:0;border-radius:var(--control-radius);background:transparent;padding:8px 9px;text-align:left;font-size:11px;color:var(--admin-secondary);cursor:pointer}.addbar button:hover,.addbar button:focus-visible{background:var(--admin-panel);color:var(--admin-ink)}
.settings{position:fixed;right:0;top:56px;bottom:0;width:324px;background:var(--admin-subtle);border-left:1px solid var(--admin-line);padding:22px 20px;overflow:auto}.settings-head{padding-bottom:16px}.settings-head strong{font-size:13px;font-weight:650}.setting-group{border-top:1px solid var(--admin-line);padding:16px 0 2px}.setting-group h3{font-size:12px;font-weight:600;margin:0 0 13px;color:var(--admin-ink)}.settings label{display:grid;gap:6px;font-size:11px;color:var(--admin-secondary);margin:0 0 14px}.settings input,.settings textarea{width:100%;padding:8px 9px;font-size:12px}.settings .check{display:flex;align-items:center;gap:8px}.settings .check input{width:auto}.settings .check small{margin-left:auto;color:var(--admin-muted);font-size:10px}.tag-field{border:0;padding:0;margin:0}.tag-field legend{display:none}.tag-option{display:flex!important;align-items:center;gap:7px!important;margin:7px 0!important}.tag-option input{width:auto}.hint{font-size:11px;line-height:1.5;color:var(--admin-muted)}.setting-disclosure{border-top:1px solid var(--admin-line);padding:14px 0}.setting-disclosure summary{cursor:pointer;font-size:12px;font-weight:600;color:var(--admin-ink);list-style:none}.setting-disclosure summary::-webkit-details-marker{display:none}.setting-disclosure summary::after{content:'＋';float:right;color:var(--admin-muted);font-weight:400}.setting-disclosure[open] summary::after{content:'−'}.setting-disclosure summary small{font-weight:400;color:var(--admin-muted)}.setting-disclosure-body{padding-top:14px}.lifecycle{padding-bottom:12px}.lifecycle-action{display:block;width:100%;text-align:left;border:0;background:transparent;border-radius:var(--control-radius);padding:8px 6px;color:var(--admin-secondary);font-size:11px;cursor:pointer}.lifecycle-action:hover{background:var(--admin-panel);color:var(--admin-ink)}.lifecycle-action.danger{color:var(--admin-danger)}
