---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="文章 — Field Notes CMS">
<div class="cms" id="cms" hidden><aside class="side"><div class="cms-brand">FIELD NOTES</div><a class="view" href="/" target="_blank">查看網站 ↗</a><nav><a href="/admin" class="active">文章</a><a href="/admin/tags">標籤</a><a href="/admin/content">網站內容</a></nav><div class="side-foot"><button id="sign-out" class="btn secondary">登出</button></div></aside><main class="main"><header class="top"><div><h1>文章</h1><p class="muted">集中管理草稿與已發布文章。</p></div><button id="new-post" class="btn">新增文章</button></header><div class="filters"><button data-filter="all" class="on">全部</button><button data-filter="draft">草稿</button><button data-filter="published">已發布</button><input id="search" type="search" placeholder="搜尋中英文標題"></div><div id="posts" class="posts"><p class="muted">載入中…</p></div></main></div>
<script>
 import {supabaseConfigured,getSupabaseClient} from '../../lib/supabase-client.js';
 const cms=document.querySelector('#cms'),list=document.querySelector('#posts'),search=document.querySelector('#search');let allPosts=[],filter='all',user;
 if(!supabaseConfigured)location.href='/admin/login';else{const supabase=getSupabaseClient();const {data:{session}}=await supabase.auth.getSession();user=session?.user;if(!user)location.href='/admin/login';else{const {data:profile}=await supabase.from('profiles').select('role').eq('id',user.id).single();if(!['admin','editor'].includes(profile?.role)){await supabase.auth.signOut();location.href='/admin/login';}else{cms.hidden=false;await load();}}async function load(){const {data,error}=await supabase.from('posts').select('id,title,title_en,status,created_at,published_at').order('created_at',{ascending:false});if(error){list.innerHTML='<p class="muted">'+esc(error.message)+'</p>';return;}allPosts=data||[];render();}document.querySelector('#sign-out')?.addEventListener('click',async()=>{await supabase.auth.signOut();location.href='/admin/login';});document.querySelector('#new-post')?.addEventListener('click',async()=>{const slug='draft-'+crypto.randomUUID();const {data,error}=await supabase.from('posts').insert({author_id:user.id,slug}).select('id').single();if(error){alert(error.message);return;}location.href='/admin/editor?id='+encodeURIComponent(data.id);});}
 document.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>{filter=b.dataset.filter;document.querySelectorAll('[data-filter]').forEach(x=>x.classList.toggle('on',x===b));render();}));search?.addEventListener('input',render);list?.addEventListener('click',e=>{const row=e.target.closest('tr[data-href]');if(row&&!e.target.closest('a'))location.href=row.dataset.href;});
 function render(){const term=(search?.value||'').toLowerCase();const rows=allPosts.filter(p=>(filter==='all'||p.status===filter)&&((p.title||'').toLowerCase().includes(term)||(p.title_en||'').toLowerCase().includes(term)));list.innerHTML=rows.length?'<div class="table-wrap"><table><thead><tr><th>中文標題</th><th>英文標題</th><th>初次建立日期</th><th>發布日期</th><th>發布狀態</th></tr></thead><tbody>'+rows.map(p=>'<tr data-href="/admin/editor?id='+encodeURIComponent(p.id)+'"><td><a href="/admin/editor?id='+encodeURIComponent(p.id)+'">'+esc(p.title||'未命名文章')+'</a></td><td>'+esc(p.title_en||'—')+'</td><td>'+date(p.created_at)+'</td><td>'+date(p.published_at)+'</td><td><span class="status '+p.status+'">'+(p.status==='published'?'已發布':'草稿')+'</span></td></tr>').join('')+'</tbody></table></div>':'<p class="muted empty">目前沒有文章。</p>';}
 function date(v){return v?new Date(v).toLocaleDateString('zh-TW',{year:'numeric',month:'2-digit',day:'2-digit'}):'—';}function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));}
</script>
<style>.filters{display:flex;gap:20px;align-items:center;border-bottom:1px solid var(--line);padding-bottom:14px}.filters button{border:0;background:none;padding:5px 0;color:#888;cursor:pointer}.filters button.on{color:#111}.filters input{margin-left:auto;border:0;border-bottom:1px solid var(--line);background:transparent;padding:8px;width:240px}.posts{background:#fff}.table-wrap{width:100%;overflow-x:auto}table{width:100%;border-collapse:collapse;table-layout:fixed}th,td{text-align:left;border-bottom:1px solid var(--line);padding:14px 12px;vertical-align:middle}th{font-size:11px;color:#777;font-weight:500;background:#fafafa}th:nth-child(1),th:nth-child(2){width:28%}th:nth-child(3),th:nth-child(4){width:15%}th:nth-child(5){width:14%}td{font-size:13px}td a{font-weight:600;color:inherit;text-decoration:none}td a:hover{text-decoration:underline}.status{display:inline-block;font-size:11px;padding:4px 7px;border:1px solid var(--line);border-radius:3px}.status.published{background:#f1f6f1}.empty{padding:20px}@media(max-width:900px){table{min-width:760px}.filters{flex-wrap:wrap}.filters input{width:100%;margin-left:0}}</style>
</AdminLayout>