---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="文章 — Field Notes CMS">
<div class="cms" id="cms" hidden><aside class="side"><div class="cms-brand">FIELD NOTES</div><a class="view" href="/" target="_blank">查看網站 ↗</a><nav><a href="/admin" class="active">文章</a><a href="/admin/tags">標籤</a><a href="/admin/content">網站內容</a></nav><div class="side-foot"><button id="sign-out" class="btn secondary">登出</button></div></aside><main class="main"><header class="top"><div><span class="section-kicker">內容管理</span><h1>文章</h1><p class="muted">集中管理草稿與已發布文章</p></div><button id="new-post" class="btn">＋ 新增文章</button></header><section class="list-panel"><div class="filters"><button data-filter="all" class="on">全部</button><button data-filter="draft">草稿</button><button data-filter="published">已發布</button><input id="search" type="search" placeholder="搜尋中英文標題"></div><div id="posts" class="posts"><p class="muted">載入中…</p></div></section></main></div>
<script>
 import {supabaseConfigured,getSupabaseClient} from '../../lib/supabase-client.js';
 const cms=document.querySelector('#cms'),list=document.querySelector('#posts'),search=document.querySelector('#search');let allPosts=[],filter='all',user;
 if(!supabaseConfigured)location.href='/admin/login';else{const supabase=getSupabaseClient();const {data:{session}}=await supabase.auth.getSession();user=session?.user;if(!user)location.href='/admin/login';else{const {data:profile}=await supabase.from('profiles').select('role').eq('id',user.id).single();if(!['admin','editor'].includes(profile?.role)){await supabase.auth.signOut();location.href='/admin/login';}else{cms.hidden=false;await load();}}async function load(){const {data,error}=await supabase.from('posts').select('id,title,title_en,status,created_at,published_at').order('created_at',{ascending:false});if(error){list.innerHTML='<p class="muted">'+esc(error.message)+'</p>';return;}allPosts=data||[];render();}document.querySelector('#sign-out')?.addEventListener('click',async()=>{await supabase.auth.signOut();location.href='/admin/login';});document.querySelector('#new-post')?.addEventListener('click',async()=>{const slug='draft-'+crypto.randomUUID();const {data,error}=await supabase.from('posts').insert({author_id:user.id,slug}).select('id').single();if(error){alert(error.message);return;}location.href='/admin/editor?id='+encodeURIComponent(data.id);});}
 document.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>{filter=b.dataset.filter;document.querySelectorAll('[data-filter]').forEach(x=>x.classList.toggle('on',x===b));render();}));search?.addEventListener('input',render);list?.addEventListener('click',e=>{const row=e.target.closest('tr[data-href]');if(row&&!e.target.closest('a'))location.href=row.dataset.href;});
 function render(){const term=(search?.value||'').toLowerCase();const rows=allPosts.filter(p=>(filter==='all'||p.status===filter)&&((p.title||'').toLowerCase().includes(term)||(p.title_en||'').toLowerCase().includes(term)));list.innerHTML=rows.length?'<div class="table-wrap"><table><thead><tr><th>文章</th><th>英文標題</th><th>建立</th><th>發布</th><th>狀態</th><th></th></tr></thead><tbody>'+rows.map(p=>'<tr data-href="/admin/editor?id='+encodeURIComponent(p.id)+'"><td class="title-cell"><a href="/admin/editor?id='+encodeURIComponent(p.id)+'">'+esc(p.title||'未命名文章')+'</a></td><td class="en-cell">'+esc(p.title_en||'—')+'</td><td class="date-cell">'+date(p.created_at)+'</td><td class="date-cell">'+date(p.published_at)+'</td><td><span class="status '+p.status+'"><i></i>'+(p.status==='published'?'已發布':'草稿')+'</span></td><td class="arrow">→</td></tr>').join('')+'</tbody></table></div>':'<p class="muted empty">目前沒有文章。</p>';}
 function date(v){return v?new Date(v).toLocaleDateString('zh-TW',{year:'numeric',month:'2-digit',day:'2-digit'}):'—';}function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));}
</script>
<style>
.section-kicker{display:block;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#999;margin-bottom:8px}.top{margin-bottom:28px}.top h1{font-size:32px;letter-spacing:-.03em}.top .muted{margin:7px 0 0;font-size:12px}.list-panel{background:#fff;border:1px solid var(--line);border-radius:7px;overflow:hidden}.filters{height:56px;display:flex;gap:4px;align-items:center;padding:0 16px;border-bottom:1px solid var(--line)}.filters button{border:0;border-radius:4px;background:none;padding:7px 10px;color:#888;cursor:pointer;font-size:11px}.filters button.on{color:#111;background:#f0f0ee;font-weight:600}.filters input{margin-left:auto;border:1px solid #ddd;border-radius:5px;background:#fff;padding:8px 10px;width:230px;font-size:11px;outline:0}.filters input:focus{border-color:#999}.posts{background:#fff}.table-wrap{width:100%;overflow-x:auto}table{width:100%;border-collapse:collapse;table-layout:fixed}th,td{text-align:left;border-bottom:1px solid #ededeb;padding:0 16px;vertical-align:middle}th{height:38px;font-size:9px;letter-spacing:.06em;text-transform:uppercase;color:#999;font-weight:600;background:#fafaf9}td{height:62px;font-size:12px}th:nth-child(1){width:30%}th:nth-child(2){width:25%}th:nth-child(3),th:nth-child(4){width:13%}th:nth-child(5){width:13%}th:nth-child(6){width:6%}tbody tr{cursor:pointer;transition:background .12s}tbody tr:hover{background:#fafaf8}.title-cell a{display:block;font-weight:650;color:#171717;text-decoration:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.en-cell{color:#777;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.date-cell{font-variant-numeric:tabular-nums;color:#777}.status{display:inline-flex;align-items:center;gap:6px;font-size:10px;color:#666;white-space:nowrap}.status i{width:6px;height:6px;border-radius:50%;background:#bbb}.status.published{color:#355f3b}.status.published i{background:#5f8b64}.arrow{text-align:right;color:#aaa;font-size:15px}.empty{padding:36px 20px;text-align:center;font-size:12px}tbody tr:last-child td{border-bottom:0}
@media(max-width:900px){table{min-width:780px}.filters{flex-wrap:wrap;height:auto;padding:12px}.filters input{width:100%;margin-left:0}.list-panel{border-radius:0}.top{align-items:flex-end}}
</style>
</AdminLayout>