---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="文章 — Field Notes CMS">
<div class="cms" id="cms" hidden><aside class="side"><div class="cms-brand">FIELD NOTES</div><a class="view" href="/" target="_blank">查看網站 ↗</a><nav><a href="/admin" class="active">文章</a><a href="/admin/tags">標籤</a><a href="/admin/content">網站內容</a></nav><div class="side-foot"><button id="sign-out" class="btn secondary">登出</button></div></aside><main class="main"><header class="top"><div><span class="section-kicker">內容管理</span><h1>文章</h1><p class="muted">集中管理草稿與已發布文章</p></div><button id="new-post" class="btn">＋ 新增文章</button></header><section class="list-panel"><div class="filters"><div class="segmented"><button data-filter="all" class="on">全部</button><button data-filter="draft">草稿</button><button data-filter="published">已發布</button></div><input id="search" type="search" placeholder="搜尋中英文標題"></div><div id="posts" class="posts"><p class="empty-state">載入中…</p></div></section></main></div>
<script>
 import {supabaseConfigured,getSupabaseClient} from '../../lib/supabase-client.js';
 const cms=document.querySelector('#cms'),list=document.querySelector('#posts'),search=document.querySelector('#search');let allPosts=[],filter='all',user;
 if(!supabaseConfigured)location.href='/admin/login';else{const supabase=getSupabaseClient();const {data:{session}}=await supabase.auth.getSession();user=session?.user;if(!user)location.href='/admin/login';else{const {data:profile}=await supabase.from('profiles').select('role').eq('id',user.id).single();if(!['admin','editor'].includes(profile?.role)){await supabase.auth.signOut();location.href='/admin/login';}else{cms.hidden=false;await load();}}async function load(){const {data,error}=await supabase.from('posts').select('id,title,title_en,status,created_at,published_at,updated_at,tags(name)').order('created_at',{ascending:false});if(error){list.innerHTML='<p class="empty-state">文章載入失敗，請稍後再試。</p>';return;}allPosts=data||[];render();}document.querySelector('#sign-out')?.addEventListener('click',async()=>{await supabase.auth.signOut();location.href='/admin/login';});document.querySelector('#new-post')?.addEventListener('click',async()=>{const slug='draft-'+crypto.randomUUID();const {data,error}=await supabase.from('posts').insert({author_id:user.id,slug}).select('id').single();if(error){alert('無法建立文章，請稍後再試。');return;}location.href='/admin/editor?id='+encodeURIComponent(data.id);});}
 document.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>{filter=b.dataset.filter;document.querySelectorAll('[data-filter]').forEach(x=>x.classList.toggle('on',x===b));render();}));search?.addEventListener('input',render);list?.addEventListener('click',e=>{const row=e.target.closest('tr[data-href]');if(row&&!e.target.closest('a'))location.href=row.dataset.href;});list?.addEventListener('keydown',e=>{const row=e.target.closest('tr[data-href]');if(row&&(e.key==='Enter'||e.key===' ')){e.preventDefault();location.href=row.dataset.href;}});
 function render(){const term=(search?.value||'').toLowerCase();const rows=allPosts.filter(p=>(filter==='all'||p.status===filter)&&((p.title||'').toLowerCase().includes(term)||(p.title_en||'').toLowerCase().includes(term)));list.innerHTML=rows.length?'<div class="table-wrap"><table><thead><tr><th>文章</th><th>狀態</th><th>標籤</th><th>最近更新</th><th></th></tr></thead><tbody>'+rows.map(p=>'<tr tabindex="0" role="link" data-href="/admin/editor?id='+encodeURIComponent(p.id)+'"><td class="title-cell"><a href="/admin/editor?id='+encodeURIComponent(p.id)+'">'+esc(p.title||'未命名文章')+'</a>'+(p.title_en?'<span>'+esc(p.title_en)+'</span>':'')+'</td><td><span class="status '+p.status+'"><i></i>'+(p.status==='published'?'已發布':'草稿')+'</span></td><td class="tag-cell">'+esc((p.tags||[]).map(t=>t.name).join('、')||'—')+'</td><td class="date-cell">'+date(p.updated_at||p.created_at)+'</td><td class="arrow">→</td></tr>').join('')+'</tbody></table></div>':'<p class="empty-state">目前沒有文章。</p>';}
 function date(v){return v?new Date(v).toLocaleDateString('zh-TW',{year:'numeric',month:'2-digit',day:'2-digit'}):'—';}function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));}
</script>
<style>
.top{margin-bottom:28px}.list-panel{background:#fff;border:1px solid var(--line);border-radius:var(--panel-radius);overflow:hidden}.filters{min-height:52px;display:flex;gap:4px;align-items:center;padding:10px 14px;border-bottom:1px solid var(--line)}.filters .segmented button.on{background:var(--admin-panel);color:var(--admin-ink);font-weight:600}.filters input{margin-left:auto;padding:8px 10px;width:230px;font-size:11px}.posts{background:#fff}.table-wrap{width:100%;overflow-x:auto}table{width:100%;border-collapse:collapse;table-layout:fixed}th,td{text-align:left;border-bottom:1px solid #ededeb;padding:0 16px;vertical-align:middle}th{height:38px;font-size:10px;color:#999;font-weight:600;background:#fafaf8}td{height:66px;font-size:12px}th:nth-child(1){width:42%}th:nth-child(2){width:13%}th:nth-child(3){width:22%}th:nth-child(4){width:17%}th:nth-child(5){width:6%}tbody tr{cursor:pointer}tbody tr:hover,tbody tr:focus-visible{background:#fafaf8}tbody tr:last-child td{border-bottom:0}.title-cell a{display:block;font-weight:650;color:#171717;text-decoration:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.title-cell span{display:block;color:#999;font-size:11px;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.tag-cell,.date-cell{color:#777}.date-cell{font-variant-numeric:tabular-nums}.status{display:inline-flex;align-items:center;gap:6px;font-size:10px;color:#666;white-space:nowrap}.status i{width:6px;height:6px;border-radius:50%;background:#aaa}.status.published{color:var(--admin-success)}.status.published i{background:var(--admin-success)}.arrow{text-align:right;color:#aaa;font-size:15px}
@media(max-width:900px){th:nth-child(3),td:nth-child(3){display:none}th:nth-child(1){width:55%}th:nth-child(2){width:18%}th:nth-child(4){width:21%}th:nth-child(5){width:6%}.filters{flex-wrap:wrap}.filters input{width:100%;margin-left:0}}@media(max-width:600px){th:nth-child(4),td:nth-child(4){display:none}th:nth-child(1){width:70%}th:nth-child(2){width:24%}th:nth-child(5){width:6%}th,td{padding-inline:12px}td{height:60px}}
</style>
</AdminLayout>