---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Posts — Field Notes CMS">
<div class="cms" id="cms" hidden><aside class="side"><div class="cms-brand">FIELD NOTES</div><a class="view" href="/" target="_blank">View site ↗</a><nav><a href="/admin" class="active">Posts</a><a href="/admin/tags">Tags</a><a href="/admin/settings">Settings</a></nav><div class="side-foot"><button id="sign-out" class="btn secondary">Sign out</button></div></aside><main class="main"><header class="top"><div><h1>Posts</h1><p class="muted">Your publication, in one place.</p></div><button id="new-post" class="btn">New post</button></header><div class="filters"><button data-filter="all" class="on">All</button><button data-filter="draft">Drafts</button><button data-filter="published">Published</button><input id="search" type="search" placeholder="Search posts"></div><div id="posts" class="posts"><p class="muted">Loading…</p></div></main></div>
<script>
 import { supabaseConfigured,getSupabaseClient } from '../../lib/supabase-client.js';
 const cms=document.querySelector('#cms'),list=document.querySelector('#posts'),search=document.querySelector('#search');let allPosts=[],filter='all',user;
 if(!supabaseConfigured)location.href='/admin/login';
 else{
  const supabase=getSupabaseClient(); const {data:{session}}=await supabase.auth.getSession(); user=session?.user;
  if(!user)location.href='/admin/login';
  else{
   const {data:profile}=await supabase.from('profiles').select('role').eq('id',user.id).single();
   if(!['admin','editor'].includes(profile?.role)){await supabase.auth.signOut();location.href='/admin/login';}
   else{cms.hidden=false;await load();}
  }
  async function load(){const {data,error}=await supabase.from('posts').select('id,title,status,updated_at').order('updated_at',{ascending:false});if(error){list.innerHTML='<p class="muted">'+escapeHtml(error.message)+'</p>';return;}allPosts=data||[];render();}
  document.querySelector('#sign-out')?.addEventListener('click',async()=>{await supabase.auth.signOut();location.href='/admin/login';});
  document.querySelector('#new-post')?.addEventListener('click',async()=>{const slug='draft-'+crypto.randomUUID();const {data,error}=await supabase.from('posts').insert({author_id:user.id,slug}).select('id').single();if(error){alert(error.message);return;}location.href='/admin/editor?id='+encodeURIComponent(data.id);});
 }
 document.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>{filter=b.dataset.filter;document.querySelectorAll('[data-filter]').forEach(x=>x.classList.toggle('on',x===b));render()}));search?.addEventListener('input',render);
 function render(){const term=(search?.value||'').toLowerCase();const rows=allPosts.filter(p=>(filter==='all'||p.status===filter)&&String(p.title||'Untitled').toLowerCase().includes(term));list.innerHTML=rows.length?rows.map(p=>`<a class="row" href="/admin/editor?id=${encodeURIComponent(p.id)}"><div><strong>${escapeHtml(p.title||'Untitled')}</strong><span>${p.status||'draft'}</span></div><time>${p.updated_at?new Date(p.updated_at).toLocaleDateString():'—'}</time></a>`).join(''):'<p class="muted">No posts yet.</p>';}
 function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));}
</script>
<style>
.filters{display:flex;gap:20px;align-items:center;border-bottom:1px solid var(--line);padding-bottom:14px}.filters button{border:0;background:none;padding:5px 0;color:#888;cursor:pointer}.filters button.on{color:#111}.filters input{margin-left:auto;border:0;border-bottom:1px solid var(--line);background:transparent;padding:8px;width:220px}.posts{background:#fff}.row{display:flex;justify-content:space-between;align-items:center;padding:20px 18px;border-bottom:1px solid var(--line);text-decoration:none;color:inherit}.row:hover{background:#fafafa}.row strong{font-size:15px;font-weight:550}.row span{display:block;color:#888;text-transform:capitalize;font-size:12px;margin-top:6px}.row time{font-size:12px;color:#888}
</style>
</AdminLayout>
