---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="網站內容 — Field Notes CMS"><div class="cms" id="cms" hidden><aside class="side"><div class="cms-brand">FIELD NOTES</div><a class="view" href="/" target="_blank">查看網站 ↗</a><nav><a href="/admin">文章</a><a href="/admin/tags">標籤</a><a href="/admin/content" class="active">網站內容</a></nav><div class="side-foot"><button id="sign-out" class="btn secondary">登出</button></div></aside><main class="main"><header class="top"><div><h1>網站內容</h1><p class="muted">在左側縮略圖選取區塊，再於右側編輯內容。</p></div><button id="save" class="btn">儲存變更</button></header><p id="message" class="muted"></p><div class="content-workspace"><div class="preview-panel"><div class="mini-page"><div class="mini-nav">FIELD NOTES <span>文章　主題　關於</span></div><button data-section="home.eyebrow" class="mini eyebrow">首頁小標</button><button data-section="home.headline" class="mini headline">首頁標題</button><button data-section="home.subjects" class="mini subjects">領域</button><button data-section="home.intro" class="mini intro">首頁簡介</button><div class="mini-placeholder"></div><button data-section="home.about" class="mini about">關於</button><button data-section="site.footer" class="mini footer">頁尾說明</button></div><p class="hint">點選縮略圖中的文字區塊進行編輯。</p></div><section class="editor-panel"><div id="empty"><h2>選擇要編輯的區塊</h2><p class="muted">從左側網頁縮略圖點選一個區塊。</p></div><div id="editor" hidden><p class="kicker">目前區塊</p><h2 id="field-title"></h2><label>繁體中文<textarea id="zh" rows="7"></textarea></label><label>英文翻譯 <small>（選填）</small><textarea id="en" rows="7"></textarea></label></div></section></div></main></div>
<script>
 import {supabaseConfigured,getSupabaseClient} from '../../lib/supabase-client.js';const defs={'home.eyebrow':'首頁小標','home.headline':'首頁標題','home.subjects':'領域','home.intro':'首頁簡介','home.about':'關於','site.footer':'頁尾說明'};const cms=document.querySelector('#cms'),message=document.querySelector('#message'),editor=document.querySelector('#editor'),empty=document.querySelector('#empty'),zh=document.querySelector('#zh'),en=document.querySelector('#en');let supabase,user,rows=new Map(),active=null;
 if(!supabaseConfigured)location.href='/admin/login';else{supabase=getSupabaseClient();const {data:{session}}=await supabase.auth.getSession();user=session?.user;if(!user)location.href='/admin/login';else{const {data:profile}=await supabase.from('profiles').select('role').eq('id',user.id).single();if(!['admin','editor'].includes(profile?.role)){await supabase.auth.signOut();location.href='/admin/login';}else{cms.hidden=false;await load();}}}
 async function load(){const {data,error}=await supabase.from('site_content').select('key,value_zh_hant,value_en');if(error){message.textContent=error.message;return;}rows=new Map((data||[]).map(x=>[x.key,{...x}]));setTimeout(()=>document.querySelector('[data-section="home.headline"]')?.click(),0);}
 function persistDraft(){if(!active)return;const row=rows.get(active)||{key:active};row.value_zh_hant=zh.value;row.value_en=en.value;rows.set(active,row);}
 document.querySelectorAll('[data-section]').forEach(b=>b.addEventListener('click',()=>{persistDraft();active=b.dataset.section;document.querySelectorAll('[data-section]').forEach(x=>x.classList.toggle('selected',x===b));const row=rows.get(active)||{};document.querySelector('#field-title').textContent=defs[active];zh.value=row.value_zh_hant||'';en.value=row.value_en||'';empty.hidden=true;editor.hidden=false;}));
 document.querySelector('#save')?.addEventListener('click',async()=>{persistDraft();message.textContent='儲存中…';const items=Object.keys(defs).map(key=>({key,value_zh_hant:(rows.get(key)?.value_zh_hant||'').trim(),value_en:(rows.get(key)?.value_en||'').trim()||null}));const {error}=await supabase.rpc('update_site_content',{items});message.textContent=error?error.message:'已儲存。網站正在重新建置。';});
 document.querySelector('#sign-out')?.addEventListener('click',async()=>{await supabase.auth.signOut();location.href='/admin/login';});
</script>
<style>.content-workspace{display:grid;grid-template-columns:minmax(320px,.9fr) minmax(360px,1.1fr);gap:28px;align-items:start}.preview-panel,.editor-panel{background:#fff;border:1px solid var(--line);padding:18px}.mini-page{aspect-ratio:4/5;border:1px solid #bbb;background:#fff;padding:5%;display:flex;flex-direction:column;gap:3%;font-size:9px;overflow:hidden}.mini-nav{border-bottom:1px solid #bbb;padding-bottom:3%;font-weight:700}.mini-nav span{float:right;font-weight:400}.mini{display:block;width:100%;border:1px dashed transparent;background:transparent;text-align:left;cursor:pointer;padding:2%;color:#222}.mini:hover,.mini.selected{border-color:#111;background:#f3f3f3}.mini.eyebrow{font:7px monospace;color:#777}.mini.headline{font:20px/1.05 Georgia,serif;min-height:18%}.mini.subjects,.mini.intro{font:8px monospace;text-align:right}.mini-placeholder{height:25%;border-top:1px solid #ddd;border-bottom:1px solid #ddd;background:linear-gradient(#fafafa,#fff)}.mini.about{font:13px/1.25 Georgia,serif;min-height:15%}.mini.footer{margin-top:auto;border-top:1px solid #bbb;font:7px monospace}.hint{font-size:11px;color:#777;margin:10px 0 0}.editor-panel{position:sticky;top:24px;min-height:430px}.editor-panel h2{margin:4px 0 24px}.editor-panel label{display:grid;gap:8px;font-size:12px;margin-bottom:20px}.editor-panel textarea{width:100%;border:1px solid var(--line);padding:12px;resize:vertical;font:14px/1.5 inherit}.kicker{font-size:10px;color:#777;text-transform:uppercase;letter-spacing:.08em}@media(max-width:980px){.content-workspace{grid-template-columns:1fr}.preview-panel{max-width:520px}.editor-panel{position:static}}</style></AdminLayout>