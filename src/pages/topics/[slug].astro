---
import Layout from '../../layouts/Layout.astro'; import {getTags,getPostsByTag} from '../../lib/posts.js';
export async function getStaticPaths(){const tags=await getTags();return Promise.all(tags.map(async tag=>({params:{slug:tag.slug},props:{tag,posts:await getPostsByTag(tag.slug)}})))}
const {tag,posts}=Astro.props; const fmt=d=>new Intl.DateTimeFormat('zh-TW',{year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(d));
---
<Layout title={`${tag.name} — Field Notes`}><main id="content" class="shell topic"><a class="back" href="/topics">← Topics</a><header><span>Topic / {String(posts.length).padStart(2,'0')}</span><h1>{tag.name}</h1>{tag.description&&<p>{tag.description}</p>}</header><div class="list">{posts.map((post,i)=><a href={`/post/${post.slug}`}><span>{String(i+1).padStart(2,'0')}</span><h2>{post.title}</h2><time>{fmt(post.published_at)}</time></a>)}</div></main><style>.topic{padding-top:18px}.back{font:10px monospace;text-transform:uppercase;text-decoration:none;color:var(--soft)}.topic header{padding:38px 0 30px}.topic header span,.list span,.list time{font:10px monospace;color:var(--soft);text-transform:uppercase}.topic h1{font:400 clamp(42px,6vw,88px)/1 Georgia,serif;letter-spacing:-.045em;margin:10px 0}.topic header p{max-width:620px;margin:12px 0 0;font:15px/1.5 Georgia,serif;color:#555}.list{border-top:1px solid}.list a{min-height:76px;display:grid;grid-template-columns:42px 1fr 92px;align-items:center;gap:14px;border-bottom:1px solid var(--line);text-decoration:none}.list h2{font:400 clamp(19px,2vw,29px)/1.2 Georgia,serif;margin:0}.list time{text-align:right}@media(max-width:700px){.topic header{padding:28px 0 22px}.list a{grid-template-columns:26px 1fr;min-height:68px}.list time{display:none}}</style></Layout>