---
import Layout from '../../layouts/Layout.astro'; import {getTags,getPostsByTag} from '../../lib/posts.js';
export async function getStaticPaths(){const tags=await getTags();return Promise.all(tags.map(async tag=>({params:{slug:tag.slug},props:{tag,posts:await getPostsByTag(tag.slug)}})))}
const {tag,posts}=Astro.props; const fmt=d=>new Intl.DateTimeFormat('zh-TW',{year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(d));
---
<Layout title={`${tag.name} — Field Notes`}><main id="content" class="shell topic"><a class="back" href="/topics">← Topics</a><header><span>Topic / {String(posts.length).padStart(2,'0')}</span><h1>{tag.name}</h1></header><div class="list">{posts.map((post,i)=><a href={`/post/${post.slug}`}><span>{String(i+1).padStart(2,'0')}</span><h2>{post.title}</h2><time>{fmt(post.published_at)}</time></a>)}</div></main><style>.topic{padding-top:32px}.back{font:10px monospace;text-transform:uppercase;text-decoration:none;color:var(--soft)}.topic header{min-height:55vh;padding-top:12vh}.topic header span,.list span,.list time{font:10px monospace;color:var(--soft);text-transform:uppercase}.topic h1{font:400 clamp(60px,10vw,150px)/1 Georgia,serif;letter-spacing:-.05em;margin:20px 0}.list{border-top:1px solid}.list a{min-height:120px;display:grid;grid-template-columns:60px 1fr 100px;align-items:center;gap:20px;border-bottom:1px solid var(--line);text-decoration:none}.list h2{font:400 clamp(23px,3vw,40px)/1.2 Georgia,serif;margin:0}.list time{text-align:right}</style></Layout>