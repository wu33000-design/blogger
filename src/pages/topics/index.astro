---
import Layout from '../../layouts/Layout.astro'; import {getTags} from '../../lib/posts.js'; const tags=await getTags();
---
<Layout title="Topics — Field Notes"><main id="content" class="shell topics"><header><span>主題</span><h1>主題不是分類，而是問題的入口。</h1></header><div class="list">{tags.map((tag,i)=><a href={`/topics/${tag.slug}`}><span>{String(i+1).padStart(2,'0')}</span><h2>{tag.name}</h2><small>{tag.count} 篇文章</small></a>)}</div></main><style>.topics{padding-top:28px}.topics header{padding:28px 0 32px}.topics header>span,.list span,.list small{font:10px monospace;text-transform:uppercase;color:var(--soft)}.topics h1{font:400 clamp(30px,4vw,56px)/1.1 Georgia,serif;letter-spacing:-.035em;max-width:760px;margin:10px 0 0}.list{border-top:1px solid}.list a{min-height:74px;display:grid;grid-template-columns:42px 1fr auto;align-items:center;gap:14px;border-bottom:1px solid var(--line);text-decoration:none}.list h2{font:400 clamp(20px,2.2vw,30px) Georgia,serif;margin:0}@media(max-width:700px){.topics{padding-top:18px}.topics header{padding:20px 0 24px}.list a{min-height:66px;grid-template-columns:26px 1fr auto}}</style></Layout>