---
import Layout from '../../layouts/Layout.astro'; import {getTags} from '../../lib/posts.js'; const tags=await getTags();
---
<Layout title="Topics — Field Notes"><main id="content" class="shell topics"><header><span>Topics</span><h1>主題不是分類，<br/>而是問題的入口。</h1></header><div class="list">{tags.map((tag,i)=><a href={`/topics/${tag.slug}`}><span>{String(i+1).padStart(2,'0')}</span><h2>{tag.name}</h2><small>{tag.count} notes</small></a>)}</div></main><style>.topics{padding-top:10vh}.topics header{min-height:55vh}.topics header>span,.list span,.list small{font:10px monospace;text-transform:uppercase;color:var(--soft)}.topics h1{font:400 clamp(40px,6vw,86px)/1.08 Georgia,serif;letter-spacing:-.04em}.list{border-top:1px solid}.list a{min-height:115px;display:grid;grid-template-columns:60px 1fr auto;align-items:center;gap:20px;border-bottom:1px solid var(--line);text-decoration:none}.list h2{font:400 clamp(25px,3vw,42px) Georgia,serif;margin:0}</style></Layout>