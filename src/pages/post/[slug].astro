---
import Layout from '../../layouts/Layout.astro'; import {getPosts} from '../../lib/posts.js';
export async function getStaticPaths(){const posts=await getPosts();return posts.map(post=>({params:{slug:post.slug},props:{post}}))}
const {post}=Astro.props; const fmt=d=>new Intl.DateTimeFormat('zh-TW',{year:'numeric',month:'long',day:'numeric'}).format(new Date(d));
---
<Layout title={`${post.title} — Field Notes`} description={post.excerpt||post.title}>
<main class="shell article"><a class="back" href="/">← Index</a>
<header><div class="topline"><span>Essay / Field note</span><span>{fmt(post.published_at)}</span></div><h1>{post.title}</h1><div class="intro"><p>{post.excerpt}</p><span>08 MIN<br/>READ</span></div></header>
<div class="art"><span>FIELD ※ NOTES</span><b>01</b></div>
<section class="prose body" set:html={post.html}/>
<nav class="next"><span>Continue exploring</span><a href="/">All notes ↗</a></nav>
</main>
<style>
.article{padding-top:24px}.back{font:11px monospace;text-transform:uppercase;text-decoration:none}.article header{padding:70px 0 45px}.topline{display:flex;justify-content:space-between;border-bottom:1px solid;padding-bottom:10px;font:11px monospace;text-transform:uppercase}.article h1{font:800 clamp(58px,10vw,150px)/.84 Arial,sans-serif;letter-spacing:-.065em;margin:35px 0;text-transform:uppercase;max-width:1400px}.intro{display:grid;grid-template-columns:1fr auto;gap:30px;align-items:end}.intro p{font:23px/1.35 Georgia,serif;max-width:720px;margin:0}.intro span{font:11px monospace}.art{height:52vw;max-height:680px;min-height:330px;background:var(--acid);border:1px solid;display:flex;align-items:flex-end;justify-content:space-between;padding:18px;font:11px monospace}.art b{font:800 clamp(80px,18vw,260px)/.7 Arial,sans-serif;letter-spacing:-.08em}.body{max-width:720px;margin:80px auto 120px}.next{border-top:1px solid;border-bottom:1px solid;padding:20px 0;display:flex;justify-content:space-between;font:11px monospace;text-transform:uppercase}.next a{text-decoration:none}@media(max-width:720px){.article header{padding-top:45px}.intro{grid-template-columns:1fr}.art{height:70vw}.body{margin:55px auto 80px}}
</style></Layout>