---
import Layout from '../../layouts/Layout.astro'; import {getPosts} from '../../lib/posts.js';
export async function getStaticPaths(){const posts=await getPosts();return posts.map((post,index)=>({params:{slug:post.slug},props:{post,previous:posts[index+1]||null,next:posts[index-1]||null}}))}
const {post,previous,next}=Astro.props; const fmt=d=>new Intl.DateTimeFormat('zh-TW',{year:'numeric',month:'long',day:'numeric'}).format(new Date(d));
const author=post.primary_author?.name || post.authors?.[0]?.name || 'Field Notes';
---
<Layout title={`${post.title} — Field Notes`} description={post.excerpt||post.title} image={post.feature_image} type="article">
<main id="content" class="shell article"><a class="back" href="/">← Index</a>
<header><div class="meta"><span>{post.primary_tag?.name || 'Field note'}</span><time datetime={post.published_at}>{fmt(post.published_at)}</time></div><h1>{post.title}</h1><p class="lead">{post.excerpt}</p><div class="details"><span>{author}</span><span>{post.reading_time} min read</span></div></header>
{post.feature_image ? <figure class="feature"><img src={post.feature_image} alt="" loading="eager"/></figure> : <div class="mark" aria-hidden="true"><span></span></div>}
<section class="prose body" set:html={post.html}/>
<div class="share"><span>Share</span><button id="copy-link" type="button">Copy link</button></div>
<nav class="related" aria-label="Adjacent articles">{previous?<a href={`/post/${previous.slug}`}><small>Previous</small><span>{previous.title}</span></a>:<span/>}{next?<a class="next" href={`/post/${next.slug}`}><small>Next</small><span>{next.title}</span></a>:<a class="next" href="/"><small>Index</small><span>All notes</span></a>}</nav>
</main>
<script is:inline>document.getElementById('copy-link')?.addEventListener('click',async e=>{await navigator.clipboard.writeText(location.href);e.currentTarget.textContent='Copied';});</script>
<style>
.article{padding-top:32px}.back{font:10px monospace;text-transform:uppercase;text-decoration:none;color:var(--soft)}.article header{min-height:70vh;padding:12vh 0 7vh}.meta{display:flex;justify-content:space-between;max-width:820px;font:10px monospace;text-transform:uppercase;color:var(--soft);border-bottom:1px solid var(--line);padding-bottom:9px}.article h1{font:400 clamp(45px,7vw,100px)/1.03 Georgia,"Noto Serif TC",serif;letter-spacing:-.045em;max-width:1050px;margin:38px 0}.lead{font:18px/1.65 Georgia,"Noto Serif TC",serif;color:#555;max-width:650px}.details{display:flex;gap:24px;margin-top:32px;font:10px monospace;text-transform:uppercase;color:var(--soft)}.mark{height:40vh;min-height:260px;display:flex;align-items:center;justify-content:center}.mark span{display:block;width:82px;height:82px;background:#111;position:relative}.mark span:after{content:"";position:absolute;width:1px;height:130px;background:#aaa;left:50%;top:100%;transform:rotate(22deg);transform-origin:top}.feature{margin:0}.feature img{display:block;width:100%;max-height:75vh;object-fit:cover}.body{max-width:680px;margin:100px auto 120px}.share{max-width:680px;margin:0 auto 110px;border-top:1px solid var(--line);padding-top:12px;display:flex;justify-content:space-between;font:10px monospace;text-transform:uppercase}.share button{border:0;background:none;padding:0;font:inherit;text-transform:uppercase;cursor:pointer}.related{border-top:1px solid var(--ink);display:grid;grid-template-columns:1fr 1fr;gap:40px;padding-top:18px}.related a{text-decoration:none;display:grid;gap:9px}.related small{font:10px monospace;text-transform:uppercase;color:var(--soft)}.related span{font:20px/1.3 Georgia,serif}.related .next{text-align:right}@media(max-width:700px){.article header{min-height:65vh}.body{margin:70px auto 90px}.related{grid-template-columns:1fr;}.related .next{text-align:left}}
</style></Layout>