---
import Layout from '../../layouts/Layout.astro'; import {getPosts} from '../../lib/posts.js';
export async function getStaticPaths(){const posts=await getPosts();return posts.map((post,index)=>({params:{slug:post.slug},props:{post,previous:posts[index+1]||null,next:posts[index-1]||null}}))}
const {post,previous,next}=Astro.props; const fmt=d=>new Intl.DateTimeFormat('zh-TW',{year:'numeric',month:'long',day:'numeric'}).format(new Date(d));
const author=post.primary_author?.name || post.authors?.[0]?.name || 'Field Notes';
const siteUrl=import.meta.env.SITE_URL || Astro.url.origin; const articleUrl=new URL(`/post/${post.slug}`,siteUrl).toString();
const jsonLd={"@context":"https://schema.org","@type":"Article",headline:post.title,description:post.excerpt,datePublished:post.published_at,author:{"@type":"Person",name:author},mainEntityOfPage:articleUrl,...(post.feature_image?{image:[post.feature_image]}:{})};
---
<Layout title={`${post.title} — Field Notes`} description={post.excerpt||post.title} image={post.feature_image} type="article">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<main id="content" class="shell article"><a class="back" href="/">← Index</a>
<header><div class="meta"><span>{post.primary_tag?.name || 'Field note'}</span><time datetime={post.published_at}>{fmt(post.published_at)}</time></div><h1>{post.title}</h1><p class="lead">{post.excerpt}</p><div class="details"><span>{author}</span><span>{post.reading_time} min read</span></div></header>
{post.feature_image ? <figure class="feature"><img src={post.feature_image} alt={post.feature_image_alt||""} loading="eager"/></figure> : null}
<section class="prose body" set:html={post.html}/>
{post.tags?.length>0&&<div class="tags">{post.tags.map(tag=><span>{tag.name}</span>)}</div>}
<div class="share"><span>Share</span><button id="copy-link" type="button">Copy link</button></div>
<nav class="related" aria-label="Adjacent articles">{previous?<a href={`/post/${previous.slug}`}><small>Previous</small><span>{previous.title}</span></a>:<span/>}{next?<a class="next" href={`/post/${next.slug}`}><small>Next</small><span>{next.title}</span></a>:<a class="next" href="/"><small>Index</small><span>All notes</span></a>}</nav>
</main>
<script is:inline>document.getElementById('copy-link')?.addEventListener('click',async e=>{try{await navigator.clipboard.writeText(location.href);e.currentTarget.textContent='Copied';}catch{e.currentTarget.textContent='Copy failed';}});</script>
<style>
.article{padding-top:18px}.back{font:10px monospace;text-transform:uppercase;text-decoration:none;color:var(--soft)}.article header{padding:38px 0 34px}.meta{display:flex;justify-content:space-between;max-width:820px;font:10px monospace;text-transform:uppercase;color:var(--soft);border-bottom:1px solid var(--line);padding-bottom:7px}.article h1{font:400 clamp(38px,5.4vw,76px)/1.04 Georgia,"Noto Serif TC",serif;letter-spacing:-.04em;max-width:1050px;margin:22px 0 16px}.lead{font:17px/1.55 Georgia,"Noto Serif TC",serif;color:#555;max-width:650px;margin:0}.details{display:flex;gap:20px;margin-top:18px;font:10px monospace;text-transform:uppercase;color:var(--soft)}.feature{margin:0 auto;max-width:1200px}.feature img{display:block;width:100%;max-height:68vh;object-fit:cover}.body{max-width:680px;margin:58px auto 48px}.tags{max-width:680px;margin:0 auto 38px;display:flex;gap:6px;flex-wrap:wrap}.tags span{font:10px monospace;text-transform:uppercase;border:1px solid var(--line);padding:5px 7px}.share{max-width:680px;margin:0 auto 58px;border-top:1px solid var(--line);padding-top:9px;display:flex;justify-content:space-between;font:10px monospace;text-transform:uppercase}.share button{border:0;background:none;padding:0;font:inherit;text-transform:uppercase;cursor:pointer}.related{border-top:1px solid var(--ink);display:grid;grid-template-columns:1fr 1fr;gap:30px;padding-top:14px}.related a{text-decoration:none;display:grid;gap:6px}.related small{font:10px monospace;text-transform:uppercase;color:var(--soft)}.related span{font:18px/1.3 Georgia,serif}.related .next{text-align:right}@media(max-width:700px){.article header{padding:28px 0 26px}.body{margin:42px auto 40px}.share{margin-bottom:42px}.related{grid-template-columns:1fr}.related .next{text-align:left}}
</style></Layout>