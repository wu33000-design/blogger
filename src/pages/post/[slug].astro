---
import Layout from '../../layouts/Layout.astro'; import {getPosts} from '../../lib/posts.js';
export async function getStaticPaths(){const posts=await getPosts();return posts.map(post=>({params:{slug:post.slug},props:{post}}))}
const {post}=Astro.props; const fmt=d=>new Intl.DateTimeFormat('zh-TW',{year:'numeric',month:'long',day:'numeric'}).format(new Date(d));
---
<Layout title={`${post.title} — Field Notes`} description={post.excerpt||post.title}>
<main class="shell article"><a class="back" href="/">← Index</a>
<header><div class="meta"><span>Field note</span><time datetime={post.published_at}>{fmt(post.published_at)}</time></div><h1>{post.title}</h1><p class="lead">{post.excerpt}</p></header>
<div class="mark" aria-hidden="true"><span></span></div>
<section class="prose body" set:html={post.html}/>
<nav class="end"><span>End of note</span><a href="/">Return to index →</a></nav>
</main>
<style>
.article{padding-top:32px}.back{font:10px monospace;text-transform:uppercase;text-decoration:none;color:var(--soft)}.article header{min-height:72vh;padding:13vh 0 8vh}.meta{display:flex;justify-content:space-between;max-width:820px;font:10px monospace;text-transform:uppercase;color:var(--soft);border-bottom:1px solid var(--line);padding-bottom:9px}.article h1{font:400 clamp(45px,7vw,100px)/1.03 Georgia,"Noto Serif TC",serif;letter-spacing:-.045em;max-width:1050px;margin:38px 0}.lead{font:18px/1.65 Georgia,"Noto Serif TC",serif;color:#555;max-width:650px}.mark{height:44vh;min-height:280px;display:flex;align-items:center;justify-content:center}.mark span{display:block;width:82px;height:82px;background:#111;position:relative}.mark span:after{content:"";position:absolute;width:1px;height:130px;background:#aaa;left:50%;top:100%;transform:rotate(22deg);transform-origin:top}.body{max-width:680px;margin:100px auto 150px}.end{border-top:1px solid var(--ink);padding:13px 0;display:flex;justify-content:space-between;font:10px monospace;text-transform:uppercase}.end a{text-decoration:none}@media(max-width:700px){.article header{min-height:65vh}.meta{max-width:none}.mark{height:35vh}.body{margin:70px auto 100px}}
</style></Layout>