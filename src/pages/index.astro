---
import Layout from '../layouts/Layout.astro'; import {getPosts} from '../lib/posts.js'; import {getSiteContent} from '../lib/site-content.js';
const posts=await getPosts(); const site=await getSiteContent('zh');
const featuredPosts=posts.filter(p=>p.featured); const featured=featuredPosts.length?featuredPosts:(posts[0]?[posts[0]]:[]); const initialFeatured=featured.slice(0,3); const extraFeatured=featured.slice(3);
const tagMap=new Map(); for(const post of posts) for(const tag of post.tags||[]) if(tag?.slug&&!tagMap.has(tag.slug)) tagMap.set(tag.slug,tag); const filterTags=[...tagMap.values()].sort((a,b)=>a.name.localeCompare(b.name,'zh-Hant'));
const fmt=d=>new Intl.DateTimeFormat('zh-TW',{year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(d));
---
<Layout title="Field Notes" footerText={site['site.footer']}>
<main id="content" class="shell">
<section class="intro"><div><p>{site['home.eyebrow']}</p><h1>{site['home.headline']}</h1></div><p class="dek">{site['home.subjects']}<br/>{site['home.intro']}</p></section>
{featured.length>0&&<section class="featured">
  <div class="feature-meta"><span>精選文章</span><span>{String(featured.length).padStart(2,'0')} 篇</span></div>
  <div class="featured-grid">
    {initialFeatured.map(post=><a class="feature-card" href={`/post/${post.slug}`}>
      {post.feature_image&&<img src={post.feature_image} alt={post.feature_image_alt||""}/>}
      <div class="feature-copy"><small>{post.primary_tag?.name||'Field note'} · {post.reading_time} 分鐘</small><h2>{post.title}</h2><p>{post.excerpt}</p><span class="read">閱讀全文 →</span></div>
    </a>)}
  </div>
  {extraFeatured.length>0&&<div class="featured-more">
    <button id="featured-toggle" class="featured-toggle" type="button" aria-expanded="false" aria-controls="featured-extra"><span class="featured-toggle-label">顯示更多精選文章</span><span>＋{extraFeatured.length}</span></button>
    <div id="featured-extra" class="featured-grid extra" style="display:none">
      {extraFeatured.map(post=><a class="feature-card" href={`/post/${post.slug}`}>
        {post.feature_image&&<img src={post.feature_image} alt={post.feature_image_alt||""}/>}
        <div class="feature-copy"><small>{post.primary_tag?.name||'Field note'} · {post.reading_time} 分鐘</small><h2>{post.title}</h2><p>{post.excerpt}</p><span class="read">閱讀全文 →</span></div>
      </a>)}
    </div>
  </div>}
</section>}
<section id="index" class="index">
  <header><span>文章</span><span id="post-count">{String(posts.length).padStart(2,'0')} 篇</span></header>
  {filterTags.length>0&&<div class="tag-filters" role="group" aria-label="依標籤篩選文章"><button type="button" class="tag-filter on" data-tag="" aria-pressed="true">全部</button>{filterTags.map(tag=><button type="button" class="tag-filter" data-tag={tag.slug} aria-pressed="false">{tag.name}</button>)}</div>}
  <div id="post-list">{posts.map((post,i)=><a class="row" data-post-row data-tags={(post.tags||[]).map(t=>t.slug).join(' ')} href={`/post/${post.slug}`}><span>{String(i+1).padStart(2,'0')}</span><div><small>{post.primary_tag?.name||'Field note'} · {post.reading_time} 分鐘</small><h2>{post.title}</h2></div><time datetime={post.published_at}>{fmt(post.published_at)}</time></a>)}</div>
  <p id="no-posts" class="no-posts" hidden>這個標籤目前沒有文章。</p>
</section>
<section id="about" class="about"><span>關於</span><p>{site['home.about']}</p></section>
</main>
<script is:inline>
(()=>{const toggle=document.getElementById('featured-toggle'),extra=document.getElementById('featured-extra'),label=toggle?.querySelector('.featured-toggle-label');toggle?.addEventListener('click',()=>{const next=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(next));if(extra)extra.style.display=next?'grid':'none';if(label)label.textContent=next?'收合精選文章':'顯示更多精選文章';});const buttons=[...document.querySelectorAll('.tag-filter')],rows=[...document.querySelectorAll('[data-post-row]')],count=document.getElementById('post-count'),empty=document.getElementById('no-posts');if(!buttons.length)return;const apply=tag=>{let visible=0;rows.forEach(row=>{const tags=(row.dataset.tags||'').split(/\s+/).filter(Boolean),show=!tag||tags.includes(tag);row.hidden=!show;if(show)visible++;});buttons.forEach(button=>{const active=button.dataset.tag===tag;button.classList.toggle('on',active);button.setAttribute('aria-pressed',String(active));});if(count)count.textContent=String(visible).padStart(2,'0')+' 篇';if(empty)empty.hidden=visible!==0;};buttons.forEach(button=>button.addEventListener('click',()=>apply(button.dataset.tag||'')));})();
</script>
<style>
.intro{padding:46px 0 38px;display:grid;grid-template-columns:minmax(0,2fr) minmax(240px,1fr);gap:40px;align-items:end;border-bottom:1px solid var(--ink)}.intro>div>p,.dek,.index header,.about>span,.feature-meta{font:10px monospace;letter-spacing:.07em;text-transform:uppercase;color:var(--soft)}.intro h1{font:400 clamp(30px,3.8vw,58px)/1.12 Georgia,"Noto Serif TC",serif;letter-spacing:-.035em;max-width:760px;margin:10px 0 0}.dek{margin:0;line-height:1.55;text-align:right}.featured{padding:28px 0 38px}.feature-meta{display:flex;justify-content:space-between;margin-bottom:12px}.featured-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line);border-left:1px solid var(--line)}.feature-card{min-width:0;text-decoration:none;border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:16px;display:flex;flex-direction:column;gap:14px}.feature-card img{width:100%;height:180px;object-fit:cover}.feature-copy small{font:10px monospace;color:var(--soft);text-transform:uppercase}.feature-card h2{font:400 clamp(23px,2.7vw,39px)/1.08 Georgia,"Noto Serif TC",serif;letter-spacing:-.03em;margin:8px 0 10px}.feature-card p{font:15px/1.5 Georgia,"Noto Serif TC",serif;color:#555;margin:0}.read{display:inline-block;margin-top:14px;font:10px monospace;text-transform:uppercase;border-bottom:1px solid}.featured-more{margin-top:12px}.featured-toggle{appearance:none;width:max-content;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--soft);padding:4px 0;cursor:pointer;font:10px monospace;text-transform:uppercase}.featured-toggle:hover,.featured-toggle[aria-expanded="true"]{color:var(--ink)}.featured-toggle span{margin-left:6px}.featured-extra{margin-top:12px}.index{padding-top:22px}.index header{display:flex;justify-content:space-between;border-bottom:1px solid var(--ink);padding-bottom:7px}.tag-filters{display:flex;flex-wrap:wrap;gap:6px;padding:12px 0;border-bottom:1px solid var(--line)}.tag-filter{appearance:none;border:1px solid transparent;background:transparent;color:var(--soft);padding:5px 8px;font:10px monospace;cursor:pointer}.tag-filter:hover,.tag-filter.on{border-color:var(--line);color:var(--ink);background:#fafafa}.row{min-height:78px;display:grid;grid-template-columns:42px 1fr 92px;align-items:center;gap:14px;border-bottom:1px solid var(--line);text-decoration:none}.row[hidden]{display:none}.row>span,.row time,.row small{font:10px monospace;color:var(--soft);text-transform:uppercase}.row time{text-align:right}.row h2{font:400 clamp(19px,2vw,29px)/1.18 Georgia,"Noto Serif TC",serif;letter-spacing:-.02em;margin:4px 0 0}.row:hover h2{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px}.no-posts{margin:0;padding:28px 0;border-bottom:1px solid var(--line);font:12px/1.5 Georgia,"Noto Serif TC",serif;color:var(--soft)}.about{padding:48px 0 28px;display:grid;grid-template-columns:1fr 3fr}.about p{font:400 clamp(22px,2.6vw,38px)/1.3 Georgia,"Noto Serif TC",serif;letter-spacing:-.025em;max-width:900px;margin:0}@media(max-width:900px){.featured-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.intro{padding:28px 0 24px;grid-template-columns:1fr;gap:18px}.dek{text-align:left}.featured{padding:22px 0 30px}.featured-grid{grid-template-columns:1fr}.feature-card img{height:190px}.row{min-height:70px;grid-template-columns:26px 1fr}.row time{display:none}.about{grid-template-columns:1fr;gap:18px;padding:34px 0}}
</style></Layout>