---
import Layout from '../layouts/Layout.astro'; import {getPosts} from '../lib/posts.js';
const posts=await getPosts(); const fmt=d=>new Intl.DateTimeFormat('en',{month:'2-digit',day:'2-digit',year:'2-digit'}).format(new Date(d));
---
<Layout title="Field ※ Notes">
<main class="shell">
<section class="hero">
<div class="hero-top"><span>Research-led</span><span>Digital publication</span></div>
<h1><span>Ideas</span><span class="indent">that</span><span>reshape</span><span class="indent2">practice<span class="spark">※</span></span></h1>
<div class="hero-bottom"><p>Writing about the systems we build,<br/>the tools we use, and what they<br/>quietly make possible.</p><a href="#notes">Explore notes ↓</a></div>
</section>
<section class="marquee" aria-label="Topics"><div>AI & HUMAN AGENCY ※ DESIGN SYSTEMS ※ RESEARCH PRACTICE ※ DIGITAL INFRASTRUCTURE ※ AI & HUMAN AGENCY ※ DESIGN SYSTEMS ※ RESEARCH PRACTICE ※ DIGITAL INFRASTRUCTURE ※ </div></section>
<section id="notes" class="works"><div class="works-head"><span>Selected</span><h2>Notes</h2><span>2026 / {String(posts.length).padStart(2,'0')}</span></div>
<div class="note-list">{posts.map((post,i)=><a class="note" href={`/post/${post.slug}`}><span class="num">{String(i+1).padStart(2,'0')}</span><h3>{post.title}</h3><span class="kind">{i%2===0?'Essay':'Research note'}</span><span class="date">{fmt(post.published_at)}</span><span class="arrow">↗</span></a>)}</div>
</section>
<section id="about" class="about"><p class="eyebrow">About / Intent</p><div class="about-grid"><h2>Creative at heart.<br/>Critical by design.</h2><p>這是一個研究與實作並置的出版空間。文章關注 AI、人類能動性、設計方法與數位基礎設施，並把正在形成中的想法保留為可追蹤的公開筆記。</p></div><div class="giant">THINK<span>※</span><br/>MAKE</div></section>
</main>
<style>
.hero{min-height:calc(100vh - 70px);padding:24px 0 30px;display:flex;flex-direction:column}.hero-top{display:flex;justify-content:space-between;font:11px monospace;text-transform:uppercase}.hero h1{font:800 clamp(72px,14vw,205px)/.72 Arial,sans-serif;letter-spacing:-.075em;text-transform:uppercase;margin:auto 0;width:100%}.hero h1 span{display:block}.hero h1 .indent{padding-left:18vw}.hero h1 .indent2{padding-left:39vw;position:relative}.spark{font-size:.36em;position:absolute;margin-left:.1em}.hero-bottom{display:flex;align-items:end;justify-content:space-between;font-size:13px}.hero-bottom p{margin:0;line-height:1.35}.hero-bottom a{text-decoration:none;border-bottom:1px solid;padding-bottom:3px}.marquee{margin:0 -18px;background:var(--acid);border-top:1px solid;border-bottom:1px solid;overflow:hidden;white-space:nowrap}.marquee div{font:800 21px/1 Arial,sans-serif;padding:15px 0;animation:move 24s linear infinite;width:max-content}@keyframes move{to{transform:translateX(-50%)}}.works{padding-top:80px}.works-head{display:grid;grid-template-columns:1fr 3fr 1fr;align-items:end;border-bottom:1px solid;padding-bottom:10px;text-transform:uppercase;font:11px monospace}.works-head h2{font:800 clamp(70px,12vw,160px)/.72 Arial,sans-serif;letter-spacing:-.07em;margin:0}.works-head span:last-child{text-align:right}.note{display:grid;grid-template-columns:60px minmax(0,1fr) 130px 90px 35px;align-items:center;gap:18px;min-height:150px;border-bottom:1px solid;text-decoration:none;transition:padding .25s ease,background .25s ease}.note:hover{padding-left:14px;background:var(--acid)}.note .num,.kind,.date{font:11px monospace;text-transform:uppercase}.note h3{font:600 clamp(25px,3.2vw,52px)/1.02 Arial,sans-serif;letter-spacing:-.04em;margin:0;max-width:900px}.arrow{font-size:25px;transition:transform .25s}.note:hover .arrow{transform:translate(5px,-5px)}.about{padding:120px 0 30px}.eyebrow{font:11px monospace;text-transform:uppercase;border-bottom:1px solid;padding-bottom:12px}.about-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:8vw;padding:38px 0 100px}.about-grid h2{font:700 clamp(42px,6vw,90px)/.92 Arial,sans-serif;letter-spacing:-.05em;margin:0}.about-grid p{font:20px/1.5 Georgia,serif;margin:0;max-width:540px}.giant{font:800 22vw/.67 Arial,sans-serif;letter-spacing:-.09em;text-align:center}.giant span{font-size:.25em;vertical-align:top}@media(max-width:760px){.hero{min-height:78vh}.hero h1{font-size:22vw}.hero h1 .indent{padding-left:10vw}.hero h1 .indent2{padding-left:20vw}.works-head{grid-template-columns:1fr 2fr}.works-head span:last-child{display:none}.note{grid-template-columns:35px 1fr 28px;min-height:125px}.kind,.date{display:none}.about-grid{grid-template-columns:1fr;gap:40px}.giant{font-size:25vw}}
</style></Layout>