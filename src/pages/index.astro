---
import Layout from '../layouts/Layout.astro'; import {getPosts,getTags} from '../lib/posts.js';
const posts=await getPosts(); const tags=await getTags(); const featured=posts.find(p=>p.featured) || posts[0];
const fmt=d=>new Intl.DateTimeFormat('zh-TW',{year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(d));
---
<Layout title="Field Notes">
<main id="content" class="shell">
<section class="hero">
<div class="statement"><p>FIELD NOTES / 001</p><h1>留下足夠的空白，<br/>讓問題自己出現。</h1></div>
<div class="object" aria-hidden="true"><div class="void"></div><div class="beam"></div></div>
<div class="caption"><span>Technology · Design · Research</span><span>Independent notes on systems,<br/>practice and human agency.</span></div>
</section>
{featured&&<section class="featured"><div><span>Featured note</span><span>{featured.reading_time} min read</span></div><a href={`/post/${featured.slug}`}><h2>{featured.title}</h2><p>{featured.excerpt}</p><span>Read note →</span></a></section>}
<section id="index" class="index"><header><span>Index</span><span>{String(posts.length).padStart(2,'0')} notes</span></header>
{posts.map((post,i)=><a class="row" href={`/post/${post.slug}`}><span>{String(i+1).padStart(2,'0')}</span><div><small>{post.primary_tag?.name||'Field note'} · {post.reading_time} min</small><h2>{post.title}</h2></div><time datetime={post.published_at}>{fmt(post.published_at)}</time></a>)}</section>
<section class="topic-strip"><span>Topics</span><div>{tags.map(tag=><a href={`/topics/${tag.slug}`}>{tag.name} <sup>{tag.count}</sup></a>)}</div></section>
<section id="about" class="about"><span>About</span><p>關於技術、設計與研究的獨立筆記。不是追逐更多資訊，而是保留足夠空間，辨認什麼值得被看見。</p></section>
</main>
<style>
.hero{min-height:calc(100vh - 76px);position:relative;padding:8vh 0 5vh}.statement{max-width:650px}.statement p,.caption,.index header,.about>span,.featured>div,.topic-strip>span{font:10px monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--soft)}.statement h1{font:400 clamp(34px,4.5vw,68px)/1.22 Georgia,"Noto Serif TC",serif;letter-spacing:-.035em;margin:18px 0}.object{position:absolute;width:170px;height:220px;left:58%;top:38%;transform:translate(-50%,-50%)}.void{position:absolute;width:76px;height:76px;left:47px;top:34px;background:#111}.beam{position:absolute;width:1px;height:108px;background:#111;left:85px;top:110px;transform:rotate(24deg);transform-origin:top;opacity:.35}.caption{position:absolute;bottom:5vh;left:0;right:0;display:flex;justify-content:space-between;align-items:end;line-height:1.5}.caption span:last-child{text-align:right}.featured{padding:100px 0 140px;border-top:1px solid}.featured>div{display:flex;justify-content:space-between}.featured>a{display:block;text-decoration:none;max-width:1000px;margin:60px auto 0}.featured h2{font:400 clamp(38px,5.5vw,78px)/1.08 Georgia,serif;letter-spacing:-.04em;margin:0 0 25px}.featured p{font:18px/1.65 Georgia,serif;max-width:650px;color:#555}.featured a>span{display:inline-block;margin-top:25px;font:10px monospace;text-transform:uppercase;border-bottom:1px solid}.index{padding-top:80px}.index header{display:flex;justify-content:space-between;border-bottom:1px solid var(--ink);padding-bottom:9px}.row{min-height:126px;display:grid;grid-template-columns:60px 1fr 110px;align-items:center;gap:20px;border-bottom:1px solid var(--line);text-decoration:none}.row>span,.row time,.row small{font:10px monospace;color:var(--soft);text-transform:uppercase}.row time{text-align:right}.row h2{font:400 clamp(23px,3vw,42px)/1.15 Georgia,"Noto Serif TC",serif;letter-spacing:-.025em;margin:7px 0 0;transition:transform .25s}.row:hover h2{transform:translateX(10px)}.topic-strip{padding:140px 0;display:grid;grid-template-columns:1fr 2fr}.topic-strip div{display:flex;flex-wrap:wrap;gap:12px 30px}.topic-strip a{font:400 clamp(24px,3vw,42px) Georgia,serif;text-decoration:none}.topic-strip sup{font:9px monospace;color:var(--soft)}.about{min-height:65vh;padding:100px 0 80px;display:grid;grid-template-columns:1fr 2fr}.about p{font:400 clamp(28px,4vw,56px)/1.3 Georgia,"Noto Serif TC",serif;letter-spacing:-.03em;max-width:900px;margin:0}@media(max-width:700px){.hero{min-height:82vh}.object{width:120px;height:160px;left:67%;top:48%}.void{width:54px;height:54px;left:33px}.beam{left:60px;top:88px;height:72px}.caption{display:block}.caption span{display:block;margin-top:8px}.caption span:last-child{text-align:left}.row{grid-template-columns:30px 1fr}.row time{display:none}.topic-strip,.about{grid-template-columns:1fr;gap:35px}.featured{padding:70px 0 100px}}
</style></Layout>