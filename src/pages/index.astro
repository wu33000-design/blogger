---
import Layout from '../layouts/Layout.astro'; import {getPosts,getTags} from '../lib/posts.js';
const posts=await getPosts(); const tags=await getTags(); const featured=posts.find(p=>p.featured) || posts[0];
const fmt=d=>new Intl.DateTimeFormat('zh-TW',{year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(d));
---
<Layout title="Field Notes">
<main id="content" class="shell">
<section class="intro"><div><p>FIELD NOTES / 001</p><h1>留下足夠的空白，讓問題自己出現。</h1></div><p class="dek">Technology · Design · Research<br/>Independent notes on systems, practice and human agency.</p></section>
{featured&&<section class="featured"><div class="feature-meta"><span>Featured note</span><span>{featured.reading_time} min</span></div><a href={`/post/${featured.slug}`} class:list={{"with-image":!!featured.feature_image}}>{featured.feature_image&&<img src={featured.feature_image} alt={featured.feature_image_alt||""}/>}<div><h2>{featured.title}</h2><p>{featured.excerpt}</p><span class="read">Read note →</span></div></a></section>}
<section id="index" class="index"><header><span>Index</span><span>{String(posts.length).padStart(2,'0')} notes</span></header>
{posts.map((post,i)=><a class="row" href={`/post/${post.slug}`}><span>{String(i+1).padStart(2,'0')}</span><div><small>{post.primary_tag?.name||'Field note'} · {post.reading_time} min</small><h2>{post.title}</h2></div><time datetime={post.published_at}>{fmt(post.published_at)}</time></a>)}</section>
<section class="topic-strip"><span>Topics</span><div>{tags.map(tag=><a href={`/topics/${tag.slug}`}>{tag.name} <sup>{tag.count}</sup></a>)}</div></section>
<section id="about" class="about"><span>About</span><p>關於技術、設計與研究的獨立筆記。不是追逐更多資訊，而是保留足夠空間，辨認什麼值得被看見。</p></section>
</main>
<style>
.intro{padding:46px 0 38px;display:grid;grid-template-columns:minmax(0,2fr) minmax(240px,1fr);gap:40px;align-items:end;border-bottom:1px solid var(--ink)}.intro>div>p,.dek,.index header,.about>span,.feature-meta,.topic-strip>span{font:10px monospace;letter-spacing:.07em;text-transform:uppercase;color:var(--soft)}.intro h1{font:400 clamp(30px,3.8vw,58px)/1.12 Georgia,"Noto Serif TC",serif;letter-spacing:-.035em;max-width:760px;margin:10px 0 0}.dek{margin:0;line-height:1.55;text-align:right}.featured{padding:28px 0 38px}.feature-meta{display:flex;justify-content:space-between;margin-bottom:12px}.featured>a{display:grid;grid-template-columns:1fr;text-decoration:none;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:18px 0;gap:24px}.featured>a.with-image{grid-template-columns:minmax(260px,.8fr) minmax(0,1.2fr);align-items:center}.featured img{width:100%;height:240px;object-fit:cover}.featured h2{font:400 clamp(30px,4vw,58px)/1.08 Georgia,serif;letter-spacing:-.035em;margin:0 0 12px}.featured p{font:16px/1.55 Georgia,serif;max-width:650px;color:#555;margin:0}.read{display:inline-block;margin-top:16px;font:10px monospace;text-transform:uppercase;border-bottom:1px solid}.index{padding-top:22px}.index header{display:flex;justify-content:space-between;border-bottom:1px solid var(--ink);padding-bottom:7px}.row{min-height:78px;display:grid;grid-template-columns:42px 1fr 92px;align-items:center;gap:14px;border-bottom:1px solid var(--line);text-decoration:none}.row>span,.row time,.row small{font:10px monospace;color:var(--soft);text-transform:uppercase}.row time{text-align:right}.row h2{font:400 clamp(19px,2vw,29px)/1.18 Georgia,"Noto Serif TC",serif;letter-spacing:-.02em;margin:4px 0 0}.row:hover h2{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px}.topic-strip{padding:48px 0;display:grid;grid-template-columns:1fr 3fr;border-bottom:1px solid var(--line)}.topic-strip div{display:flex;flex-wrap:wrap;gap:8px 22px}.topic-strip a{font:400 clamp(18px,2vw,27px) Georgia,serif;text-decoration:none}.topic-strip sup{font:9px monospace;color:var(--soft)}.about{padding:48px 0 28px;display:grid;grid-template-columns:1fr 3fr}.about p{font:400 clamp(22px,2.6vw,38px)/1.3 Georgia,"Noto Serif TC",serif;letter-spacing:-.025em;max-width:900px;margin:0}@media(max-width:700px){.intro{padding:28px 0 24px;grid-template-columns:1fr;gap:18px}.dek{text-align:left}.featured{padding:22px 0 30px}.featured>a.with-image{grid-template-columns:1fr}.featured img{height:190px}.row{min-height:70px;grid-template-columns:26px 1fr}.row time{display:none}.topic-strip,.about{grid-template-columns:1fr;gap:18px;padding:34px 0}}
</style></Layout>